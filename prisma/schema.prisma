  priority     String @default("Normal") @db.VarChar(12)
  status       String @default("Draft") @db.VarChar(24) // Draft | Dispatched | Partially Dispatched | Cancelled
  approvalStatus String @default("NotRequired") @db.VarChar(16)
  remarks      String? @db.Text
  totalItems   Int    @default(0)
  totalDispatchQty Decimal @default(0) @db.Decimal(18, 3)
