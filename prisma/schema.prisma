/* =========================================================================
   DISCOUNT MANAGEMENT — centralized discount rule engine (System › Masters).
   Single source of truth for every discount applied across Retail / Wholesale /
   Distribution / Multi-Store billing. Sales/POS must resolve discounts from here.
   ========================================================================= */
model DiscountConfiguration {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  businessId      Int?
  branchId        Int?
  enableModule    Boolean  @default(true)
  codePrefix      String   @default("DISC") @db.VarChar(20)
  codeLength      Int      @default(5)
  runningNumber   Int      @default(1000)
  priorityOrder   String?  @db.Text // JSON string[] — Membership→Loyalty→Coupon→Promo→Voucher→Manual→Manager
  combinationJson String?  @db.Text // default combination rules
  gstDefault      String   @default("after") @db.VarChar(12) // before | after discount
  roundOff        Boolean  @default(true)
  discountAccount String   @default("3060") @db.VarChar(20)
  promoAccount    String   @default("4210") @db.VarChar(20)
  autoApply       Boolean  @default(true) // engine auto-applies the best discount at billing
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([tenantId, businessId, branchId])
  @@map("discount_configuration")
}

model DiscountMaster {
  id                Int       @id @default(autoincrement())
  tenantId          Int
  businessId        Int?
  branchId          Int?
  code              String    @db.VarChar(40)
  name              String    @db.VarChar(150)
  description       String?   @db.VarChar(500)
  category          String    @default("Standard") @db.VarChar(40)
  discountType      String    @db.VarChar(48) // Percentage | Flat Amount | Buy X Get Y | Category | Brand | …
  method            String    @default("percentage") @db.VarChar(20) // percentage | flat | fixed_price
  applyLevel        String    @default("bill") @db.VarChar(12) // bill | line
  value             Decimal   @default(0) @db.Decimal(14, 2)
  maxDiscount       Decimal   @default(0) @db.Decimal(14, 2)
  minDiscount       Decimal   @default(0) @db.Decimal(14, 2)
  priority          Int       @default(100)
  status            String    @default("Draft") @db.VarChar(12) // Draft | Active | Inactive | Expired
  startDate         DateTime?
  endDate           DateTime?
  startTime         String?   @db.VarChar(8)
  endTime           String?   @db.VarChar(8)
  minBill           Decimal   @default(0) @db.Decimal(14, 2)
  maxBill           Decimal   @default(0) @db.Decimal(14, 2)
  minQty            Int       @default(0)
  buyProductId      Int?
  buyQty            Int       @default(0)
  getProductId      Int?
  getQty            Int       @default(0)
  applicabilityJson String?   @db.Text
  eligibilityJson   String?   @db.Text
  validityJson      String?   @db.Text
  combinationJson   String?   @db.Text
  approvalJson      String?   @db.Text
  discountAccount   String?   @db.VarChar(20)
  gstTiming         String    @default("after") @db.VarChar(12) // before | after
  discountBase      String    @default("inclusive") @db.VarChar(12) // inclusive (on MRP incl. tax) | exclusive (on material value, pre-tax)
  reduceTaxable     Boolean   @default(true)
  combinable        Boolean   @default(false)
  requiresApproval  Boolean   @default(false)
  campaignId        Int?
  usageCount        Int       @default(0)
  totalGiven        Decimal   @default(0) @db.Decimal(16, 2)
  createdBy         Int?
  createdByName     String?   @db.VarChar(120)
  updatedBy         Int?
  approvedBy        Int?
  approvedByName    String?   @db.VarChar(120)
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, discountType])
  @@map("discount_master")
}

model DiscountUsage {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  businessId     Int?
  branchId       Int?
  discountId     Int
  discountCode   String   @db.VarChar(40)
  discountName   String   @db.VarChar(150)
  saleId         Int?
  invoiceNo      String?  @db.VarChar(40)
  customerId     Int?
  customerName   String?  @db.VarChar(200)
  billAmount     Decimal  @default(0) @db.Decimal(14, 2)
  discountAmount Decimal  @default(0) @db.Decimal(14, 2)
  channel        String?  @db.VarChar(20)
  usedAt         DateTime @default(now())
