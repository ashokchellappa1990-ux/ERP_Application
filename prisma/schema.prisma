  @@map("tenant_subscription")
}

model TenantSubscriptionHistory {
  id             Int    @id @default(autoincrement())
  subscriptionId Int
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  action     String @db.VarChar(20) // Activated | Renewed | Upgraded | Downgraded | Cancelled | Reactivated | Suspended
