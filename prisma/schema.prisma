// Bank movement ledger — one row per non-cash payment/receipt against a setup_banks account.
// Powers per-bank balance & reconciliation and lets you trace which bank a GL posting hit
// (the GL itself stays on the single Cash-at-Bank account — no per-bank GL codes).
model BankTransaction {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  bankId      Int
  bankName    String? @db.VarChar(150)
  bankAccount String? @db.VarChar(60)
  date       String @db.VarChar(20)
  direction  String @db.VarChar(4)  // in | out
  amount     Decimal @default(0) @db.Decimal(18, 2)
  mode       String? @db.VarChar(30)
  reference  String? @db.VarChar(120)
  sourceType String @db.VarChar(40) // SupplierPayment | PettyCash | Advance | Recurring | Sale | CustomerCollection | ReceiptTransaction
  sourceId   Int?
  sourceNo   String? @db.VarChar(60)
  partyName  String? @db.VarChar(200)
  journalId  Int?
  narration  String? @db.VarChar(300)
