  dispatchPlanningId Int?
  dispatchExecutionId Int?
  dispatchType String? @db.VarChar(24)
  referenceNo  String? @db.VarChar(60)
  arrivalTime  DateTime?
  securityOfficer String? @db.VarChar(160)
  remarks String? @db.Text
  status  String  @default("Waiting") @db.VarChar(16) // Waiting | Inside Factory | Loading | Completed | Exited

  // Section 1 – Gate Information
  gate     String? @db.VarChar(60)
  location String? @db.VarChar(150) // auto-populated from the logged-in user's active branch

  // Section 2/3 – Reference Document (auto-loaded server-side, not client-trusted)
  referenceType    String? @db.VarChar(30) // Sales Order | Direct Customer Dispatch
  salesOrderId     Int?
  customerName     String? @db.VarChar(200)
  deliveryAddress  String? @db.VarChar(400)
  transferRequestId Int?
  sourceWarehouse      String? @db.VarChar(120)
  destinationWarehouse String? @db.VarChar(120)

  // Section 4 – Transport Details
  transportMode   String? @db.VarChar(30)
  vehicleType     String? @db.VarChar(60)
  trailerNumber   String? @db.VarChar(40)
  containerNumber String? @db.VarChar(40)

  // Section 5 – Driver Details — captured fresh at the gate (the actual driver
  // entering may differ from anyone planned earlier), independent of driverId.
  driverName      String? @db.VarChar(150)
  driverMobile    String? @db.VarChar(20)
  driverLicenseNo String? @db.VarChar(60)
  helperName      String? @db.VarChar(150)
  helperMobile    String? @db.VarChar(20)

  // Section 6 – Vehicle Details (optional)
  vehicleCapacity    Decimal? @db.Decimal(18, 3)
  expectedLoadWeight Decimal? @db.Decimal(18, 3)
  gpsAvailable       Boolean  @default(false)
  sealNumber         String?  @db.VarChar(60)

  // Section 7 – Entry Details (optional)
  purpose          String?   @db.VarChar(200)
  expectedExitTime DateTime?
  loadingBayId     Int?

  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  items VehicleGateEntryItem[]

  @@unique([tenantId, gateEntryNo])
  @@index([tenantId, status])
  @@index([dispatchExecutionId])
  // Vehicle Weighment Management's fallback lookup filters by vehicleId alone
  // (when a vehicle is picked manually instead of via customer/reference).
  @@index([tenantId, vehicleId])
  // The list's default (unfiltered) view sorts by createdAt desc — without
  // this, that sort falls back to an in-memory filesort past the tenantId
  // scope once the table grows past a small row count.
  @@index([tenantId, createdAt])
  @@map("vehicle_gate_entry")
}

