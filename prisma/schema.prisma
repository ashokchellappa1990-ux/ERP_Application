// ============================================================================
// Platform Administration Portal (super-admin control plane).
// SEPARATE from the customer ERP: own auth (platform_session), own RBAC
// (platform_role/platform_user), cross-tenant scope. Reuses tenant_master.
// ============================================================================

/// Platform-level role (separate RBAC from the customer ERP).
model PlatformRole {
  id          Int    @id @default(autoincrement())
  slug        String @unique @db.VarChar(40)
  name        String @db.VarChar(80)
  description String? @db.VarChar(300)
  permissions String @db.Text // JSON array of permission keys, or "*"
  isSystem    Boolean @default(false)
  createdAt   DateTime @default(now())
  users       PlatformUser[]
  @@map("platform_role")
}

/// Platform staff user. Not a tenant user.
model PlatformUser {
  id           Int    @id @default(autoincrement())
  name         String @db.VarChar(150)
  email        String @unique @db.VarChar(150)
  passwordHash String @db.VarChar(255)
  platformRoleId Int
  role         PlatformRole @relation(fields: [platformRoleId], references: [id])
  active       Boolean @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     PlatformSession[]
  @@map("platform_user")
}

/// Platform login session (separate cookie from the ERP pos_session).
model PlatformSession {
  id         String   @id @default(cuid())
  token      String   @unique @db.VarChar(128)
  platformUserId Int
  user       PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(300)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  @@index([platformUserId])
  @@map("platform_session")
}

