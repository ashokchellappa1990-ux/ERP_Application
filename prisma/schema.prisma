// ==========================================================================
// Load & Dispatch — the single warehouse-execution screen. Absorbs the old
// Dispatch Execution + Loading Confirmation screens into one full-page flow;
// Stock Transfer Dispatch (StockTransferDispatch) stays as a backing engine
// only — Load & Dispatch creates that row internally for docType=StockTransfer
// and calls the existing postDispatch() at completion (src/lib/warehouse/dispatch.ts).
// See src/lib/transport/loadDispatch.ts.
// ==========================================================================
model LoadDispatch {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  warehouse    String? @db.VarChar(120)
  dispatchNo   String  @db.VarChar(40)
  dispatchDate String  @db.VarChar(20)
  docType String @default("Customer") @db.VarChar(24) // Customer | StockTransfer | PurchaseReturn | SalesReturnPickup | ProductionTransfer | JobWork | Others
  sourceRefType String? @db.VarChar(30) // SALES_ORDER | TRANSFER_REQUEST | DIRECT
  sourceRefId   Int?
  sourceRefNo   String? @db.VarChar(60)
  // For docType=StockTransfer: the StockTransferDispatch row Load & Dispatch
  // creates internally (no longer a user-facing screen) — completeLoadDispatch
  // calls the existing postDispatch() against this id.
  stockTransferDispatchId Int?
  partyType String? @db.VarChar(20)
  partyId   Int?
  partyName String? @db.VarChar(200)
  deliveryAddress      String? @db.VarChar(400)
  destinationWarehouse String? @db.VarChar(120)
  vehicleGateEntryId Int?

  // Section 3 — Transport Info (auto-loaded from the Vehicle Gate Entry, editable).
  transportCompanyId Int?
  vehicleId          Int?
  vehicleType        String? @db.VarChar(60)
  driverName         String? @db.VarChar(150)
  driverMobile       String? @db.VarChar(20)
  driverLicenseNo    String? @db.VarChar(60)
  helperName         String? @db.VarChar(150)
  helperMobile       String? @db.VarChar(20)
  routeId            Int?
  sealNumber         String? @db.VarChar(60)
  trailerNumber      String? @db.VarChar(40)
  containerNumber    String? @db.VarChar(40)

  // Loading details — folded in from the old LoadingConfirmation screen.
  loadingBayId Int?
  supervisor   String? @db.VarChar(160)
  loadingStart DateTime?
  loadingEnd   DateTime?
  packages Int @default(0)
  pallets  Int @default(0)

  status String @default("Draft") @db.VarChar(30) // Draft | Ready | Loading | Dispatched | Delivery Challan Generated | Sales Invoice Posted | Cancelled

  // Dispatch Summary (computed).
  totalProducts Int      @default(0)
  totalQty      Decimal  @default(0) @db.Decimal(18, 3)
  totalWeight   Decimal? @db.Decimal(18, 3) // best-effort — Product has no shipped weight field yet
  totalPackages Int      @default(0)

  remarks      String? @db.Text
  cancelReason String? @db.VarChar(300)
  startedBy    Int?
  startedAt    DateTime?
  completedBy  Int?
  completedAt  DateTime?
  // Set the moment Complete Load & Dispatch reduces stock for a Customer
  // dispatch (see completeLoadDispatch in src/lib/transport/loadDispatch.ts) —
  // the Sales Invoice posts later without moving inventory again.
  inventoryPostedAt DateTime?
  deliveryChallanId Int?
  saleId            Int?
  approvedBy        Int?

  // Payment collection intent, captured at creation/edit time and applied when
  // the Sales Invoice actually posts (Delivery Challan generation, Automatic
  // mode; or Post Sales Invoice, Manual mode) — see buildPreparedSale() in
  // src/lib/transport/loadDispatch.ts.
  paymentMode   String?  @db.VarChar(16) // Full | Partial | Credit
  paymentAmount Decimal? @db.Decimal(18, 2)
  paymentMethod String?  @db.VarChar(30) // Cash | Bank Transfer | UPI | Cheque | Card
  bankId        Int?
  bankName      String?  @db.VarChar(150)
  bankAccount   String?  @db.VarChar(60)

  createdBy     Int?
  createdByName String? @db.VarChar(160)
  updatedBy     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  items LoadDispatchItem[]

  @@unique([tenantId, dispatchNo])
  @@index([tenantId, docType, status])
  @@index([sourceRefType, sourceRefId])
  // The most heavily-hit lookup on this table: every Vehicle Gate Entry list
  // load, its hover-detail fetch, and the gate-entry detail route all resolve
  // "the Load & Dispatch linked to this gate entry" via vehicleGateEntryId —
  // previously unindexed, forcing a full table scan on every one of those.
  @@index([vehicleGateEntryId])
  @@map("load_dispatch")
}

model LoadDispatchItem {
  id             Int @id @default(autoincrement())
  tenantId       Int
  loadDispatchId Int
  loadDispatch   LoadDispatch @relation(fields: [loadDispatchId], references: [id], onDelete: Cascade)
  productId   Int
  productName String  @db.VarChar(250)
  sku         String? @db.VarChar(60)
  uom         String? @db.VarChar(20)
  batchNo     String? @db.VarChar(80)
  mfgDate     String? @db.VarChar(20)
  expiryDate  String? @db.VarChar(20)
  serialNo    String? @db.VarChar(120)
  allocationLotId Int?
  allocatedQty  Decimal @default(0) @db.Decimal(18, 3)
  dispatchedQty Decimal @default(0) @db.Decimal(18, 3)
  pendingQty    Decimal @default(0) @db.Decimal(18, 3)
  rate   Decimal? @db.Decimal(18, 2)
  value  Decimal  @default(0) @db.Decimal(18, 2)
  weight Decimal? @db.Decimal(18, 3)
  // Invoice-grade line detail (mirrors SaleLine's shape) so this table can feed
  // an invoice-style item grid + the actual createSaleTx() posting later.
  discPct      Decimal? @db.Decimal(9, 2)
  discAmount   Decimal  @default(0) @db.Decimal(18, 2)
  taxPct       Decimal? @db.Decimal(9, 2)
  taxableValue Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(18, 2)
  // COGS resolved when Complete Load & Dispatch consumes stock (Customer
  // docType) — carried into the SaleLine at invoice time so createSaleTx
  // doesn't re-consume the same stock a second time.
  cost    Decimal? @db.Decimal(18, 2)
  qrCode  String? @db.VarChar(80)
  remarks String? @db.VarChar(300)
  status  String  @default("Active") @db.VarChar(16)
  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([loadDispatchId])
  @@index([tenantId, productId])
  @@map("load_dispatch_items")
}

