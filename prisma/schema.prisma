// ONE POS — Prisma schema (MySQL 8.x), database: onepos.
// First functionality: User Registration. The `User` model below maps the
// registration UI (Personal → Account → Business → Terms) plus the OTP
// verification flow, with an AUTO-INCREMENT integer primary key.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // Prisma 7: connection comes from prisma.config.ts (Migrate) and the driver
  // adapter passed to PrismaClient (runtime) — no `url` here.
}

/// Persists app-wide config singletons (general, notification, …) as JSON.
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
}

/// Per-tenant general settings (currency, number formatting, rounding, date /
/// time, regional, system behaviour, and stock-report column visibility).
/// Fully normalised — one typed column per setting.
model GeneralSetting {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  // Currency & numbers
  baseCurrency      String @default("INR") @db.VarChar(10)
  currencySymbol    String @default("₹") @db.VarChar(6)
  currencyPosition  String @default("before") @db.VarChar(10) // before | after
  numberSystem      String @default("indian") @db.VarChar(20) // indian | international
  thousandSeparator String @default("indian") @db.VarChar(20) // indian | international | none
  amountDecimals    Int    @default(2)
  qtyDecimals       Int    @default(2)
  rateDecimals      Int    @default(2)

  // Rounding
  roundingMethod    String @default("nearest") @db.VarChar(10)
  roundingPrecision String @default("1") @db.VarChar(10)

  // Date & time
  dateFormat String @default("dd-MMM-yyyy") @db.VarChar(20)
  timeFormat String @default("12h") @db.VarChar(5)
  timezone   String @default("Asia/Kolkata") @db.VarChar(40)

  // Regional / fiscal / system
  fiscalYearStart String @default("April") @db.VarChar(15)
  weekStart       String @default("Monday") @db.VarChar(15)
  language        String @default("en") @db.VarChar(10)
  defaultPageSize Int    @default(25)
  sessionTimeout  Int    @default(30)

  // Flags
  enableRounding      Boolean @default(true)
  roundInPrint        Boolean @default(true)
  showCurrencyCode    Boolean @default(false)
  negativeInRed       Boolean @default(true)
  autoLogout          Boolean @default(true)
  confirmBeforeDelete Boolean @default(true)
  compactDensity      Boolean @default(false)
  soundOnAction       Boolean @default(false)

  // Stock-position report column visibility
  rptShowReceipt Boolean @default(true)
  rptShowSales   Boolean @default(true)
  rptShowReturn  Boolean @default(true)
  rptShowDamage  Boolean @default(true)

  // When true, transactions must be created at a registered terminal under an open
  // session, and users see only their mapped terminals' data (see user_terminal_maps).
  terminalSetupRequired Boolean @default(false)

  // Shows/hides the floating AI Copilot bubble app-wide.
  showAiCopilot Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("general_settings")
}

/// Sales rule-engine configuration (per tenant). The whole flexible config
/// (fields / toggles / flags) is stored as one JSON document — the Sales
/// Settings screen edits it and the POS / Sales module obey it. Also carries the
/// persistent invoice running-number counters used to generate bill numbers.
model SalesSetting {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  config Json // { fields: {...}, toggles: {...}, flags: {...} }

  // Invoice numbering — running counters (next number to assign; 0 = use seqStart).
  seqB2c    Int     @default(0)
  seqB2b    Int     @default(0) // used only when a separate B2B sequence is enabled
  seqReturn Int     @default(0) // sales-return running counter
  seqExchange Int   @default(0) // sales-exchange running counter
  seqCancellation Int @default(0) // sales-cancellation running counter
  seqQuotation Int  @default(0) // sales-quotation running counter
  seqOrder     Int  @default(0) // sales-order running counter
  seqPeriod String? @db.VarChar(20) // period key the counters belong to (drives resets)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("sales_settings")
}

/// Sales Quotation + Sales Order — a pre-sale document (quote / commitment). It
/// does NOT post to the GL and does NOT move inventory (revenue posts at the
/// invoice, stock at delivery/invoice). One table for both, discriminated by
/// `docType` ('quotation' | 'order'); a quotation converts into an order, and an
/// order is billed by a B2B invoice. Mirrors the Purchase Order model.
model SalesDocument {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  docType String @db.VarChar(20) // quotation | order
  docNo   String @db.VarChar(40)
  docDate String @db.VarChar(20)
  status  String @default("Draft") @db.VarChar(24)

  customerId      Int?
  customerName    String? @db.VarChar(200)
  customerPhone   String? @db.VarChar(40)
  customerGstin   String? @db.VarChar(20)
  customerContact String? @db.VarChar(120)
  customerRef     String? @db.VarChar(80)

  salesperson String? @db.VarChar(120)
  enquiryNo   String? @db.VarChar(60)
  enquiryDate String? @db.VarChar(20)

  validUntil           String? @db.VarChar(20) // quotation validity
  expectedDeliveryDate String? @db.VarChar(20) // order delivery
  warehouse            String? @db.VarChar(120)
  deliveryAddress      String? @db.VarChar(400)
  shippingMode         String? @db.VarChar(20)

  paymentTerms String? @db.VarChar(120)
  creditDays   Int?
  dueDate      String? @db.VarChar(20)
  currency     String  @default("INR") @db.VarChar(10)

  gstApplicable Boolean @default(true)
  reverseCharge Boolean @default(false)
  interState    Boolean @default(false)
  gstMode       String  @default("exclusive") @db.VarChar(12)

  subtotal           Decimal @default(0) @db.Decimal(18, 2)
  itemDiscount       Decimal @default(0) @db.Decimal(18, 2)
  additionalDiscount Decimal @default(0) @db.Decimal(18, 2)
  taxableAmount      Decimal @default(0) @db.Decimal(18, 2)
  cgst               Decimal @default(0) @db.Decimal(18, 2)
  sgst               Decimal @default(0) @db.Decimal(18, 2)
  igst               Decimal @default(0) @db.Decimal(18, 2)
  gstAmount          Decimal @default(0) @db.Decimal(18, 2)
  freight            Decimal @default(0) @db.Decimal(18, 2)
  loading            Decimal @default(0) @db.Decimal(18, 2)
  packing            Decimal @default(0) @db.Decimal(18, 2)
  insurance          Decimal @default(0) @db.Decimal(18, 2)
  otherCharges       Decimal @default(0) @db.Decimal(18, 2)
  roundOff           Decimal @default(0) @db.Decimal(9, 2)
  totalValue         Decimal @default(0) @db.Decimal(18, 2)
  netAmount          Decimal @default(0) @db.Decimal(18, 2)
  itemCount          Int     @default(0)

  sourceDocType   String? @db.VarChar(20)
  sourceDocId     Int?
  sourceDocNo     String? @db.VarChar(40)
  convertedToType String? @db.VarChar(20)
  convertedToId   Int?
  convertedToNo   String? @db.VarChar(40)

  approvedBy     Int?
  approvedByName String?   @db.VarChar(160)
  approvedAt     DateTime?
  approvalNote   String?   @db.VarChar(300)
  issuedAt       DateTime?
  cancelledAt    DateTime?
  cancelReason   String?   @db.VarChar(300)

  remarks        String? @db.VarChar(500)
  internalNotes  String? @db.VarChar(500)
  termsConditions String? @db.Text

  createdBy     Int?
  createdByName String?  @db.VarChar(160)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  items       SalesDocumentItem[]
  attachments SalesDocumentAttachment[]

  @@unique([tenantId, docType, docNo])
  @@index([tenantId, docType, status])
  @@index([tenantId, docType, branchId, docDate])
  @@index([sourceDocId])
  @@map("sales_documents")
}

model SalesDocumentItem {
  id              Int      @id @default(autoincrement())
  salesDocumentId Int
  document        SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)
  productId       Int?
  productName     String   @db.VarChar(250)
  sku             String?  @db.VarChar(60)
  hsn             String?  @db.VarChar(20)
  uom             String?  @db.VarChar(40)
  qty             Decimal  @db.Decimal(18, 3)
  mrp             Decimal? @db.Decimal(18, 2)
  rate            Decimal  @default(0) @db.Decimal(18, 2)
  discPct         Decimal? @db.Decimal(9, 2)
  discAmount      Decimal  @default(0) @db.Decimal(18, 2)
  taxPct          Decimal? @db.Decimal(9, 2)
  taxableValue    Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  lineValue       Decimal  @default(0) @db.Decimal(18, 2)
  deliveredQty    Decimal  @default(0) @db.Decimal(18, 3)
  expectedDate    String?  @db.VarChar(20)
  remarks         String?  @db.VarChar(300)
  createdAt       DateTime @default(now())

  @@index([salesDocumentId])
  @@index([productId])
  @@map("sales_document_items")
}

model SalesDocumentAttachment {
  id              Int      @id @default(autoincrement())
  salesDocumentId Int
  document        SalesDocument @relation(fields: [salesDocumentId], references: [id], onDelete: Cascade)
  docType         String   @default("attachment") @db.VarChar(20)
  fileName        String   @db.VarChar(200)
  fileUrl         String   @db.LongText
  fileType        String?  @db.VarChar(80)
  size            Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([salesDocumentId])
  @@map("sales_document_attachments")
}

/// Advance Type master — categories of advance (Customer/Supplier/Employee/Travel/
/// Security Deposit …). `direction` = 'received' (money in → liability) | 'paid'
/// (money out → asset); `accountCode` is the GL control account it posts to.
model AdvanceType {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(120)
  direction   String   @default("received") @db.VarChar(12)
  accountCode String   @db.VarChar(20)
  partyType   String   @default("Customer") @db.VarChar(20)
  description String?  @db.VarChar(300)
  allowRefund Boolean  @default(true)
  allowPartial Boolean @default(true)
  displayOrder Int     @default(1)
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("advance_types")
}

/// Advance Management configuration (per tenant/business/branch) + the running
/// number counters for advances / settlements / refunds.
model AdvanceConfig {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  businessId    Int?
  branchId      Int?
  config        Json
  seqAdvance    Int      @default(0)
  seqSettlement Int      @default(0)
  seqRefund     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("advance_configs")
}

/// A single advance voucher (customer/supplier/employee). Posts one GL voucher on
/// approval. Balance = net − settled − refunded; never modified directly (settlements
/// and refunds are separate records that adjust it). Mirrors the Sales/Purchase docs.
model Advance {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  advanceNo   String @db.VarChar(40)
  advanceDate String @db.VarChar(20)
  department  String? @db.VarChar(120)
  costCenterId   Int?
  profitCenterId Int?

  advanceTypeId   Int?
  advanceTypeName String? @db.VarChar(120)
  direction       String  @default("received") @db.VarChar(12)
  accountCode     String? @db.VarChar(20)

  partyType String  @default("Customer") @db.VarChar(20)
  partyId   Int?
  partyName String? @db.VarChar(200)

  refDocType String? @db.VarChar(30)
  refDocId   Int?
  refNo      String? @db.VarChar(80)

  currency     String  @default("INR") @db.VarChar(10)
  exchangeRate Decimal @default(1) @db.Decimal(12, 4)
  advanceAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount     Decimal @default(0) @db.Decimal(18, 2)
  netAmount     Decimal @default(0) @db.Decimal(18, 2)

  paymentMode String? @db.VarChar(20)
  paymentRef  String? @db.VarChar(80)
  bankId      Int?
  bankName    String? @db.VarChar(150)
  bankAccount String? @db.VarChar(60)
  narration   String? @db.VarChar(500)
  attachments Json?

  settledAmount  Decimal @default(0) @db.Decimal(18, 2)
  refundedAmount Decimal @default(0) @db.Decimal(18, 2)
  balanceAmount  Decimal @default(0) @db.Decimal(18, 2)

  approvalStatus String @default("Draft") @db.VarChar(16)
  status         String @default("Draft") @db.VarChar(20)
  journalId      Int?

  approvedBy     Int?
  approvedByName String?   @db.VarChar(160)
  approvedAt     DateTime?
  approvalNote   String?   @db.VarChar(300)
  cancelledAt    DateTime?
  cancelReason   String?   @db.VarChar(300)

  createdBy     Int?
  createdByName String?  @db.VarChar(160)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  settlements AdvanceSettlement[]
  refunds     AdvanceRefund[]

  @@unique([tenantId, advanceNo])
  @@index([tenantId, status])
  @@index([tenantId, partyType, partyId])
  @@index([tenantId, advanceTypeId])
  @@map("advances")
}

/// A settlement adjusts an advance against an invoice/expense (or manual). Separate
/// record — never touches the advance's stored balance except by aggregation.
model AdvanceSettlement {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  settlementNo   String  @db.VarChar(40)
  settlementDate String  @db.VarChar(20)
  advanceId      Int
  advance        Advance @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  refDocType String? @db.VarChar(30)
  refDocId   Int?
  refNo      String? @db.VarChar(80)
  refInvoice String? @db.VarChar(80)

  settlementAmount   Decimal @default(0) @db.Decimal(18, 2)
  method             String  @default("Manual") @db.VarChar(16)
  expenseAccountCode String? @db.VarChar(20)
  remarks            String? @db.VarChar(500)
  attachments        Json?

  approvalStatus String    @default("Draft") @db.VarChar(16)
  status         String    @default("Draft") @db.VarChar(20)
  journalId      Int?
  reversedAt     DateTime?
  reverseReason  String?   @db.VarChar(300)

  createdBy     Int?
  createdByName String?  @db.VarChar(160)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, settlementNo])
  @@index([advanceId])
  @@index([tenantId, status])
  @@map("advance_settlements")
}

/// A refund returns an unsettled advance balance to/from the party.
model AdvanceRefund {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  refundNo   String  @db.VarChar(40)
  refundDate String  @db.VarChar(20)
  advanceId  Int
  advance    Advance @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  refundAmount Decimal @default(0) @db.Decimal(18, 2)
  refundMode   String? @db.VarChar(20)
  reason       String? @db.VarChar(300)
  narration    String? @db.VarChar(500)
  attachments  Json?

  approvalStatus String @default("Draft") @db.VarChar(16)
  status         String @default("Draft") @db.VarChar(20)
  journalId      Int?

  createdBy     Int?
  createdByName String?  @db.VarChar(160)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, refundNo])
  @@index([advanceId])
  @@index([tenantId, status])
  @@map("advance_refunds")
}

/// Purchase rule-engine configuration (per tenant/business/branch). The flexible
/// config (fields / flags) is stored as one JSON document — the Purchase
/// Configuration screen edits it and the Purchase Invoice module obeys it. Also
/// carries the purchase-invoice running-number counter.
model PurchaseSetting {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  config Json // { fields: {...}, flags: {...} }

  seqPI     Int     @default(0) // purchase-invoice running counter
  seqPR     Int     @default(0) // purchase-return running counter
  seqAsset  Int     @default(0) // fixed-asset register running counter
  seqPO     Int     @default(0) // purchase-order running counter
  seqPeriod String? @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("purchase_settings")
}

/// POS Configuration (per tenant) — inventory / POS / payment toggles plus the
/// tax treatment (price inclusive vs exclusive of GST) that the POS billing
/// screen and the sale API obey. Stored as one JSON document.
model PosSetting {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  config Json // { toggles, inventoryValuation, paymentDefault, taxMethod }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("pos_settings")
}

/// Accounting Rule Engine config (per tenant) — the Dr/Cr auto-journal mapping
/// for each ERP module, stored as one JSON document (RuleGroup[]).
model AccountingRuleSetting {
  id       Int    @id @default(autoincrement())
  tenantId Int    @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  config Json // RuleGroup[] { module, autoFlag, auto, rules:[{txn,dr,cr}] }

  updatedAt DateTime @updatedAt

  @@map("accounting_rule_settings")
}

/// Opening balances for Cash in Hand / Cash at Bank (per tenant). Saving posts an
/// opening journal (Dr Cash/Bank, Cr Opening Balance Equity). One row per line.
model OpeningBalance {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind      String  @db.VarChar(10) // CASH | BANK
  label     String? @db.VarChar(150)
  bankId    Int? // SetupBank reference (for BANK rows)
  bankName  String? @db.VarChar(150)
  branch    String? @db.VarChar(150)
  accountNo String? @db.VarChar(40)
  ifsc      String? @db.VarChar(20)
  amount    Decimal @default(0) @db.Decimal(18, 2)
  asOfDate  String  @db.VarChar(20)

  updatedAt DateTime @updatedAt

  @@index([tenantId])
  businessId Int?
  branchId   Int?

  @@map("opening_balances")
}

/// Application theme / branding (per tenant). Drives the colour theme — a preset
/// plus optional brand colour overrides — applied app-wide via CSS variables.
model ThemeSetting {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  theme   String @default("oneerp") @db.VarChar(30) // preset id
  density String @default("comfortable") @db.VarChar(20)

  primaryColor   String? @db.VarChar(20)
  secondaryColor String? @db.VarChar(20)
  accentColor    String? @db.VarChar(20)
  fontFamily     String? @db.VarChar(80)

  // Primary button / brand-gradient surface controls
  buttonStyle   String  @default("gradient") @db.VarChar(12) // gradient | solid
  gradientFrom  String? @db.VarChar(20) // gradient start (defaults to primary)
  gradientTo    String? @db.VarChar(20) // gradient end (defaults to secondary)
  gradientAngle Int     @default(135)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("theme_settings")
}

/// Customer master — walk-in or registered buyers for POS / B2B sales.
model Customer {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(200)
  phone       String? @db.VarChar(20)
  email       String? @db.VarChar(150)
  gstin       String? @db.VarChar(20)
  dob         String? @db.VarChar(20) // date of birth
  anniversary String? @db.VarChar(20)
  gender      String? @db.VarChar(20) // Male | Female | Other | Prefer not to say
  address       String? @db.VarChar(300)
  city          String? @db.VarChar(80)
  state         String? @db.VarChar(80)
  pincode       String? @db.VarChar(12)
  contactPerson String? @db.VarChar(120)

  loyaltyPoints Int     @default(0) // == availableRewardPoints (kept in sync for POS display)
  totalSpent    Decimal @default(0) @db.Decimal(18, 2)
  status        String  @default("Active") @db.VarChar(20)

  // Loyalty reward roll-ups (system of record is loyalty_customer_balance; mirrored here for fast lookup).
  availableRewardPoints      Int @default(0)
  totalRewardPointsEarned    Int @default(0)
  totalRewardPointsRedeemed  Int @default(0)
  totalRewardPointsExpired   Int @default(0)
  customerGroup String? @db.VarChar(80) // eligibility grouping (Phase 1: free-text)

  // Membership Registration integration (updated when a membership is activated).
  isMember          Boolean @default(false)
  membershipNumber  String? @db.VarChar(60)
  membershipLevelId Int?
  membershipStatus  String? @db.VarChar(12)
  membershipExpiry  String? @db.VarChar(20)

  // Customer Master fields.
  code        String? @db.VarChar(40)
  legalName   String? @db.VarChar(200)
  type        String? @db.VarChar(40)  // Retail / Wholesale / Distributor / …
  category    String? @db.VarChar(40)  // Regular / VIP / Premium / …
  regDate     String? @db.VarChar(20)
  since       String? @db.VarChar(20)
  altMobile      String? @db.VarChar(20)
  whatsapp       String? @db.VarChar(20)
  contact2Name   String? @db.VarChar(120)
  contact2Mobile String? @db.VarChar(20)
  contact2Email  String? @db.VarChar(150)
  pan          String? @db.VarChar(20)
  tan          String? @db.VarChar(20)
  businessName String? @db.VarChar(200)
  stateCode    String? @db.VarChar(10)
  creditAllowed     Boolean @default(false)
  creditLimit       Decimal @default(0) @db.Decimal(18, 2)
  creditPeriod      Int     @default(0)
  ledgerAccount     String? @db.VarChar(120)
  advanceAccount    String? @db.VarChar(120)
  openingReceivable Decimal @default(0) @db.Decimal(18, 2)
  openingAdvance    Decimal @default(0) @db.Decimal(18, 2)
  approvalStatus    String  @default("draft") @db.VarChar(20) // draft | pending | approved | rejected
  notes             String? @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
  credits   CustomerCredit[]
  addresses CustomerAddress[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, name])
  businessId Int?
  branchId   Int?

  @@map("customers")
}

/// Customer notes / logged communications shown on the Customer 360 dashboard.
/// (Communication & service modules are future; this powers the Notes feature now.)
model CustomerNote {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  customerId Int

  type      String  @default("Note") @db.VarChar(20) // Note | SMS | Email | WhatsApp | Call
  subject   String? @db.VarChar(200)
  body      String  @db.VarChar(2000)

  createdBy     Int?
  createdByName String? @db.VarChar(160)
  createdAt     DateTime @default(now())

  @@index([tenantId, customerId])
  @@map("customer_notes")
}

/// Additional addresses for a customer (billing / shipping / home / office / …).
/// The primary billing address is also mirrored onto the Customer row for POS lookups.
model CustomerAddress {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label    String  @default("Other") @db.VarChar(20) // Billing | Shipping | Home | Office | Delivery | Other
  line1    String? @db.VarChar(200)
  line2    String? @db.VarChar(200)
  city     String? @db.VarChar(80)
  district String? @db.VarChar(80)
  state    String? @db.VarChar(80)
  country  String? @db.VarChar(80)
  pincode  String? @db.VarChar(12)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("customer_addresses")
}

/// Loyalty Program master — a configurable reward-point program (Phase 1). All
/// earn/redeem/validity/eligibility rules live on the record as typed columns so
/// the engine resolves the effective program for a sale by scope + priority.
model LoyaltyProgram {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  code          String  @db.VarChar(40)
  name          String  @db.VarChar(160)
  description   String? @db.VarChar(400)
  effectiveFrom String? @db.VarChar(20)
  effectiveTo   String? @db.VarChar(20)
  priority      Int     @default(0)
  status        String  @default("Draft") @db.VarChar(20) // Draft | Active | Inactive
  remarks       String? @db.VarChar(300)

  // Eligibility + applicable sales channels.
  eligibility String  @default("all") @db.VarChar(20) // all | registered | groups
  eligibleGroups String? @db.VarChar(300) // CSV of customer groups when eligibility = groups
  applyPos    Boolean @default(true)
  applyB2c    Boolean @default(true)
  applyB2b    Boolean @default(false)
  applyOnline Boolean @default(false)

  // Reward point calculation.
  calcMethod         String  @default("amount") @db.VarChar(20) // fixed | amount | percentage
  fixedPoints        Int     @default(0)        // fixed: points per invoice
  amountPer          Decimal @default(100) @db.Decimal(18, 2) // amount: per ₹X …
  amountPoints       Int     @default(1)        // … award Y points
  percentageRate     Decimal @default(1) @db.Decimal(9, 2)    // percentage: % of bill → points
  minBillAmount      Decimal @default(0) @db.Decimal(18, 2)
  maxPointsPerInvoice Int?
  maxDailyPoints     Int?
  maxMonthlyPoints   Int?
  roundOff           String  @default("floor") @db.VarChar(10) // floor | round | ceil

  // Redemption.
  redemptionEnabled  Boolean @default(true)
  minRedeemPoints    Int     @default(0)
  maxRedeemPoints    Int?
  maxRedeemPercent   Decimal? @db.Decimal(9, 2) // % of bill
  maxRedeemAmount    Decimal? @db.Decimal(18, 2)
  allowPartialRedeem Boolean @default(true)
  pointValuePoints   Int     @default(1)   // N points …
  pointValueAmount   Decimal @default(1) @db.Decimal(18, 4) // … = ₹M

  // Point validity.
  validityType      String  @default("never") @db.VarChar(10) // never | days | months
  validityDays      Int?
  validityMonths    Int?
  autoExpiry        Boolean @default(false)
  expiryNotification Boolean @default(false)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("loyalty_program")
}

/// Per-customer reward-point balance (system of record; mirrored onto Customer).
model LoyaltyCustomerBalance {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  customerId Int

  available Int @default(0)
  earned    Int @default(0)
  redeemed  Int @default(0)
  expired   Int @default(0)

  lastTxnAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@map("loyalty_customer_balance")
}

/// Append-only loyalty transaction ledger — every earn/redeem/reversal/adjust/expiry.
model LoyaltyTransactionLedger {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  ledgerNo  String? @db.VarChar(40)
  txnDate   String  @db.VarChar(20)
  customerId Int
  programId  Int?

  txnType String @db.VarChar(24) // Earn | Redeem | SalesReturn | SalesCancellation | ManualCredit | ManualDebit | Expired
  points  Int    // signed: +credit, -debit
  value   Decimal @default(0) @db.Decimal(18, 2) // ₹ equivalent of the points moved (for reports + GL)
  balanceAfter Int @default(0)

  refType   String? @db.VarChar(24) // SALE | SALES_RETURN | SALES_CANCELLATION | MANUAL | EXPIRY
  refId     Int?
  invoiceNo String? @db.VarChar(40)
  remarks   String? @db.VarChar(300)

  createdBy Int?
  createdAt DateTime @default(now())

  @@index([tenantId, customerId])
  @@index([tenantId, txnDate])
  @@index([tenantId, txnType])
  @@index([refType, refId])
  @@map("loyalty_transaction_ledger")
}

/// Global loyalty configuration + running counters (per tenant/business/branch).
model LoyaltySetting {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  enabled         Boolean @default(false)
  defaultProgramId Int?
  config Json? // reserved for future general settings

  seqProgram Int @default(0)
  seqLedger  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("loyalty_settings")
}

/// A POS / sales invoice. Completing a sale posts SALES OUT movements into
/// inventory (reducing balances + consuming lots FIFO) and records the tender.
model Sale {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceNo String @db.VarChar(40)
  saleDate  String @db.VarChar(20)
  channel   String @default("POS") @db.VarChar(20) // POS | B2B
  status    String @default("Completed") @db.VarChar(20) // Completed | Cancelled

  customerId    Int?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String?   @db.VarChar(200)
  customerPhone String?   @db.VarChar(20)
  customerGstin String?   @db.VarChar(20) // snapshot of the customer's GSTIN (B2B)
  warehouse     String?   @db.VarChar(120)

  // B2B credit terms
  dueDate         String? @db.VarChar(20)
  paymentTerms    String? @db.VarChar(120)
  soNumber        String? @db.VarChar(40) // referenced Sales Order number
  termsConditions String? @db.Text

  // Totals
  subtotal     Decimal @default(0) @db.Decimal(18, 2)
  itemDiscount Decimal @default(0) @db.Decimal(18, 2)
  billDiscount Decimal @default(0) @db.Decimal(18, 2)
  taxableValue Decimal @default(0) @db.Decimal(18, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 2)
  sgst         Decimal @default(0) @db.Decimal(18, 2)
  igst         Decimal @default(0) @db.Decimal(18, 2)
  taxTotal     Decimal @default(0) @db.Decimal(18, 2)
  tdsAmount    Decimal @default(0) @db.Decimal(18, 2) // tax deducted at source (customer deducts)
  tcsAmount    Decimal @default(0) @db.Decimal(18, 2) // tax collected at source (added to invoice)
  roundOff     Decimal @default(0) @db.Decimal(9, 2)
  total        Decimal @default(0) @db.Decimal(18, 2)
  cost         Decimal @default(0) @db.Decimal(18, 2) // COGS (FIFO) for margin

  // Payment
  amountPaid    Decimal @default(0) @db.Decimal(18, 2)
  changeDue     Decimal @default(0) @db.Decimal(18, 2)
  paymentMode   String? @db.VarChar(40) // Cash | Card | UPI | Split | Credit
  paymentStatus String  @default("Paid") @db.VarChar(12) // Paid | Partial | Credit
  bankId        Int?
  bankName      String? @db.VarChar(150)
  bankAccount   String? @db.VarChar(60)

  // Loyalty (Phase 1) — points earned/redeemed on this sale (for traceability + reversal).
  loyaltyEarned     Int     @default(0)
  loyaltyRedeemed   Int     @default(0)
  loyaltyRedeemValue Decimal @default(0) @db.Decimal(18, 2) // ₹ discount applied from redeemed points

  notes     String? @db.Text
  itemCount Int     @default(0)
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines       SaleLine[]
  payments    SalePayment[]
  attachments SaleAttachment[]
  lineQrs     SaleLineQr[]
  returns     SalesReturn[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, status])
  @@index([tenantId, saleDate])
  @@index([terminalSessionId])
  businessId Int?
  branchId   Int?

  // POS terminal / shift / session traceability (additive; see pos_terminals).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20) // WEB_POS | MOBILE_POS | SELF_CHECKOUT | API | ECOMMERCE
  dayOpeningId      Int? // EOD: the DayOpening this txn belongs to
  dayClosingId      Int? // EOD: set when the business day is closed

  @@map("sales")
}

/// A document attached to a sale / invoice (PO copy, signed delivery note, etc.).
model SaleAttachment {
  id       Int  @id @default(autoincrement())
  tenantId Int
  saleId   Int
  sale     Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  fileName String  @db.VarChar(200)
  fileUrl  String  @db.VarChar(400)
  fileType String? @db.VarChar(80)
  size     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([saleId])
  businessId Int?
  branchId   Int?

  @@map("sale_attachments")
}

/// One sale line item.
model SaleLine {
  id     Int  @id @default(autoincrement())
  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName String  @db.VarChar(250)
  sku         String? @db.VarChar(60)
  hsn         String? @db.VarChar(20)
  uom         String? @db.VarChar(40)

  qty          Decimal  @db.Decimal(18, 3)
  mrp          Decimal? @db.Decimal(18, 2)
  rate         Decimal  @db.Decimal(18, 2) // selling unit rate
  discPct      Decimal? @db.Decimal(9, 2)
  discAmount   Decimal  @default(0) @db.Decimal(18, 2)
  taxPct       Decimal? @db.Decimal(9, 2)
  taxableValue Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(18, 2)
  value        Decimal  @default(0) @db.Decimal(18, 2) // line total incl tax
  cost         Decimal  @default(0) @db.Decimal(18, 2)

  // Batch sold (for batch-tracked products) — traceability & FEFO consumption.
  batchNo    String? @db.VarChar(80)
  mfgDate    String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)
  // DEPRECATED: scanned QR codes are now stored one-row-per-code in sale_line_qrs.
  // This CSV column is left for back-compat but is no longer written.
  qrCodes    String? @db.Text

  qrs SaleLineQr[]

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
  @@map("sale_lines")
}

/// One scanned QR code consumed by a sale line — links the qr_code_mappings row to
/// the sale line (one row per code). Records unique AND shared scans; the
/// sale_lines structure is untouched. Unique codes are also flipped to Sold on
/// qr_code_mappings (single-use); shared codes are not.
model SaleLineQr {
  id              Int           @id @default(autoincrement())
  tenantId        Int
  saleId          Int
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleLineId      Int
  saleLine        SaleLine      @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  qrCodeMappingId Int
  qrMapping       QrCodeMapping @relation(fields: [qrCodeMappingId], references: [id], onDelete: Cascade)
  productId       Int
  code            String        @db.VarChar(80) // denormalised for easy lookup
  mode            String        @db.VarChar(10) // shared | unique
  batchNo         String?       @db.VarChar(80)
  mfgDate         String?       @db.VarChar(20)
  expiryDate      String?       @db.VarChar(20)
  businessId      Int?
  branchId        Int?
  createdAt       DateTime      @default(now())

  @@index([tenantId, code])
  @@index([saleLineId])
  @@index([saleId])
  @@index([qrCodeMappingId])
  @@map("sale_line_qrs")
}

/// Sales Return header — a return raised against an original sale invoice. On
/// approval it posts SALES_RETURN inventory movements (to the right warehouse
/// bucket), reverses the sale's GL proportionally, and settles the refund.
model SalesReturn {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  returnNo   String @db.VarChar(40)
  returnDate String @db.VarChar(20)

  saleId    Int?
  sale      Sale?  @relation(fields: [saleId], references: [id], onDelete: SetNull)
  invoiceNo String? @db.VarChar(40) // original invoice number (snapshot)

  customerId    Int?
  customerName  String? @db.VarChar(200)
  customerPhone String? @db.VarChar(20)

  grossAmount   Decimal @default(0) @db.Decimal(18, 2)
  discountAdj   Decimal @default(0) @db.Decimal(18, 2)
  taxAdj        Decimal @default(0) @db.Decimal(18, 2)
  refundAmount  Decimal @default(0) @db.Decimal(18, 2)
  refundMode    String? @db.VarChar(20) // cash | upi | bank | storeCredit | creditNote
  refundRef     String? @db.VarChar(80)
  refundRemarks String? @db.VarChar(300)

  status       String  @default("Draft") @db.VarChar(20) // Draft | Pending | Approved | Rejected | Completed
  approvedBy   Int?
  approvedAt   DateTime?
  approvalNote String? @db.VarChar(300)

  itemCount Int      @default(0)
  notes     String?  @db.VarChar(300)
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines SalesReturnLine[]

  @@unique([tenantId, returnNo])
  @@index([tenantId, status])
  @@index([tenantId, returnDate])
  @@index([saleId])

  // POS terminal / shift / session traceability (additive).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@map("sales_returns")
}

/// Sales Cancellation — voids an ENTIRE sales invoice (vs a Sales Return which
/// returns selected lines). On approval the whole sale is reversed: inventory
/// restored, serials → Available, accounting reversed, customer ledger + loyalty
/// rolled back, and the sale marked Cancelled (so it drops out of POS/EOD cash).
model SalesCancellation {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  cancellationNo   String @db.VarChar(40) // auto
  cancellationDate String @db.VarChar(20)

  saleId    Int
  invoiceNo String? @db.VarChar(40)
  channel   String? @db.VarChar(10) // POS | B2B
  warehouse String? @db.VarChar(120)

  customerId    Int?
  customerName  String? @db.VarChar(200)
  customerPhone String? @db.VarChar(20)

  invoiceAmount Decimal @default(0) @db.Decimal(18, 2)
  refundAmount  Decimal @default(0) @db.Decimal(18, 2)
  refundMethod  String? @db.VarChar(20) // original | cash | storeCredit | wallet
  paymentMode   String? @db.VarChar(20) // original sale payment mode (snapshot)

  reason  String? @db.VarChar(160)
  remarks String? @db.VarChar(400)

  status       String    @default("Draft") @db.VarChar(20) // Draft | Pending Approval | Approved | Rejected | Cancelled
  approvedBy   Int?
  approvedAt   DateTime?
  approvalNote String?   @db.VarChar(300)

  // Reversal status flags (spec).
  inventoryReversed       Boolean @default(false)
  paymentReversed         Boolean @default(false)
  accountingReversed      Boolean @default(false)
  customerLedgerReversed  Boolean @default(false)
  loyaltyReversed         Boolean @default(false)
  journalRef              String? @db.VarChar(40)

  itemCount Int      @default(0)
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    SalesCancellationItem[]
  payments SalesCancellationPayment[]

  // POS terminal / shift / session traceability (additive).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@unique([tenantId, cancellationNo])
  @@index([tenantId, status])
  @@index([tenantId, cancellationDate])
  @@index([saleId])
  @@map("sales_cancellations")
}

/// Snapshot of a cancelled sale's lines (for audit + product-wise reporting).
model SalesCancellationItem {
  id                  Int               @id @default(autoincrement())
  salesCancellationId Int
  cancellation        SalesCancellation @relation(fields: [salesCancellationId], references: [id], onDelete: Cascade)

  saleLineId  Int?
  productId   Int?
  productName String  @db.VarChar(250)
  sku         String? @db.VarChar(60)
  hsn         String? @db.VarChar(20)

  qty        Decimal @db.Decimal(18, 3)
  rate       Decimal @default(0) @db.Decimal(18, 2)
  taxAmount  Decimal @default(0) @db.Decimal(18, 2)
  value      Decimal @default(0) @db.Decimal(18, 2)
  cost       Decimal @default(0) @db.Decimal(18, 2)

  batchNo    String? @db.VarChar(80)
  mfgDate    String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)
  serialNos  String? @db.VarChar(500) // restored manufacturer serials (comma-separated)

  createdAt DateTime @default(now())

  @@index([salesCancellationId])
  @@index([productId])
  @@map("sales_cancellation_items")
}

/// Per-tender reversal record for a cancellation (cash refunded immediately,
/// card/UPI marked Pending until the gateway refund settles).
model SalesCancellationPayment {
  id                  Int               @id @default(autoincrement())
  salesCancellationId Int
  cancellation        SalesCancellation @relation(fields: [salesCancellationId], references: [id], onDelete: Cascade)

  mode         String  @db.VarChar(20) // Cash | Card | UPI | Wallet | Credit | ...
  amount       Decimal @default(0) @db.Decimal(18, 2)
  reference    String? @db.VarChar(120)
  refundStatus String  @default("Completed") @db.VarChar(20) // Completed | Pending

  createdAt DateTime @default(now())

  @@index([salesCancellationId])
  @@map("sales_cancellation_payments")
}

/// One returned line on a sales return.
model SalesReturnLine {
  id            Int         @id @default(autoincrement())
  salesReturnId Int
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  saleLineId  Int? // the original sale line (snapshot link; no FK relation)
  productId   Int
  productName String  @db.VarChar(250)
  sku         String? @db.VarChar(60)

  soldQty     Decimal @db.Decimal(18, 3)
  returnQty   Decimal @db.Decimal(18, 3)
  rate        Decimal @db.Decimal(18, 2)
  discAmount  Decimal @default(0) @db.Decimal(18, 2)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)
  returnValue Decimal @default(0) @db.Decimal(18, 2) // refund value for the line (incl tax)
  cost        Decimal @default(0) @db.Decimal(18, 2) // unit cost (for inventory/COGS restore)

  reason  String? @db.VarChar(120)
  remarks String? @db.VarChar(300)
  // good | damaged | expired | vendor | scrap — drives the destination warehouse.
  inventoryHandling String @default("good") @db.VarChar(20)

  batchNo    String? @db.VarChar(80)
  mfgDate    String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)

  createdAt DateTime @default(now())

  qrs SalesReturnQr[]

  @@index([salesReturnId])
  @@index([productId])
  @@map("sales_return_lines")
}

/// One returned QR code on a return line (traceability; mirrors sale_line_qrs).
model SalesReturnQr {
  id                Int             @id @default(autoincrement())
  tenantId          Int
  salesReturnLineId Int
  returnLine        SalesReturnLine @relation(fields: [salesReturnLineId], references: [id], onDelete: Cascade)
  qrCodeMappingId   Int
  qrMapping         QrCodeMapping   @relation(fields: [qrCodeMappingId], references: [id], onDelete: Cascade)
  code              String          @db.VarChar(80)
  mode              String          @db.VarChar(10)
  createdAt         DateTime        @default(now())

  @@index([tenantId, code])
  @@index([salesReturnLineId])
  @@map("sales_return_qrs")
}

/// Sales Exchange — returns an old item and issues a new one against an original
/// invoice, settling the price difference. Posting reuses the return + sale legs:
/// `returnId` links the created SalesReturn (stock IN + GL reverse + refund) and
/// `newSaleId` links the created Sale (stock OUT + sales GL). Net cash = price
/// difference automatically. Items are also snapshotted in sales_exchange_items.
model SalesExchange {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  exchangeNo   String @db.VarChar(40)
  exchangeDate String @db.VarChar(20)

  originalSaleId Int?
  invoiceNo      String? @db.VarChar(40) // original invoice number (snapshot)

  customerId    Int?
  customerName  String? @db.VarChar(200)
  customerPhone String? @db.VarChar(20)
  channel       String  @default("POS") @db.VarChar(20) // POS | B2B

  returnId  Int? // the created SalesReturn (return leg)
  newSaleId Int? // the created Sale (new-item leg)

  returnValue     Decimal @default(0) @db.Decimal(18, 2) // value of returned items (incl tax)
  newSaleValue    Decimal @default(0) @db.Decimal(18, 2) // value of new items (incl tax)
  priceDifference Decimal @default(0) @db.Decimal(18, 2) // newSaleValue - returnValue (+collect / -refund)
  settlementType  String  @default("even") @db.VarChar(10) // collect | refund | even
  settlementMode  String? @db.VarChar(20) // cash | upi | card | creditNote | storeCredit | wallet
  settlementRef   String? @db.VarChar(80)

  reason  String? @db.VarChar(120)
  remarks String? @db.VarChar(300)

  status       String  @default("Draft") @db.VarChar(20) // Draft | Pending | Approved | Rejected | Completed
  approvedBy   Int?
  approvedAt   DateTime?
  approvalNote String? @db.VarChar(300)

  itemCount Int      @default(0)
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SalesExchangeItem[]

  @@unique([tenantId, exchangeNo])
  @@index([tenantId, status])
  @@index([tenantId, branchId, exchangeDate])
  @@index([originalSaleId])

  // POS terminal / shift / session traceability (additive).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@map("sales_exchange")
}

/// One line on a sales exchange — a flat snapshot of both sides (RETURN = old item
/// taken back, NEW = item issued). Drives the view screen + reporting, and lets a
/// Pending exchange rebuild its legs at approval time.
model SalesExchangeItem {
  id         Int           @id @default(autoincrement())
  exchangeId Int
  exchange   SalesExchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  side String @db.VarChar(10) // RETURN | NEW

  saleLineId  Int? // original sale line (RETURN side; snapshot link)
  productId   Int
  productName String  @db.VarChar(250)
  sku         String? @db.VarChar(60)

  qty       Decimal @db.Decimal(18, 3)
  rate      Decimal @default(0) @db.Decimal(18, 2)
  taxPct    Decimal? @db.Decimal(9, 2)
  taxAmount Decimal @default(0) @db.Decimal(18, 2)
  value     Decimal @default(0) @db.Decimal(18, 2) // line total incl tax

  reason            String? @db.VarChar(120)
  inventoryHandling String? @db.VarChar(20) // RETURN side: good | damaged | quarantine

  batchNo    String? @db.VarChar(80)
  mfgDate    String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)

  createdAt DateTime @default(now())

  @@index([exchangeId])
  @@index([productId])
  @@map("sales_exchange_items")
}

/// Customer store-credit / credit-note ledger — issued by a sales return refund.
/// Redemption (using it on a future sale) is a later phase.
model CustomerCredit {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  creditNo   String  @db.VarChar(40)
  type       String  @db.VarChar(20) // StoreCredit | CreditNote
  amount     Decimal @db.Decimal(18, 2)
  balance    Decimal @db.Decimal(18, 2) // remaining (= amount until redeemed)
  sourceType String  @default("SALES_RETURN") @db.VarChar(20)
  sourceId   Int?
  status     String  @default("Active") @db.VarChar(20) // Active | Used | Expired
  createdAt  DateTime @default(now())

  @@index([tenantId, customerId])
  @@map("customer_credits")
}

/// Per-tenant POS receipt / invoice template — drives what the printed bill
/// shows (paper size, columns, header/footer notes, GST breakup, thank-you).
model InvoiceTemplate {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type     String @default("B2C") @db.VarChar(20) // B2C | B2B | COLLECTION

  title           String  @default("Tax Invoice") @db.VarChar(60)
  paperSize       String  @default("80mm") @db.VarChar(10) // 58mm | 80mm | A5 | A4
  headerNote      String? @db.VarChar(200)
  thankYouMessage String  @default("Thank you! Visit again.") @db.VarChar(200)
  footerNote      String? @db.VarChar(300)

  showGstin      Boolean @default(true)
  showCustomer   Boolean @default(true)
  showHsn        Boolean @default(false)
  showMrp        Boolean @default(true)
  showSavings    Boolean @default(true)
  showTaxBreakup Boolean @default(true)
  showItemTax    Boolean @default(false)

  // Header identity: show the business's common name + GSTIN, or the branch's.
  useBranchDetails Boolean @default(false)
  showBranchName   Boolean @default(false) // print the branch name line
  showContact      Boolean @default(false) // print a contact / toll-free number
  contactNumber    String? @db.VarChar(40)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, type])
  businessId Int?
  branchId   Int?

  @@map("invoice_templates")
}

/// A tender against a sale (supports split payments).
model SalePayment {
  id     Int  @id @default(autoincrement())
  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  mode      String  @db.VarChar(30) // Cash | Card | UPI | Wallet | Credit
  amount    Decimal @db.Decimal(18, 2)
  reference String? @db.VarChar(80)
  createdAt DateTime @default(now())

  @@index([saleId])
  businessId Int?
  branchId   Int?

  @@map("sale_payments")
}

/// A subscribing retail business (the unit of multi-tenancy). Every business-
/// owned row carries `tenantId`, and all queries are scoped to the signed-in
/// user's tenant so shops never see each other's data. The subscription plan,
/// status and feature/seat limits live here.
model Tenant {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(200)
  slug String @unique @db.VarChar(80)

  // Subscription
  plan        String    @default("trial") @db.VarChar(30) // trial | basic | pro | enterprise
  status      String    @default("active") @db.VarChar(20) // active | suspended | expired
  trialEndsAt DateTime?
  expiresAt   DateTime?

  // Feature flags & seat / volume limits (gated per plan)
  maxUsers        Int     @default(3)
  maxBranches     Int     @default(1)
  maxProducts     Int     @default(2000)
  modulePharmacy  Boolean @default(false)
  moduleLoyalty   Boolean @default(false)
  moduleEcommerce Boolean @default(false)

  // Platform Administration (SaaS lifecycle) — managed by the Platform Portal only.
  platformStatus String   @default("Active") @db.VarChar(16) // Active | Suspended | Deactivated | Archived
  businessAdminEmail String? @db.VarChar(150)
  businessAdminPhone String? @db.VarChar(20)
  lastLoginAt    DateTime?
  archivedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses        Business[]
  branches          Branch[]
  roles             Role[]
  users             User[]
  products          Product[]
  masterValues      MasterValue[]
  openingStocks     OpeningStock[]
  companySetups     CompanySetup[]
  qrSettings        QrCodeSetting[]
  inventoryLedger   InventoryLedger[]
  inventoryBalances InventoryBalance[]
  inventoryLots     InventoryLot[]
  goodsReceiptNotes GoodsReceiptNote[]
  suppliers         Supplier[]
  payables          Payable[]
  generalSettings   GeneralSetting[]
  salesSettings     SalesSetting[]
  purchaseSettings  PurchaseSetting[]
  dispatchConfigurations DispatchConfiguration[]
  documentFieldConfigs   DocumentFieldConfig[]
  purchaseInvoices  PurchaseInvoice[]
  posSettings       PosSetting[]
  themeSettings     ThemeSetting[]
  ledgerAccounts      LedgerAccount[]
  journalEntries      JournalEntry[]
  supplierPayments    SupplierPayment[]
  customerCollections CustomerCollection[]
  accountingRules     AccountingRuleSetting?
  openingBalances     OpeningBalance[]
  financialPeriods    FinancialPeriod[]
  expenseHeads        ExpenseHead[]
  pettyCashConfig     PettyCashConfig?
  pettyCashVouchers   PettyCashVoucher[]
  customers         Customer[]
  sales             Sale[]
  invoiceTemplates  InvoiceTemplate[]
  salesReturns      SalesReturn[]
  customerCredits   CustomerCredit[]
  auditLogs         AuditLog[]
  posTerminals      PosTerminal[]
  shifts            Shift[]
  terminalShiftMaps TerminalShiftMap[]
  terminalSessions  TerminalSession[]
  userTerminalMaps  UserTerminalMap[]
  dayOpenings       DayOpening[]
  dayClosings       DayClosing[]
  cashDeclarations  CashDeclaration[]
  shiftClosings     ShiftClosing[]
  terminalCashTxns  TerminalCashTransaction[]
  terminalFundXfers TerminalFundTransfer[]
  safeLockerTxns    SafeLockerTransaction[]
  bankDeposits      BankDeposit[]
  terminalClosingSummaries TerminalClosingSummary[]
  daySummaries      DaySummary[]
  salesExchanges    SalesExchange[]

  @@map("tenants")
}

/// A registered account. Mirrors the registration form fields and supports the
/// post-registration OTP verification and (optional) social sign-up.
model User {
  id Int @id @default(autoincrement())

  // ---- Tenant (the business this user belongs to) ----
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ---- Business / branch assignment (the user's home scope) ----
  // Which business + branch this user operates in by default. getActiveScope()
  // uses these so each user is segregated to their assigned business/branch;
  // owner/admin roles may switch to other businesses/branches in the tenant.
  businessId Int?
  branchId   Int?

  // ---- Access role (RBAC) — drives which features are visible after login ----
  roleId Int?
  roleRef Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // ---- Personal information (Section 1) ----
  fullName    String @db.VarChar(150)
  countryCode String @default("+91") @db.VarChar(6)
  mobile      String @unique @db.VarChar(15)
  email       String @unique @db.VarChar(150)

  // ---- Account credentials (Section 2) ----
  username     String @unique @db.VarChar(60)
  passwordHash String @db.VarChar(255) // bcrypt/argon hash — never the plain password

  // ---- Business information (Section 3) ----
  businessName String @db.VarChar(200)
  businessType String @db.VarChar(50) // grocery | pharmacy | textile | electronics | …

  // ---- Role & account status ----
  role     String  @default("owner") @db.VarChar(30) // owner | admin | manager | cashier
  status   String  @default("pending") @db.VarChar(20) // pending | active | suspended | inactive
  isActive Boolean @default(true)

  // ---- Verification (routes to /verify-otp after sign-up) ----
  emailVerified    Boolean   @default(false)
  mobileVerified   Boolean   @default(false)
  emailVerifiedAt  DateTime?
  mobileVerifiedAt DateTime?
  otpCode          String?   @db.VarChar(10)
  otpExpiresAt     DateTime?
  otpAttempts      Int       @default(0)

  // ---- Registration source / social sign-up (Google / Microsoft) ----
  registrationSource String  @default("web") @db.VarChar(20) // web | google | microsoft
  authProvider       String? @db.VarChar(30)
  authProviderId     String? @db.VarChar(191)

  // ---- Profile & consent ----
  avatarUrl       String?   @db.VarChar(500)
  agreedToTerms   Boolean   @default(false)
  termsAcceptedAt DateTime?

  // ---- Audit ----
  lastLoginAt DateTime?
  lastLoginIp String?  @db.VarChar(45)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions     Session[]
  activityLogs ActivityLog[]
  companySetup CompanySetup?
  terminalMaps UserTerminalMap[]

  @@index([tenantId])
  @@index([mobile])
  @@index([email])
  @@index([username])
  @@index([status])
  @@map("users")
}

/// A permission in the global catalog — one feature/menu key (e.g. "sales.pos").
/// Drives which features are enabled & displayed after login. Catalog is system-
/// wide (no tenantId); tenants grant subsets to their roles via RolePermission.
model Permission {
  id        Int    @id @default(autoincrement())
  key       String @unique @db.VarChar(80) // e.g. "masters.product", "finance.petty-cash"
  module    String @db.VarChar(60) // grouping label (the menu section)
  label     String @db.VarChar(120)
  sortOrder Int    @default(0)

  roles RolePermission[]

  @@map("permissions")
}

/// An access role within a tenant (Owner, Cashier, Accountant, …). Predefined
/// system roles are seeded per tenant (isSystem = true) and may be customised.
model Role {
  id          Int     @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String  @db.VarChar(80)
  slug        String  @db.VarChar(80)
  description String? @db.VarChar(250)
  isSystem    Boolean @default(false) // seeded predefined role
  isAllAccess Boolean @default(false) // owner/admin — implicitly all permissions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

/// Grant: a role has a permission.
model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// The full guided Company / Business Setup wizard (16-step Standard mode).
/// One per owner. Scalar fields are typed columns; the dynamic toggle/flag
/// groups, working days and contacts are JSON; repeatable rows are child tables.
/// A business entity (legal company) owned by a tenant. A tenant (the subscriber
/// account) can own ONE or MANY businesses — each is a separate GST/PAN entity
/// whose operational data is segregated by `businessId`. Exactly one row per
/// tenant is flagged `isDefault` (the business created at sign-up / business setup).
model Business {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(200)
  legalName String? @db.VarChar(200)
  gstNumber String? @db.VarChar(20)
  pan       String? @db.VarChar(15)
  logoUrl   String? @db.LongText
  isDefault Boolean @default(false)
  status    String  @default("active") @db.VarChar(20) // active | inactive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]

  @@index([tenantId])
  @@map("businesses")
}

/// A physical location / outlet of a business (head office, store, warehouse,
/// franchise). Branch-level operational data (sales, inventory, GRN, petty cash)
/// is segregated by `branchId`. Exactly one row per business is `isDefault`.
model Branch {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(150)
  code      String  @db.VarChar(30)
  type      String  @default("Retail Outlet") @db.VarChar(40) // legacy label — kept in sync with the entity type name for backward compatibility

  // --- Enterprise org hierarchy (v2.0) — self-referential, unlimited depth ---
  entityTypeId   Int? // → entity_types.id (Head Office / Warehouse / Retail Store …)
  parentBranchId Int? // self-reference; null = root node under the business
  hierarchyLevel Int     @default(1) // 1 = root; child = parent.level + 1
  hierarchyPath  String? @db.VarChar(500) // materialized path of ancestor ids incl. self, e.g. "1/2/10/25"
  displayOrder   Int     @default(1)
  allowChild     Boolean @default(true) // may this node have child branches?
  remarks        String? @db.VarChar(500)
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  defaultCostCenterId   Int? // → cost_centres.id (soft link)
  defaultProfitCenterId Int? // → profit_centres.id (soft link)

  manager   String? @db.VarChar(150)
  phone     String? @db.VarChar(30)
  email     String? @db.VarChar(150)
  gstin     String? @db.VarChar(20)
  address   String? @db.VarChar(300)
  city      String? @db.VarChar(100)
  state     String? @db.VarChar(100)
  pincode   String? @db.VarChar(12)

  // Operating hours
  openTime  String? @db.VarChar(10)
  closeTime String? @db.VarChar(10)

  // Bank account
  bankName    String? @db.VarChar(150)
  bankAccount String? @db.VarChar(40)
  bankIfsc    String? @db.VarChar(20)
  bankUpi     String? @db.VarChar(60)

  // Contact person (in addition to phone/email)
  contactPerson String? @db.VarChar(150)

  isDefault Boolean @default(false)
  status    String  @default("active") @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([businessId])
  @@index([parentBranchId])
  @@index([entityTypeId])
  @@map("branches")
}

/// Entity Type master — the category of an org node (Head Office, Regional
/// Office, Warehouse, Retail Store, Factory …). Data-driven so an admin can add
/// more types without code changes. `allowChild` is the default for branches of
/// this type. Module-wise enablement is intentionally handled later in role
/// management, so it is NOT stored here.
model EntityType {
  id          Int    @id @default(autoincrement())
  tenantId    Int
  code        String @db.VarChar(40)
  name        String @db.VarChar(80)
  description String? @db.VarChar(300)
  icon        String? @db.VarChar(40) // lucide icon name
  color       String? @db.VarChar(20) // hex / token for the tree badge
  allowChild  Boolean @default(true)
  displayOrder Int    @default(1)
  status      String  @default("active") @db.VarChar(20) // active | inactive
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("entity_types")
}

model CompanySetup {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   Int    @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId Int? // the business this setup created / configures

  mode        String    @default("standard") @db.VarChar(20)
  status      String    @default("draft") @db.VarChar(20) // draft | completed
  currentStep Int       @default(0)
  completedAt DateTime?

  // Step 1 — Company Information
  companyName  String? @db.VarChar(200)
  legalName    String? @db.VarChar(200)
  logoUrl      String? @db.LongText
  businessType String? @db.VarChar(100)
  industry     String? @db.VarChar(120)
  nature       String? @db.VarChar(250)
  established  String? @db.VarChar(20)
  companyEmail String? @db.VarChar(150)
  companyPhone String? @db.VarChar(30)
  website      String? @db.VarChar(150)
  gstNumber    String? @db.VarChar(20)
  pan          String? @db.VarChar(15)
  cin          String? @db.VarChar(30)
  udyam        String? @db.VarChar(40)
  fssai        String? @db.VarChar(20)
  drugLicense  String? @db.VarChar(40)
  addressLine  String? @db.VarChar(300)
  country      String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  city         String? @db.VarChar(100)
  pincode      String? @db.VarChar(12)

  // Step 2 — Business Profile
  employees String? @db.VarChar(20)
  turnover  String? @db.VarChar(40)
  ownership String? @db.VarChar(40)
  startTime String? @db.VarChar(10)
  endTime   String? @db.VarChar(10)
  workMon   Boolean @default(false)
  workTue   Boolean @default(false)
  workWed   Boolean @default(false)
  workThu   Boolean @default(false)
  workFri   Boolean @default(false)
  workSat   Boolean @default(false)
  workSun   Boolean @default(false)

  // Step 3 — Contacts
  primaryName          String? @db.VarChar(150)
  primaryMobile        String? @db.VarChar(30)
  primaryEmail         String? @db.VarChar(150)
  primaryDesignation   String? @db.VarChar(100)
  secondaryName        String? @db.VarChar(150)
  secondaryMobile      String? @db.VarChar(30)
  secondaryEmail       String? @db.VarChar(150)
  secondaryDesignation String? @db.VarChar(100)

  // Step 4/6 — Organization
  orgType             String? @db.VarChar(30)
  orgCentralInventory Boolean @default(false)
  orgCentralPricing   Boolean @default(false)

  // Step 7 — Financial
  fyStart          String? @db.VarChar(20)
  fyEnd            String? @db.VarChar(20)
  acctStart        String? @db.VarChar(20)
  currency         String? @db.VarChar(10)
  accountingMethod String? @db.VarChar(20)
  costCenter       String? @db.VarChar(120)
  profitCenter     String? @db.VarChar(120)

  // Step 9 — GST & Tax
  gstin        String? @db.VarChar(20)
  gstPan       String? @db.VarChar(15)
  gstStateCode String? @db.VarChar(5)
  gstEffective String? @db.VarChar(20)
  gstRegType   String? @db.VarChar(30)
  gstFrequency String? @db.VarChar(20)
  taxCgst      Boolean @default(false)
  taxSgst      Boolean @default(false)
  taxIgst      Boolean @default(false)
  gstEinvoice  Boolean @default(false)
  gstEway      Boolean @default(false)

  // Step 10 — Admin user (captured; password not persisted here)
  adminName     String? @db.VarChar(150)
  adminMobile   String? @db.VarChar(30)
  adminEmail    String? @db.VarChar(150)
  adminUsername String? @db.VarChar(60)

  // Operational single-select choices
  inventoryValuation String? @db.VarChar(20)
  paymentDefault     String? @db.VarChar(20)
  migrationSource    String? @db.VarChar(30)
  industrySelected   String? @db.VarChar(120)

  // Hardware Configuration (toggles)
  hwThermal   Boolean @default(false)
  hwBarcode   Boolean @default(false)
  hwQr        Boolean @default(false)
  hwDrawer    Boolean @default(false)
  hwDisplay   Boolean @default(false)
  hwScale     Boolean @default(false)
  hwBiometric Boolean @default(false)

  // Business Modules (toggles)
  modMasters    Boolean @default(false)
  modPurchase   Boolean @default(false)
  modInventory  Boolean @default(false)
  modSales      Boolean @default(false)
  modCrm        Boolean @default(false)
  modLoyalty    Boolean @default(false)
  modChit       Boolean @default(false)
  modAccounting Boolean @default(false)
  modGst        Boolean @default(false)
  modEinvoice   Boolean @default(false)
  modEway       Boolean @default(false)
  modHrms       Boolean @default(false)
  modReports    Boolean @default(false)
  modAi         Boolean @default(false)
  modPharmacy   Boolean @default(false)

  // Security Configuration (toggles)
  secOtp      Boolean @default(false)
  sec2fa      Boolean @default(false)
  secPwExpiry Boolean @default(false)
  secSession  Boolean @default(false)
  secAudit    Boolean @default(false)

  // Data Migration imports (toggles)
  impProducts  Boolean @default(false)
  impCustomers Boolean @default(false)
  impSuppliers Boolean @default(false)
  impStock     Boolean @default(false)
  impBalances  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses SetupWarehouse[]
  banks      SetupBank[]
  teamUsers  SetupUser[]

  @@index([tenantId])
  @@map("company_setups")
}

model SetupWarehouse {
  id       Int          @id @default(autoincrement())
  setupId  Int
  setup    CompanySetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  name     String?      @db.VarChar(150)
  code     String?      @db.VarChar(40)
  type     String?      @db.VarChar(40)
  address  String?      @db.VarChar(300)
  contact  String?      @db.VarChar(150)
  mobile   String?      @db.VarChar(30)
  capacity String?      @db.VarChar(60)
  branch   String?      @db.VarChar(150)

  @@index([setupId])
  @@map("setup_warehouses")
}

model SetupBank {
  id       Int          @id @default(autoincrement())
  setupId  Int
  setup    CompanySetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  // Bank scope: businessId is always set; branchId is set only for banks added
  // under a specific branch (Branch Setup). Company-level banks (Banking Setup)
  // leave branchId null.
  businessId Int?
  branchId   Int?
  bankName String?      @db.VarChar(150)
  branch   String?      @db.VarChar(150)
  account  String?      @db.VarChar(40)
  ifsc     String?      @db.VarChar(20)
  type     String?      @db.VarChar(30)
  upi      String?      @db.VarChar(100)
  openingBalance Decimal @default(0) @db.Decimal(18, 2)

  @@index([setupId])
  @@index([businessId])
  @@index([branchId])
  @@map("setup_banks")
}

model SetupUser {
  id       Int          @id @default(autoincrement())
  setupId  Int
  setup    CompanySetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  name     String?      @db.VarChar(150)
  mobile   String?      @db.VarChar(30)
  email    String?      @db.VarChar(150)
  username String?      @db.VarChar(60)
  role     String?      @db.VarChar(60)

  @@index([setupId])
  @@map("setup_users")
}

/// An authenticated login session — backs the httpOnly session cookie and lets
/// admins monitor / revoke active sessions per user.
model Session {
  id         String    @id @default(cuid())
  token      String    @unique @db.VarChar(128)
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

/// Audit / monitoring log — every login, failed attempt and logout is recorded
/// here (email kept even when the user is unknown, for security monitoring).
model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?  @db.VarChar(150)
  action    String   @db.VarChar(50) // login | logout | login_failed | register
  status    String   @db.VarChar(20) // success | failure
  reason    String?  @db.VarChar(200)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

/// Product Master — every field across the 16-tab editor stored in its own
/// column (no JSON). Variant attributes live in the child table below.
model Product {
  id Int @id @default(autoincrement())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // General
  code        String? @db.VarChar(60)
  name        String  @db.VarChar(250)
  shortName   String? @db.VarChar(120)
  altName     String? @db.VarChar(120)
  status      String  @default("Active") @db.VarChar(20)
  launchDate       String? @db.VarChar(20)
  discontinuedDate String? @db.VarChar(20)
  keywords    String? @db.Text
  description String? @db.Text

  // Classification
  industry     String? @db.VarChar(40) // vertical: Electronics | Pharmaceuticals | FMCG | …
  productType  String? @db.VarChar(40)
  category     String? @db.VarChar(120)
  subCategory  String? @db.VarChar(120)
  group        String? @db.VarChar(120)
  brand        String? @db.VarChar(120)
  manufacturer String? @db.VarChar(120)
  family       String? @db.VarChar(120)
  segment      String? @db.VarChar(120)

  // Packaging & UOM
  baseUom      String?  @db.VarChar(40)
  purchaseUom  String?  @db.VarChar(40)
  salesUom     String?  @db.VarChar(40)
  packageType  String?  @db.VarChar(40)
  unitsPerCase Int?
  weightUnit   String?  @db.VarChar(40)
  netWeight    Decimal? @db.Decimal(18, 3)
  grossWeight  Decimal? @db.Decimal(18, 3)
  height       Decimal? @db.Decimal(18, 3)
  width        Decimal? @db.Decimal(18, 3)
  length       Decimal? @db.Decimal(18, 3)
  volume       Decimal? @db.Decimal(18, 3)

  // Codes
  sku           String? @db.VarChar(60)
  gtin          String? @db.VarChar(60)
  upc           String? @db.VarChar(60)
  ean           String? @db.VarChar(60)
  isbn          String? @db.VarChar(60)
  mpn           String? @db.VarChar(60)
  internalCode  String? @db.VarChar(60)
  barcodeType   String? @db.VarChar(40)
  barcodePrefix String? @db.VarChar(40)
  barcodeLength Int?
  qrTemplate    String? @db.VarChar(40)

  // Tax
  taxPref String? @db.VarChar(30)
  gstRate String? @db.VarChar(20)
  hsn     String? @db.VarChar(20)
  sac     String? @db.VarChar(20)

  // Pricing
  stdPurchasePrice  Decimal? @db.Decimal(18, 3)
  lastPurchasePrice Decimal? @db.Decimal(18, 3)
  mrp               Decimal? @db.Decimal(18, 3)
  retailPrice       Decimal? @db.Decimal(18, 3)
  wholesalePrice    Decimal? @db.Decimal(18, 3)
  distributorPrice  Decimal? @db.Decimal(18, 3)
  dealerPrice       Decimal? @db.Decimal(18, 3)
  franchisePrice    Decimal? @db.Decimal(18, 3)
  onlinePrice       Decimal? @db.Decimal(18, 3)
  localPrice        Decimal? @db.Decimal(18, 3)
  interstatePrice   Decimal? @db.Decimal(18, 3)

  // Accounting
  salesRevenueAcct      String? @db.VarChar(120)
  salesInventoryAcct    String? @db.VarChar(120)
  purchaseExpenseAcct   String? @db.VarChar(120)
  purchaseInventoryAcct String? @db.VarChar(120)
  costCenter            String? @db.VarChar(120)
  profitCenter          String? @db.VarChar(120)
  salesDesc             String? @db.Text
  purchaseDesc          String? @db.Text

  // Stock
  openingQty   Decimal? @db.Decimal(18, 3)
  openingValue Decimal? @db.Decimal(18, 3)
  minStock     Decimal? @db.Decimal(18, 3)
  maxStock     Decimal? @db.Decimal(18, 3)
  reorderLevel Decimal? @db.Decimal(18, 3)
  safetyStock  Decimal? @db.Decimal(18, 3)
  leadTime     Int?

  // Expiry & shelf life
  shelfLifeType  String? @db.VarChar(20)
  shelfLifeValue Int?
  alertUnit      String? @db.VarChar(20)
  alertValue     Int?

  // Purchase
  preferredSupplier String? @db.VarChar(150)
  purchaseLeadTime  Int?

  // Inventory tracking toggles
  invStockMaintenance Boolean @default(false)
  invBatch            Boolean @default(false)
  invLot              Boolean @default(false)
  invSerial           Boolean @default(false)
  invMfg              Boolean @default(false)
  invExpiry           Boolean @default(false)
  invWarranty         Boolean @default(false)
  invTrace            Boolean @default(false)
  // Inventory valuation / batch issue order: fifo | fefo | notRequired.
  valuation        String? @db.VarChar(20)
  // When fifo/fefo: how an out-of-order batch pick at billing is handled.
  batchSalesPolicy String? @db.VarChar(20) // restrict | warn
  // Inventory controls
  ctrlNegative    Boolean @default(false)
  ctrlBackorder   Boolean @default(false)
  ctrlReservation Boolean @default(false)
  ctrlBlocking    Boolean @default(false)
  // Sales toggles
  salesAllowed       Boolean @default(false)
  salesReturnAllowed Boolean @default(false)
  bulkSales          Boolean @default(false)
  creditSales        Boolean @default(false)
  discountAllowed    Boolean @default(false)
  ageRestricted      Boolean @default(false)
  specialApproval    Boolean @default(false)
  // Pharmacy
  rxPrescription    Boolean @default(false)
  rxSchedule        Boolean @default(false)
  rxBatchMandatory  Boolean @default(false)
  rxExpiryMandatory Boolean @default(false)
  rxDrugLicense     Boolean @default(false)
  // Single flags
  autoBarcode        Boolean @default(false)
  qrRequired         Boolean @default(false)
  expiryApplicable   Boolean @default(false)
  purchaseAllowed    Boolean @default(false)
  maxDiscountEnabled Boolean @default(false)

  approvalStatus String   @default("draft") @db.VarChar(20)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  barcode String? @db.VarChar(80)

  // Variants-as-products: each Size/Colour is its own product record linked to
  // a parent "style" product. Standalone products have no parent or children.
  parentId Int?
  parent   Product?  @relation("ProductVariants", fields: [parentId], references: [id], onDelete: Cascade)
  children Product[] @relation("ProductVariants")

  attributes        ProductAttribute[]
  openingStockLines OpeningStockLine[]
  inventoryLedger   InventoryLedger[]
  inventoryBalances InventoryBalance[]
  inventoryLots     InventoryLot[]
  goodsReceiptLines GoodsReceiptLine[]
  saleLines         SaleLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([name])
  @@index([category])
  @@index([brand])
  @@index([status])
  @@index([parentId])
  businessId Int?
  branchId   Int?

  @@map("products")
}

/// Reusable lookup values for Product Master dropdowns. Category → Sub-category
/// → Group form a tree via `parentId` (sub-category's parent is its category,
/// group's parent is its sub-category). Brand & Manufacturer are flat (no parent).
model MasterValue {
  id        Int           @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String        @db.VarChar(40) // category | subCategory | group | brand | manufacturer
  value     String        @db.VarChar(150)
  parentId  Int?
  parent    MasterValue?  @relation("MasterTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MasterValue[] @relation("MasterTree")
  createdAt DateTime      @default(now())

  @@unique([tenantId, type, value, parentId])
  @@index([tenantId])
  @@index([type])
  @@index([parentId])
  businessId Int?
  branchId   Int?

  @@map("master_values")
}

/// Opening stock document — initialises inventory at go-live (branch / warehouse
/// wise). One document holds many lines; lines may repeat the same product for
/// different rates or batches. Saved as Draft, then Submitted to update stock.
model OpeningStock {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  docNo      String   @db.VarChar(40)
  asOnDate   String   @db.VarChar(20)
  warehouse  String?  @db.VarChar(120)
  status     String   @default("Draft") @db.VarChar(20) // Draft | Submitted
  notes      String?  @db.Text
  totalQty   Decimal  @default(0) @db.Decimal(18, 3)
  totalValue Decimal  @default(0) @db.Decimal(18, 2)
  lineCount  Int      @default(0)
  createdBy  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines OpeningStockLine[]

  @@unique([tenantId, docNo])
  @@index([tenantId])
  @@index([status])
  businessId Int?
  branchId   Int?

  // POS terminal / shift / session traceability (additive).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@map("opening_stock")
}

/// One opening-stock line: product / SKU + quantity + costing, plus optional
/// batch and purchase details. Several lines can reference the same product.
model OpeningStockLine {
  id             Int          @id @default(autoincrement())
  openingStockId Int
  document       OpeningStock @relation(fields: [openingStockId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Snapshots so reports survive later product edits.
  productName String  @db.VarChar(250)
  sku         String? @db.VarChar(60)
  uom         String? @db.VarChar(40)
  category    String? @db.VarChar(120)

  qty           Decimal  @db.Decimal(18, 3)
  mrp           Decimal? @db.Decimal(18, 2)
  purchasePrice Decimal? @db.Decimal(18, 2)
  value         Decimal  @default(0) @db.Decimal(18, 2)

  // Optional batch details.
  batchNo    String? @db.VarChar(80)
  mfgDate    String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)

  // Optional purchase details.
  supplier     String? @db.VarChar(150)
  purchaseRef  String? @db.VarChar(80)
  purchaseDate String? @db.VarChar(20)
  remarks      String? @db.VarChar(300)

  // QR labelling: one shared code for the whole line, or a unique code per piece.
  qrMode           String  @default("shared") @db.VarChar(10) // shared | unique
  // Pending (awaiting Generate) | Generated (QR-required product, posted via QR
  // generation) | Not Required (product.qrRequired=false — posted automatically
  // on submit, see autoPostNonQrLines in src/lib/inventory/openingStock.ts)
  qrStatus         String  @default("Pending") @db.VarChar(20)
  qrGeneratedCount Int     @default(0)
  printedQty       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([openingStockId])
  @@index([productId])
  @@map("opening_stock_lines")
}

/// Generated QR reference numbers. Source-agnostic so the same table serves
/// Opening Stock and GRN (and future docs): `sourceType` + `sourceId` point to
/// the originating line. In "shared" mode there is one row (printed N times); in
/// "unique" mode there is one row per piece.
model QrCodeMapping {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  code         String   @unique @db.VarChar(80)
  sourceType   String   @default("OPENING") @db.VarChar(12) // OPENING | GRN
  sourceId     Int // the originating line id
  productId    Int
  seq          Int      @default(1) // piece index within the line
  mode         String   @db.VarChar(10) // shared | unique
  printed      Boolean  @default(false)
  printedCount Int      @default(0)
  // Batch / mfg / expiry captured at receipt — so a scanned QR resolves its batch.
  batchNo      String?  @db.VarChar(80)
  mfgDate      String?  @db.VarChar(20)
  expiryDate   String?  @db.VarChar(20)
  warehouse    String?  @db.VarChar(120)
  grnId        Int?     // the GRN this piece was received on
  // Manufacturer serial / IMEI (user-entered for serial-managed products). The
  // generated `code` is the tracking QR; `serialNo` is the real serial.
  serialNo     String?  @db.VarChar(120)
  // Piece lifecycle. "Active" = Available (kept for backward compatibility with the
  // existing QR flows). Full set: Active | Sold | Returned | Quarantine |
  // Transferred | Damaged | Lost | Scrapped | ReturnedToSupplier.
  status       String   @default("Active") @db.VarChar(20)
  soldSaleId   Int?     // the sale that consumed this code
  soldInvoiceNo String? @db.VarChar(40)
  soldAt       DateTime?
  // Customer + warranty captured at sale (serial-managed products).
  customerId   Int?
  customerName String?  @db.VarChar(200)
  warrantyStart String? @db.VarChar(20)
  warrantyEnd   String? @db.VarChar(20)
  activatedAt   DateTime?
  notes         String? @db.VarChar(300)
  createdAt    DateTime @default(now())

  saleLinks   SaleLineQr[]
  returnLinks SalesReturnQr[]

  @@index([sourceType, sourceId])
  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, serialNo])
  businessId Int?
  branchId   Int?

  @@map("qr_code_mappings")
}

/// Configurable QR reference-number format + label appearance. Single-row
/// config edited from Settings → QR Code Settings. The number is composed from
/// a prefix, optional document & product code segments, and a running sequence.
model QrCodeSetting {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  // Number formation
  prefix             String  @default("QR") @db.VarChar(20)
  separator          String  @default("-") @db.VarChar(3)
  includeDocRef      Boolean @default(true)
  includeProductCode Boolean @default(true)
  includeSequence    Boolean @default(true)
  sequenceLength     Int     @default(4)
  nextSequence       Int     @default(1)

  // Appearance
  errorCorrection String  @default("M") @db.VarChar(1) // L | M | Q | H
  darkColor       String  @default("#0f172a") @db.VarChar(9)
  lightColor      String  @default("#ffffff") @db.VarChar(9)
  moduleStyle     String  @default("square") @db.VarChar(10) // square | dots | rounded

  // Label layout
  labelWidthMm  Int     @default(50)
  labelHeightMm Int     @default(30)
  showName      Boolean @default(true)
  showPrice     Boolean @default(true)
  showCodeText  Boolean @default(true)

  // Default generation mode for new lines
  defaultMode String @default("shared") @db.VarChar(10)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("qr_code_settings")
}

/// Inventory movement ledger — the single source of truth for every stock-
/// affecting activity (opening, purchase, inward/GRN, sales, sales return,
/// purchase return, adjustment, transfer, wastage…). Each row is one signed
/// movement, day-wise (`txnDate`), keyed by product and (optionally) QR code,
/// so a full kardex / day-wise log can be drawn per product or per QR label.
model InventoryLedger {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qrCode    String? @db.VarChar(80) // QR reference number this movement belongs to

  txnType   String @db.VarChar(20) // OPENING | PURCHASE | INWARD | SALES | SALES_RETURN | PURCHASE_RETURN | ADJUSTMENT | TRANSFER_IN | TRANSFER_OUT | WASTAGE
  direction String @db.VarChar(3) // IN | OUT

  qty          Decimal  @db.Decimal(18, 3)
  purchaseRate Decimal? @db.Decimal(18, 2) // purchase price (cost) for this movement
  sellingRate  Decimal? @db.Decimal(18, 2) // selling price for this movement
  purchaseValue Decimal? @db.Decimal(18, 2) // qty × purchaseRate
  sellingValue  Decimal? @db.Decimal(18, 2) // qty × sellingRate
  balanceQty   Decimal  @db.Decimal(18, 3) // running on-hand for the product+warehouse after this row

  warehouse  String? @db.VarChar(120)
  batchNo    String? @db.VarChar(80)
  mfgDate    String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)

  // Soft reference to the source document (no FK — the ledger is history).
  refType String? @db.VarChar(30) // OPENING | PURCHASE | SALES | …
  refId   Int?
  refNo   String? @db.VarChar(40) // e.g. OPN-00001 / GRN-0007
  grnId   Int? // direct GRN reference when the movement came from a Goods Receipt

  txnDate   String   @db.VarChar(20) // business date (YYYY-MM-DD) — drives the day-wise log
  remarks   String?  @db.VarChar(300)
  createdBy Int?
  createdAt DateTime @default(now())

  @@index([tenantId, productId])
  @@index([tenantId, txnDate])
  @@index([tenantId, qrCode])
  @@index([tenantId, txnType])
  @@index([refType, refId])
  @@index([grnId])
  businessId Int?
  branchId   Int?

  @@map("inventory_ledger")
}

/// Current on-hand stock per product + warehouse (denormalised from the ledger
/// for fast reads). Updated on every posted movement.
model InventoryBalance {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse String  @default("Main Store") @db.VarChar(120)

  qtyOnHand      Decimal   @default(0) @db.Decimal(18, 3)
  purchaseRate   Decimal?  @db.Decimal(18, 2) // purchase price (cost); purchaseValue = qtyOnHand × purchaseRate
  sellingRate    Decimal?  @db.Decimal(18, 2) // current selling price
  purchaseValue  Decimal   @default(0) @db.Decimal(18, 2) // qtyOnHand × purchaseRate
  sellingValue   Decimal   @default(0) @db.Decimal(18, 2) // qtyOnHand × sellingRate
  lastMovementAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, branchId, productId, warehouse])
  @@index([tenantId, productId])
  businessId Int?
  branchId   Int?

  @@map("inventory_balances")
}

/// Stock layer / lot — one per receipt (GRN line / opening line). Keeps stock
/// batch-, GRN- and purchase-date wise so age-wise stock and per-lot closing
/// balances can be reported. `qtyOnHand` is the remaining quantity of the lot.
model InventoryLot {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse String  @default("Main Store") @db.VarChar(120)

  batchNo      String? @db.VarChar(80)
  grnId        Int?
  refType      String? @db.VarChar(30) // OPENING | GRN
  refId        Int? // source line id
  refNo        String? @db.VarChar(40)
  receivedDate String? @db.VarChar(20) // date the stock came in (drives age-wise)
  purchaseDate String? @db.VarChar(20)
  mfgDate      String? @db.VarChar(20)
  expiryDate   String? @db.VarChar(20)

  receivedQty   Decimal  @db.Decimal(18, 3)
  qtyOnHand     Decimal  @db.Decimal(18, 3) // remaining (lot closing balance)
  purchaseRate  Decimal? @db.Decimal(18, 2) // purchase price (cost)
  sellingRate   Decimal? @db.Decimal(18, 2) // selling price for this lot
  purchaseValue Decimal  @default(0) @db.Decimal(18, 2) // qtyOnHand × purchaseRate
  sellingValue  Decimal  @default(0) @db.Decimal(18, 2) // qtyOnHand × sellingRate

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, productId])
  @@index([tenantId, receivedDate])
  @@index([grnId])
  businessId Int?
  branchId   Int?

  @@map("inventory_lots")
}

/// Goods Receipt Note — records stock physically received against a supplier /
/// purchase. Saving a posted GRN generates per-line QR codes and posts the
/// quantities into Inventory (ledger + balances + lots).
model GoodsReceiptNote {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  grnNo  String @db.VarChar(40)
  status String @default("Draft") @db.VarChar(20) // Draft | Posted

  grnDate            String  @db.VarChar(20)
  supplier           String? @db.VarChar(200)
  supplierGstin      String? @db.VarChar(20)
  supplierContact    String? @db.VarChar(120)
  supplierInvoiceNo  String? @db.VarChar(60)
  supplierInvoiceDate String? @db.VarChar(20)
  poNo               String? @db.VarChar(60)
  warehouse          String? @db.VarChar(120)
  notes              String? @db.Text

  // GST handling: per line item, or one rate for the whole invoice.
  gstMode String   @default("line") @db.VarChar(10) // line | invoice
  gstPct  Decimal? @db.Decimal(9, 2) // used when gstMode = invoice

  // Charges & invoice value
  subtotal          Decimal @default(0) @db.Decimal(18, 2)
  taxTotal          Decimal @default(0) @db.Decimal(18, 2)
  freightAmount     Decimal @default(0) @db.Decimal(18, 2)
  otherCharges      Decimal @default(0) @db.Decimal(18, 2)
  roundOff          Decimal @default(0) @db.Decimal(9, 2)
  totalInvoiceValue Decimal @default(0) @db.Decimal(18, 2) // supplier-stated invoice grand total

  // Payment / payable
  paymentStatus String   @default("Unpaid") @db.VarChar(12) // Paid | Unpaid | Partial
  amountPaid    Decimal  @default(0) @db.Decimal(18, 2)
  paymentMode   String?  @db.VarChar(20) // Cash | Bank | UPI | Cheque | Card | Credit
  paymentRef    String?  @db.VarChar(80)
  paymentDate   String?  @db.VarChar(20)
  paymentTerms  String?  @db.VarChar(120)
  creditDays    Int?
  dueDate       String?  @db.VarChar(20)

  // Transport / logistics (tracking + expense)
  transporterName  String?  @db.VarChar(150)
  transportMode    String?  @db.VarChar(20) // Road | Rail | Air | Courier | Hand
  vehicleNo        String?  @db.VarChar(40)
  lrNo             String?  @db.VarChar(60) // LR / docket no
  ewayBillNo       String?  @db.VarChar(40)
  freightPaidBy    String?  @db.VarChar(20) // Supplier | Us | ToPay
  numPackages      Int?
  transportRemarks String?  @db.VarChar(300)

  totalQty   Decimal @default(0) @db.Decimal(18, 3)
  totalValue Decimal @default(0) @db.Decimal(18, 2)
  lineCount  Int     @default(0)

  // Purchase Invoice / supplier-bill linkage (the PI module records the bill).
  purchaseInvoiceId Int?
  invoiceStatus     String  @default("Pending") @db.VarChar(20) // Pending | Invoice Recorded
  invoiceRecorded   Boolean @default(false)
  accountsPosted    Boolean @default(false) // invoice-side accounts posted

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines GoodsReceiptLine[]

  @@unique([tenantId, grnNo])
  @@index([tenantId, status])
  businessId Int?
  branchId   Int?

  // POS terminal / shift / session traceability (additive).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@map("goods_receipt_notes")
}

/// Supplier payable — created when a posted GRN (or purchase invoice) is unpaid
/// or part-paid. Surfaced in the Payables module; settling reduces the balance.
model Payable {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sourceType String  @db.VarChar(20) // GRN | PURCHASE_INVOICE
  sourceId   Int
  refNo      String? @db.VarChar(40)
  supplier   String? @db.VarChar(200)

  docDate       String?  @db.VarChar(20)
  dueDate       String?  @db.VarChar(20)
  paymentTerms  String?  @db.VarChar(120)
  totalAmount   Decimal  @db.Decimal(18, 2)
  paidAmount    Decimal  @default(0) @db.Decimal(18, 2)
  balanceAmount Decimal  @db.Decimal(18, 2)
  status        String   @default("Open") @db.VarChar(12) // Open | Partial | Paid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([sourceType, sourceId])
  businessId Int?
  branchId   Int?

  @@map("payables")
}

/// Purchase Invoice (supplier bill) recorded against one or more posted GRNs.
/// Inventory + GST were already booked at GRN; this records the supplier bill,
/// takes over the GRN's payable (no double-count), and posts only invoice-level
/// charge/discount/round-off deltas. Supplier Payment settles its payable.
model PurchaseInvoice {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  invoiceNo String @db.VarChar(40) // auto

  supplierInvoiceNo   String? @db.VarChar(80)
  supplierInvoiceDate String? @db.VarChar(20)
  supplierBillNo      String? @db.VarChar(80)
  supplierBillDate    String? @db.VarChar(20)
  dueDate             String? @db.VarChar(20)
  paymentTerms        String? @db.VarChar(120)
  creditDays          Int?
  currency            String  @default("INR") @db.VarChar(10)
  supplierRef         String? @db.VarChar(80)

  supplierId    Int?
  supplier      String? @db.VarChar(200)
  supplierGstin String? @db.VarChar(20)
  poNo          String? @db.VarChar(60)
  warehouse     String? @db.VarChar(120)

  invoiceType  String @default("GRN") @db.VarChar(10) // GRN | Direct
  grnRef       String? @db.VarChar(120) // free-text GRN/PI mapping for a direct bill
  purchaseType String @default("Inventory") @db.VarChar(20) // Inventory | Expense | Service | Asset

  // Bill amounts
  grnAmount         Decimal @default(0) @db.Decimal(18, 2)
  additionalDiscount Decimal @default(0) @db.Decimal(18, 2)
  freight           Decimal @default(0) @db.Decimal(18, 2)
  loading           Decimal @default(0) @db.Decimal(18, 2)
  packing           Decimal @default(0) @db.Decimal(18, 2)
  insurance         Decimal @default(0) @db.Decimal(18, 2)
  otherCharges      Decimal @default(0) @db.Decimal(18, 2)
  roundOff          Decimal @default(0) @db.Decimal(9, 2)
  taxableAmount     Decimal @default(0) @db.Decimal(18, 2)
  cgst              Decimal @default(0) @db.Decimal(18, 2)
  sgst              Decimal @default(0) @db.Decimal(18, 2)
  igst              Decimal @default(0) @db.Decimal(18, 2)
  cess              Decimal @default(0) @db.Decimal(18, 2)
  gstAmount         Decimal @default(0) @db.Decimal(18, 2)
  gstApplicable     Boolean @default(true)
  reverseCharge     Boolean @default(false)
  totalInvoiceAmount Decimal @default(0) @db.Decimal(18, 2)
  netPayable        Decimal @default(0) @db.Decimal(18, 2)

  status         String    @default("Draft") @db.VarChar(20) // Draft | Pending Approval | Approved | Posted | Cancelled
  accountsPosted Boolean   @default(false)
  journalRef     String?   @db.VarChar(40)
  payableId      Int?
  approvedBy     Int?
  approvedAt     DateTime?
  approvalNote   String?   @db.VarChar(300)

  remarks       String? @db.VarChar(500)
  internalNotes String? @db.VarChar(500)

  itemCount Int      @default(0)
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       PurchaseInvoiceItem[]
  attachments PurchaseInvoiceAttachment[]
  grnMap      PurchaseInvoiceGrnMap[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, status])
  @@index([tenantId, branchId, supplierInvoiceDate])
  @@index([tenantId, supplier])

  // POS terminal / shift / session traceability (additive).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@map("purchase_invoice")
}

/// A snapshot line of a purchase invoice, mirrored from the source GRN line(s).
model PurchaseInvoiceItem {
  id                Int             @id @default(autoincrement())
  purchaseInvoiceId Int
  invoice           PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  grnLineId   Int?
  productId   Int?    // null for a free-text (service / expense) line
  productName String  @db.VarChar(250) // doubles as the line description
  sku         String? @db.VarChar(60)
  hsn         String? @db.VarChar(20)

  batchNo    String? @db.VarChar(80)
  mfgDate    String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)

  qty        Decimal  @db.Decimal(18, 3)
  unitPrice  Decimal  @default(0) @db.Decimal(18, 2)
  taxPct     Decimal? @db.Decimal(9, 2)
  taxAmount  Decimal  @default(0) @db.Decimal(18, 2)
  discPct    Decimal? @db.Decimal(9, 2)
  discAmount Decimal  @default(0) @db.Decimal(18, 2)
  lineValue  Decimal  @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([purchaseInvoiceId])
  @@index([productId])
  @@map("purchase_invoice_items")
}

/// An uploaded supplier-bill document attached to a purchase invoice.
model PurchaseInvoiceAttachment {
  id                Int             @id @default(autoincrement())
  purchaseInvoiceId Int
  invoice           PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  docType  String  @default("invoice") @db.VarChar(20) // invoice | image | challan | supporting
  fileName String  @db.VarChar(200)
  fileUrl  String  @db.LongText
  fileType String? @db.VarChar(80)
  size     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([purchaseInvoiceId])
  @@map("purchase_invoice_attachments")
}

/// Mapping of a purchase invoice to the GRN(s) it bills (supports multi-GRN).
model PurchaseInvoiceGrnMap {
  id                Int             @id @default(autoincrement())
  purchaseInvoiceId Int
  invoice           PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  grnId     Int
  grnNo     String  @db.VarChar(40)
  grnAmount Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([purchaseInvoiceId, grnId])
  @@index([grnId])
  @@map("purchase_invoice_grn_mapping")
}

/// Purchase Return (unified — no separate Debit Note module). Always created by
/// selecting an existing Purchase Invoice; inherits purchaseType (read-only).
/// On approval it reduces inventory (Inventory type only), reverses the supplier
/// outstanding and posts the reversing accounting entry.
model PurchaseReturn {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  returnNo   String @db.VarChar(40) // auto
  returnDate String @db.VarChar(20)

  // Inherited from the source Purchase Invoice (read-only at the UI).
  purchaseInvoiceId Int
  invoiceNo         String? @db.VarChar(40)
  grnId             Int?
  grnNo             String? @db.VarChar(40)
  poNo              String? @db.VarChar(60)
  purchaseType      String  @default("Inventory") @db.VarChar(20) // Inventory | Service | Expense | Asset

  supplierId    Int?
  supplier      String? @db.VarChar(200)
  supplierGstin String? @db.VarChar(20)
  warehouse     String? @db.VarChar(120)

  reason  String? @db.VarChar(120) // header-level reason (per-line reasons also captured)
  remarks String? @db.VarChar(300)

  // Amounts (debit raised on the supplier).
  taxableAmount Decimal @default(0) @db.Decimal(18, 2)
  taxAmount     Decimal @default(0) @db.Decimal(18, 2)
  roundOff      Decimal @default(0) @db.Decimal(9, 2)
  returnAmount  Decimal @default(0) @db.Decimal(18, 2) // grand total incl tax

  status       String    @default("Draft") @db.VarChar(20) // Draft | Pending Approval | Approved | Cancelled
  approvedBy   Int?
  approvedAt   DateTime?
  approvalNote String?   @db.VarChar(300)

  // Posting status flags (spec).
  inventoryUpdated           Boolean @default(false)
  supplierOutstandingUpdated Boolean @default(false)
  accountingPosted           Boolean @default(false)
  journalRef                 String? @db.VarChar(40)

  itemCount Int      @default(0)
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       PurchaseReturnItem[]
  attachments PurchaseReturnAttachment[]

  // POS terminal / shift / session traceability (additive, multi-terminal).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@unique([tenantId, returnNo])
  @@index([tenantId, status])
  @@index([tenantId, returnDate])
  @@index([purchaseInvoiceId])
  @@index([grnId])
  @@map("purchase_returns")
}

/// A returned line on a Purchase Return (snapshot of the source PI / GRN line).
model PurchaseReturnItem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  piItemId    Int? // source PurchaseInvoiceItem (snapshot link; no FK)
  grnLineId   Int?
  productId   Int?
  productName String  @db.VarChar(250) // doubles as the line / service / expense description
  sku         String? @db.VarChar(60)
  hsn         String? @db.VarChar(20)

  batchNo    String? @db.VarChar(80)
  mfgDate    String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)
  assetId    Int? // FixedAsset returned (Asset purchase type)

  invoicedQty Decimal @default(0) @db.Decimal(18, 3) // qty originally billed
  returnedQty Decimal @default(0) @db.Decimal(18, 3) // already-returned before this doc (snapshot)
  returnQty   Decimal @db.Decimal(18, 3)
  rate        Decimal @db.Decimal(18, 2) // unit cost
  taxPct      Decimal? @db.Decimal(9, 2)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)
  discAmount  Decimal @default(0) @db.Decimal(18, 2)
  returnValue Decimal @default(0) @db.Decimal(18, 2) // refund/debit value incl tax

  reason  String? @db.VarChar(120)
  remarks String? @db.VarChar(300)
  // vendor | damaged | scrap — destination treatment (purchase returns default "vendor").
  inventoryHandling String @default("vendor") @db.VarChar(20)

  createdAt DateTime @default(now())

  qrs PurchaseReturnQr[]

  @@index([purchaseReturnId])
  @@index([productId])
  @@map("purchase_return_items")
}

/// Serial / unique-QR pieces returned on a Purchase Return line (→ ReturnedToSupplier).
model PurchaseReturnQr {
  id                   Int                @id @default(autoincrement())
  tenantId             Int
  purchaseReturnItemId Int
  item                 PurchaseReturnItem @relation(fields: [purchaseReturnItemId], references: [id], onDelete: Cascade)
  qrCodeMappingId      Int
  code                 String             @db.VarChar(80)
  serialNo             String?            @db.VarChar(120)
  mode                 String             @db.VarChar(10)
  createdAt            DateTime           @default(now())

  @@index([tenantId, code])
  @@index([purchaseReturnItemId])
  @@map("purchase_return_qrs")
}

/// A supporting document attached to a Purchase Return.
model PurchaseReturnAttachment {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  docType  String  @default("supporting") @db.VarChar(20)
  fileName String  @db.VarChar(200)
  fileUrl  String  @db.LongText
  fileType String? @db.VarChar(80)
  size     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([purchaseReturnId])
  @@map("purchase_return_attachments")
}

/// Asset Register — created when a Purchase Invoice of type "Asset" is posted.
/// A purchase return of an asset marks the matching row Returned.
model FixedAsset {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  assetNo   String  @db.VarChar(40) // auto
  name      String  @db.VarChar(250)
  category  String? @db.VarChar(120)

  purchaseInvoiceId Int?
  purchaseInvoiceNo String? @db.VarChar(40)
  supplierId        Int?
  supplier          String? @db.VarChar(200)
  purchaseDate      String? @db.VarChar(20)

  qty        Decimal @default(1) @db.Decimal(18, 3)
  unitValue  Decimal @default(0) @db.Decimal(18, 2)
  totalValue Decimal @default(0) @db.Decimal(18, 2)

  location String? @db.VarChar(120)
  serialNo String? @db.VarChar(120)

  status     String    @default("Active") @db.VarChar(20) // Active | Returned | Disposed
  returnedAt DateTime?
  returnRef  String?   @db.VarChar(40)

  notes     String?  @db.VarChar(300)
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, assetNo])
  @@index([tenantId, status])
  @@index([purchaseInvoiceId])
  @@map("fixed_assets")
}

/// A payment made to a supplier, settling one or more payables in a single
/// transaction. Posts a PAYMENT voucher (Dr Accounts Payable, Cr Cash/Bank).
model SupplierPayment {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  paymentNo   String  @db.VarChar(40)
  supplier    String? @db.VarChar(200)
  paymentDate String  @db.VarChar(20)
  mode        String  @db.VarChar(40) // Cash | Bank Transfer | UPI | Cheque | Card
  reference   String? @db.VarChar(80)
  bankId      Int?
  bankName    String? @db.VarChar(150)
  bankAccount String? @db.VarChar(60)
  totalAmount Decimal @db.Decimal(18, 2)
  notes       String? @db.Text
  status      String  @default("Completed") @db.VarChar(20)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations SupplierPaymentAllocation[]

  @@unique([tenantId, paymentNo])
  @@index([tenantId, paymentDate])
  businessId Int?
  branchId   Int?

  // POS terminal / shift / session traceability (additive).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@map("supplier_payments")
}

/// One payment-to-payable allocation line (which bill, how much).
model SupplierPaymentAllocation {
  id        Int             @id @default(autoincrement())
  tenantId  Int
  paymentId Int
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  payableId  Int
  refNo      String? @db.VarChar(40)
  sourceType String? @db.VarChar(20)
  sourceId   Int?
  amount     Decimal @db.Decimal(18, 2)

  @@index([paymentId])
  @@index([tenantId, payableId])
  businessId Int?
  branchId   Int?

  @@map("supplier_payment_allocations")
}

/// A collection received from a customer, settling one or more credit invoices in
/// a single receipt. Posts a RECEIPT voucher (Dr Cash/Bank, Cr Accounts Receivable).
model CustomerCollection {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  collectionNo   String  @db.VarChar(40)
  customerId     Int?
  customerName   String? @db.VarChar(200)
  collectionDate String  @db.VarChar(20)
  mode           String  @db.VarChar(40) // Cash | Bank Transfer | UPI | Cheque | Card
  reference      String? @db.VarChar(80)
  bankId         Int?
  bankName       String? @db.VarChar(150)
  bankAccount    String? @db.VarChar(60)
  totalAmount    Decimal @db.Decimal(18, 2)
  notes          String? @db.Text
  attachments    Json? // [{ fileName, fileUrl, fileType, size }]
  payments       Json? // [{ mode, amount, reference }] — split tender breakdown
  status         String  @default("Completed") @db.VarChar(20)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations CustomerCollectionAllocation[]

  @@unique([tenantId, collectionNo])
  @@index([tenantId, collectionDate])
  businessId Int?
  branchId   Int?

  // POS terminal / shift / session traceability (additive).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@map("customer_collections")
}

/// One collection-to-invoice allocation line (which sale, how much).
model CustomerCollectionAllocation {
  id           Int                @id @default(autoincrement())
  tenantId     Int
  collectionId Int
  collection   CustomerCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  saleId    Int
  invoiceNo String? @db.VarChar(40)
  amount    Decimal @db.Decimal(18, 2)

  @@index([collectionId])
  @@index([tenantId, saleId])
  businessId Int?
  branchId   Int?

  @@map("customer_collection_allocations")
}

/// Chart of Accounts — one ledger account (per tenant). System accounts are
/// auto-seeded so purchase & sales vouchers always have somewhere to post.
model LedgerAccount {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code          String  @db.VarChar(20)
  name          String  @db.VarChar(120)
  type          String  @db.VarChar(20) // Asset | Liability | Income | Expense | Equity
  group         String? @db.VarChar(60) // e.g. Current Asset, Duties & Taxes
  normalBalance String  @db.VarChar(6) // Debit | Credit
  isSystem      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  businessId Int?
  branchId   Int?

  @@map("ledger_accounts")
}

/// Double-entry voucher header. Every posted purchase / sale writes one balanced
/// entry (totalDebit == totalCredit). Kept as immutable history; corrections are
/// posted as reversing entries.
model JournalEntry {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  voucherNo   String  @db.VarChar(40)
  voucherType String  @db.VarChar(20) // PURCHASE | SALES | PAYMENT | RECEIPT | JOURNAL
  date        String  @db.VarChar(20) // YYYY-MM-DD
  narration   String? @db.VarChar(300)

  sourceType String? @db.VarChar(20) // GRN | SALES
  sourceId   Int?
  refNo      String? @db.VarChar(40) // GRN-00007 / INV-...

  totalDebit  Decimal @default(0) @db.Decimal(18, 2)
  totalCredit Decimal @default(0) @db.Decimal(18, 2)
  status      String  @default("Posted") @db.VarChar(12) // Posted | Reversed

  // Financial dimensions (in addition to businessId/branchId) for dimensional reporting.
  costCenterId   Int?
  profitCenterId Int?
  department     String? @db.VarChar(120)
  project        String? @db.VarChar(120)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[]

  @@unique([tenantId, voucherNo])
  @@index([tenantId, voucherType])
  @@index([tenantId, date])
  @@index([sourceType, sourceId])
  businessId Int?
  branchId   Int?

  // POS terminal / shift / session traceability (additive).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@map("journal_entries")
}

/// One debit or credit line of a journal entry (exactly one of debit/credit > 0).
model JournalLine {
  id        Int  @id @default(autoincrement())
  tenantId  Int // denormalised for fast per-account ledger queries
  journalId Int
  journal   JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId Int
  account   LedgerAccount @relation(fields: [accountId], references: [id])

  debit     Decimal @default(0) @db.Decimal(18, 2)
  credit    Decimal @default(0) @db.Decimal(18, 2)
  narration String? @db.VarChar(300)

  @@index([tenantId, accountId])
  @@index([journalId])
  businessId Int?
  branchId   Int?

  @@map("journal_lines")
}

/// One GRN line: product received with qty, rate, tax, batch & expiry, plus its
/// QR generation status (mirrors the opening-stock line so the same QR/print and
/// inventory flow is reused).
model GoodsReceiptLine {
  id    Int              @id @default(autoincrement())
  grnId Int
  grn   GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productName String  @db.VarChar(250)
  sku         String? @db.VarChar(60)
  uom         String? @db.VarChar(40)
  category    String? @db.VarChar(120)

  qty          Decimal  @db.Decimal(18, 3)
  freeQty      Decimal? @db.Decimal(18, 3)
  rate         Decimal? @db.Decimal(18, 2) // purchase price (cost) — drives valuation
  sellingPrice Decimal? @db.Decimal(18, 2) // selling unit rate
  discPct      Decimal? @db.Decimal(9, 2)
  taxPct    Decimal? @db.Decimal(9, 2)
  taxAmount Decimal? @db.Decimal(18, 2)
  value     Decimal  @default(0) @db.Decimal(18, 2)
  mrp       Decimal? @db.Decimal(18, 2)

  batchNo    String? @db.VarChar(80)
  mfgDate    String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)
  remarks    String? @db.VarChar(300)

  qrMode           String @default("shared") @db.VarChar(10)
  qrStatus         String @default("Pending") @db.VarChar(20)
  qrGeneratedCount Int    @default(0)
  printedQty       Int    @default(0)

  createdAt DateTime @default(now())

  @@index([grnId])
  @@index([productId])
  @@map("goods_receipt_lines")
}

/// Supplier master — vendors a tenant buys from. Used by GRN (and future
/// purchase docs) via a dropdown.
model Supplier {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String  @db.VarChar(200)
  gstin         String? @db.VarChar(20)
  contactPerson String? @db.VarChar(120)
  phone         String? @db.VarChar(30)
  email         String? @db.VarChar(150)
  address       String? @db.VarChar(300)
  city          String? @db.VarChar(80)
  state         String? @db.VarChar(80)
  pincode       String? @db.VarChar(12)
  paymentTerms  String? @db.VarChar(60)
  category      String  @default("Supplier") @db.VarChar(30) // Supplier | Expense Party | Vendor | Employee
  status        String  @default("Active") @db.VarChar(20)

  // Supplier Master fields.
  code         String? @db.VarChar(40)
  legalName    String? @db.VarChar(200)
  type         String? @db.VarChar(40)  // Manufacturer / Distributor / …
  website      String? @db.VarChar(200)
  description  String? @db.VarChar(500)
  contact1Designation String? @db.VarChar(80)
  altMobile           String? @db.VarChar(30)
  contact2Name        String? @db.VarChar(120)
  contact2Designation String? @db.VarChar(80)
  contact2Mobile      String? @db.VarChar(30)
  contact2Email       String? @db.VarChar(150)
  pan          String? @db.VarChar(20)
  tan          String? @db.VarChar(20)
  stateCode    String? @db.VarChar(10)
  placeOfSupply String? @db.VarChar(80)
  tdsPct       Decimal @default(0) @db.Decimal(9, 2)
  bankName      String? @db.VarChar(120)
  bankBranch    String? @db.VarChar(120)
  accountHolder String? @db.VarChar(200)
  accountNumber String? @db.VarChar(40)
  ifsc          String? @db.VarChar(20)
  accountType   String? @db.VarChar(20)
  upi           String? @db.VarChar(80)
  creditAllowed  Boolean @default(false)
  creditLimit    Decimal @default(0) @db.Decimal(18, 2)
  creditPeriod   Int     @default(0)
  ledgerAccount   String? @db.VarChar(120)
  advanceAccount  String? @db.VarChar(120)
  purchaseAccount String? @db.VarChar(120)
  openingPayable  Decimal @default(0) @db.Decimal(18, 2)
  openingAdvance  Decimal @default(0) @db.Decimal(18, 2)
  preferred      Boolean @default(false)
  approvalStatus String  @default("draft") @db.VarChar(20)
  notes          String? @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses SupplierAddress[]

  @@index([tenantId])
  @@index([tenantId, category])
  businessId Int?
  branchId   Int?

  @@map("suppliers")
}

/// Additional addresses for a supplier (registered / communication / other).
/// The registered address is also mirrored onto the Supplier row.
model SupplierAddress {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  label    String  @default("Other") @db.VarChar(20) // Registered | Communication | Other
  line1    String? @db.VarChar(200)
  line2    String? @db.VarChar(200)
  city     String? @db.VarChar(80)
  district String? @db.VarChar(80)
  state    String? @db.VarChar(80)
  country  String? @db.VarChar(80)
  pincode  String? @db.VarChar(12)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_addresses")
}

/// Expense category / head tree (self-referencing). parentId null = category,
/// otherwise a head under that category. Used by the petty-cash / expense module.
model ExpenseHead {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String  @db.VarChar(120)
  parentId  Int?
  parent    ExpenseHead?  @relation("ExpenseTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ExpenseHead[] @relation("ExpenseTree")
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  accountId Int?    // GL account this expense head posts to (Chart of Accounts). Null → falls back to Indirect Expenses.
  trackBudget Boolean @default(false) // "Track Expense Against Budget" — auto-loads this head into Budget Planning.

  createdAt DateTime @default(now())

  @@index([tenantId])
  businessId Int?
  branchId   Int?

  @@map("expense_heads")
}

/// Petty-cash / expense module configuration (one per tenant).
/// An accounting period (month / quarter / half-year / year) within a financial
/// year. Status drives the lock workflow: Open → Soft-Closed → Locked →
/// Audit-Locked. Locked / Audit-Locked periods reject new or backdated entries.
model FinancialPeriod {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String @db.VarChar(60) // e.g. "Jun 2026", "Q4 FY25-26"
  fy       String @db.VarChar(20) // e.g. "FY 26-27"
  type     String @default("Monthly") @db.VarChar(20) // Monthly | Quarterly | Half-Yearly | Yearly
  fromDate String @db.VarChar(20) // ISO yyyy-mm-dd
  toDate   String @db.VarChar(20)
  status   String @default("Open") @db.VarChar(20) // Open | Soft-Closed | Locked | Audit-Locked

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, fromDate])
  businessId Int?
  branchId   Int?

  @@map("financial_periods")
}

model PettyCashConfig {
  id       Int    @id @default(autoincrement())
  tenantId Int    @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  budgetEnabled    Boolean @default(false)
  budgetScope      String  @default("all") // all | head
  partySource      String  @default("both") // supplier | expense | both
  gstEnabled       Boolean @default(false) // GST-based expense applicable

  // Voucher number series
  voucherPrefix         String  @default("PCV") @db.VarChar(20)
  voucherPadding        Int     @default(4)
  voucherSeparator      String  @default("-") @db.VarChar(3)
  voucherIncludeYear    Boolean @default(false)
  voucherIncludeMonth   Boolean @default(false)
  voucherYearFormat     String  @default("fy_short") @db.VarChar(20) // fy_short | fy_full | cal_full | cal_short
  voucherResetFrequency String  @default("never") @db.VarChar(20) // never | monthly | financial_year
  voucherSeq            Int     @default(0)
  voucherSeqPeriod      String? @db.VarChar(20) // period key the seq belongs to (for reset)

  updatedAt DateTime @updatedAt

  @@map("petty_cash_config")
}

/// Budget amount per expense head (and optional period).
model ExpenseBudget {
  id       Int    @id @default(autoincrement())
  tenantId Int
  headId   Int
  period   String @default("ALL") @db.VarChar(20)
  amount   Decimal @default(0) @db.Decimal(18, 2)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, headId, period])
  @@index([tenantId])
  businessId Int?
  branchId   Int?

  @@map("expense_budgets")
}

/// Expense Budget Planning — one plan per (business, branch/company, financial year).
/// A budget is a control/planning figure; it never posts to the General Ledger.
/// Utilisation is derived by reading the expense sub-ledger (PettyCashLine, by head)
/// for Actual and open Payables for Committed. Status: Draft → Approved → Active → Closed.
model BudgetHeader {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?   // null = Company scope (all branches); set = Branch scope
  fy         String @db.VarChar(20) // e.g. "FY 26-27"
  scope      String @default("company") @db.VarChar(12) // company | branch
  period     String @default("quarterly") @db.VarChar(12) // yearly | halfyearly | quarterly | monthly — allocation + tracking granularity
  status     String @default("Draft") @db.VarChar(12)   // Draft | Approved | Active | Closed
  remarks    String? @db.Text

  createdBy  Int?
  approvedBy Int?
  approvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines     BudgetLine[]
  revisions BudgetRevision[]
  transfers BudgetTransfer[]

  @@index([tenantId, fy])
  @@index([tenantId, businessId, branchId])
  @@map("budget_headers")
}

/// Cost Centre master (System → Organization Configuration). A financial dimension
/// that tracks/allocates expenses; supports unlimited hierarchy via parentId.
model CostCentre {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  code        String  @db.VarChar(30)
  name        String  @db.VarChar(160)
  shortName   String? @db.VarChar(60)
  description String? @db.Text
  department  String? @db.VarChar(120)

  parentId      Int?
  parent        CostCentre?  @relation("CostTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      CostCentre[] @relation("CostTree")
  allowChildren Boolean @default(true)

  manager          String? @db.VarChar(160)
  budgetApplicable Boolean @default(false)
  status           String  @default("Active") @db.VarChar(10) // Active | Inactive

  effectiveFrom String? @db.VarChar(20)
  effectiveTo   String? @db.VarChar(20)
  remarks       String? @db.Text

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([parentId])
  @@map("cost_centres")
}

/// Profit Centre master — measures revenue, expenses and profitability; hierarchy via parentId.
model ProfitCentre {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  code         String  @db.VarChar(30)
  name         String  @db.VarChar(160)
  description  String? @db.Text
  businessUnit String? @db.VarChar(120)
  division     String? @db.VarChar(120)

  parentId Int?
  parent   ProfitCentre?  @relation("ProfitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProfitCentre[] @relation("ProfitTree")

  manager       String? @db.VarChar(160)
  status        String  @default("Active") @db.VarChar(10)
  effectiveDate String? @db.VarChar(20)
  remarks       String? @db.Text

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([parentId])
  @@map("profit_centres")
}

/// Statutory Government Payment — a payment of an accrued statutory liability (GST /
/// TDS / TCS and future PF / ESI / PT / LWF) to the government. Challan details are
/// stored inline; the payment posts Dr <liability> (+ Dr Interest/Penalty) / Cr Bank.
model StatutoryPayment {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  paymentNo     String @db.VarChar(40)
  paymentDate   String @db.VarChar(20) // YYYY-MM-DD
  statutoryType String @db.VarChar(12) // GST | TDS | TCS | PF | ESI | PT | LWF
  financialYear String @db.VarChar(10) // e.g. 2026-27
  taxPeriod     String @db.VarChar(7)  // YYYY-MM

  // Liability snapshot (captured at creation from the GL/source txns).
  liabilityAmount Decimal @default(0) @db.Decimal(18, 2)
  alreadyPaid     Decimal @default(0) @db.Decimal(18, 2)
  balanceAmount   Decimal @default(0) @db.Decimal(18, 2) // liability - alreadyPaid, at creation
  interest        Decimal @default(0) @db.Decimal(18, 2)
  penalty         Decimal @default(0) @db.Decimal(18, 2)
  paidAmount      Decimal @default(0) @db.Decimal(18, 2) // this payment (tax portion)
  totalPayable    Decimal @default(0) @db.Decimal(18, 2) // paidAmount + interest + penalty
  breakupJson     String? @db.Text // {cgst,sgst,igst,cess} or [{section/vendor/customer, amount}]

  // Payment information.
  paymentMode   String? @db.VarChar(20) // Cash | Bank | Cheque | NEFT | RTGS | UPI
  bankAccount   String? @db.VarChar(120)
  referenceNo   String? @db.VarChar(60)
  transactionNo String? @db.VarChar(60)
  remarks       String? @db.VarChar(500)

  // Challan information (inline — surfaced by the Challan Management tab).
  challanNo     String? @db.VarChar(60)
  cpin          String? @db.VarChar(40)
  cin           String? @db.VarChar(40)
  bsrCode       String? @db.VarChar(20)
  challanBank   String? @db.VarChar(120)
  govRef        String? @db.VarChar(60)
  ackNo         String? @db.VarChar(60)
  challanStatus String  @default("Pending") @db.VarChar(12) // Pending | Verified
  challanVerifiedBy   Int?
  challanVerifiedAt   DateTime?

  attachmentsJson String? @db.Text // [{ fileName, fileUrl, fileType, size }]
  journalId       Int? // posted PAYMENT voucher (set when Paid)

  status String @default("Draft") @db.VarChar(12) // Draft | Submitted | Approved | Paid | Cancelled

  // Approval + audit trail.
  createdBy      Int?
  submittedBy    Int?
  submittedAt    DateTime?
  approvedBy     Int?
  approvedByName String?   @db.VarChar(200)
  approvedAt     DateTime?
  cancelledBy    Int?
  cancelledAt    DateTime?
  cancelReason   String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, paymentNo])
  @@index([tenantId, statutoryType, taxPeriod])
  @@index([tenantId, status])
  @@map("statutory_payments")
}

/// Statutory Return filing tracker — a lightweight acknowledgement log for GSTR-1/3B/9,
/// 24Q/26Q/27Q, TCS returns (and future PF/ESI/PT/LWF returns). Detailed GST return
/// preparation still lives in the GST Compliance module (GstReturn); this only tracks
/// the filing status + acknowledgement per statutory type & period.
model StatutoryReturn {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  statutoryType String @db.VarChar(12) // GST | TDS | TCS | PF | ESI | PT | LWF
  returnType    String @db.VarChar(20) // GSTR-1 | GSTR-3B | GSTR-9 | 24Q | 26Q | 27Q | TCS | ...
  financialYear String @db.VarChar(10)
  taxPeriod     String @db.VarChar(7)  // YYYY-MM

  liabilityAmount Decimal @default(0) @db.Decimal(18, 2)
  status          String  @default("Pending") @db.VarChar(12) // Pending | Prepared | Filed
  filedDate       String? @db.VarChar(20)
  ackNo           String? @db.VarChar(60)
  remarks         String? @db.VarChar(500)
  attachmentsJson String? @db.Text

  createdBy Int?
  filedBy   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, statutoryType, taxPeriod])
  @@index([tenantId, status])
  @@map("statutory_returns")
}

/// AI Finance Intelligence — per-item feedback (dismiss / review / ignore / resolve /
/// assign) for the generated insights & alerts, keyed by a stable item key so the
/// panel remembers the user's disposition across refreshes (insights are recomputed
/// live each load, so nothing else persists).
model AiFinanceFeedback {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  itemType   String @db.VarChar(12)  // insight | alert
  itemKey    String @db.VarChar(160) // stable: type:subject:period
  status     String @db.VarChar(16)  // dismissed | reviewed | ignored | resolved
  assignedTo String? @db.VarChar(120)
  note       String? @db.VarChar(300)
  createdBy  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, itemType, itemKey])
  @@index([tenantId, status])
  @@map("ai_finance_feedback")
}

// ===========================================================================
// AI COPILOT FOUNDATION (Phase 1) — a self-contained in-app AI engine. All AI
// state lives in these ai_copilot_* tables; ERP modules only register metadata
// in ai_module_registry and never talk to Claude directly (Claude Client is the
// sole gateway). tenantId null on a config row = a global/platform default.
// ===========================================================================

/// A chat thread between a user and the AI copilot.
model AiConversation {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  userId     Int
  title      String  @db.VarChar(200)
  category   String? @db.VarChar(40) // Finance | Sales | … | General
  pinned     Boolean @default(false)
  messageCount Int   @default(0)
  lastMessageAt DateTime?
  createdBy  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages AiMessage[]

  @@index([tenantId, userId])
  @@index([tenantId, pinned])
  @@map("ai_conversation")
}

/// One turn (user question or assistant answer) within a conversation.
model AiMessage {
  id             Int    @id @default(autoincrement())
  tenantId       Int
  conversationId Int
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String @db.VarChar(12) // user | assistant | system
  content        String @db.LongText
  model          String? @db.VarChar(60)
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  status         String? @db.VarChar(16) // success | error | fallback
  contextJson    String? @db.Text // resolved semantic/module context snapshot
  createdBy      Int?
  createdAt      DateTime @default(now())

  feedback AiFeedback[]

  @@index([tenantId, conversationId])
  @@map("ai_messages")
}

/// Prompt categories (Finance/Sales/…); tenantId null = global.
model AiPromptCategory {
  id        Int    @id @default(autoincrement())
  tenantId  Int?
  key       String @db.VarChar(40)
  name      String @db.VarChar(80)
  icon      String? @db.VarChar(40)
  sortOrder Int    @default(0)
  createdAt DateTime @default(now())

  @@unique([tenantId, key])
  @@map("ai_prompt_category")
}

/// Ready-made + user-created prompts. tenantId null = system/global prompt.
model AiPromptLibrary {
  id          Int    @id @default(autoincrement())
  tenantId    Int?
  category    String @db.VarChar(40)
  title       String @db.VarChar(200)
  promptText  String @db.Text
  description String? @db.VarChar(300)
  isSystem    Boolean @default(false)
  shared      Boolean @default(false)
  usageCount  Int    @default(0)
  createdBy   Int?
  createdByName String? @db.VarChar(120)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, category])
  @@map("ai_prompt_library")
}

/// ERP module metadata registry — a module becomes AI-enabled by registering here.
model AiModuleRegistry {
  id            Int    @id @default(autoincrement())
  tenantId      Int?
  moduleKey     String @db.VarChar(60)
  name          String @db.VarChar(120)
  description   String? @db.VarChar(400)
  menu          String? @db.VarChar(120)
  businessTerms String? @db.Text // JSON string[]
  kpis          String? @db.Text // JSON string[]
  questions     String? @db.Text // JSON string[]
  actions       String? @db.Text // JSON string[]
  permissions   String? @db.Text // JSON string[]
  tables        String? @db.Text // JSON string[]
  relationships String? @db.Text // JSON string[]
  enabled       Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, moduleKey])
  @@index([tenantId, enabled])
  @@map("ai_module_registry")
}

/// Business-term → ERP-entity mapping (never exposes DB tables to the model).
model AiSemanticDictionary {
  id         Int    @id @default(autoincrement())
  tenantId   Int?
  term       String @db.VarChar(120)
  normalized String @db.VarChar(120) // lowercased key for matching
  moduleKey  String? @db.VarChar(60)
  entity     String @db.VarChar(120) // business entity / KPI id
  kpi        String? @db.VarChar(120)
  definition String? @db.VarChar(400)
  synonyms   String? @db.Text // JSON string[]
  createdAt  DateTime @default(now())

  @@index([tenantId, normalized])
  @@map("ai_semantic_dictionary")
}

/// A user's favourite prompts.
model AiUserFavourite {
  id        Int    @id @default(autoincrement())
  tenantId  Int
  userId    Int
  promptId  Int
  createdAt DateTime @default(now())

  @@unique([userId, promptId])
  @@index([tenantId, userId])
  @@map("ai_user_favourites")
}

/// Thumbs / rating feedback on an assistant answer.
model AiFeedback {
  id        Int    @id @default(autoincrement())
  tenantId  Int
  messageId Int
  message   AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  rating    String @db.VarChar(10) // up | down
  comment   String? @db.VarChar(400)
  createdAt DateTime @default(now())

  @@index([tenantId, messageId])
  @@map("ai_feedback")
}

/// Every Claude Client call — the single source of truth for AI health & usage.
model AiApiLog {
  id               Int    @id @default(autoincrement())
  tenantId         Int?
  userId           Int?
  model            String @db.VarChar(60)
  operation        String @db.VarChar(16) // chat | stream | ping
  promptTokens     Int    @default(0)
  completionTokens Int    @default(0)
  totalTokens      Int    @default(0)
  latencyMs        Int    @default(0)
  retries          Int    @default(0)
  status           String @db.VarChar(16) // success | error | fallback
  errorMessage     String? @db.VarChar(400)
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("ai_api_logs")
}

/// AI configuration — global (tenantId null) + optional per-tenant override.
model AiSettings {
  id             Int    @id @default(autoincrement())
  tenantId       Int?   @unique
  enabled        Boolean @default(true)
  provider       String  @default("claude") @db.VarChar(20)
  model          String  @default("claude-sonnet-4-6") @db.VarChar(60)
  maxTokens      Int     @default(1024)
  temperature    Decimal @default(0.30) @db.Decimal(3, 2)
  streaming      Boolean @default(true)
  systemPrompt   String? @db.Text
  dailyTokenLimit Int?
  retentionDays  Int?    @default(90)
  timeoutMs      Int     @default(30000)
  maxRetries     Int     @default(2)
  apiKey         String? @db.VarChar(200) // stored Anthropic key (env var takes precedence); never returned to the client
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("ai_settings")
}

/// Which roles may use the AI copilot for which module (RBAC for AI).
model AiPermission {
  id        Int    @id @default(autoincrement())
  tenantId  Int?
  roleKey   String @db.VarChar(60) // role slug or "*" for all
  moduleKey String @db.VarChar(60) // module key or "*" for all
  allowed   Boolean @default(true)
  scope     String? @db.VarChar(20) // all | own-branch | own-business
  createdAt DateTime @default(now())

  @@unique([tenantId, roleKey, moduleKey])
  @@map("ai_permissions")
}

// ===========================================================================
// AI COMMAND CENTER (Phase 3) — the AI prepares work as DRAFTS and navigates,
// but NEVER posts to real ERP tables, never approves, never deletes. A draft is
// staged here; the user reviews it and creates the real transaction through the
// normal ERP screen (which runs all validations + approval workflows).
// ===========================================================================

/// An AI-prepared draft transaction (staging only — not the real ERP record).
model AiCommandDraft {
  id             Int    @id @default(autoincrement())
  tenantId       Int
  businessId     Int?
  branchId       Int?
  userId         Int
  conversationId Int?
  module         String @db.VarChar(40)  // finance | sales | purchase | …
  txType         String @db.VarChar(40)  // expense | payment | sales-invoice | …
  txLabel        String @db.VarChar(80)
  intent         String? @db.VarChar(200)
  fieldsJson     String? @db.Text        // collected field values {key: value}
  missingJson    String? @db.Text        // remaining required field keys []
  askKey         String? @db.VarChar(60) // the field currently being collected
  summary        String? @db.VarChar(500)
  targetHref     String @db.VarChar(160) // ERP "new" screen to create the real record
  priority       String @default("Medium") @db.VarChar(10) // High | Medium | Low
  status         String @default("Collecting") @db.VarChar(16) // Collecting | Draft | Submitted | Completed | Cancelled
  validationJson String? @db.Text        // pre-draft validation issues/warnings
  createdBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, userId, status])
  @@index([conversationId])
  @@map("ai_command_draft")
}

/// Action history — every AI command and what it produced (audit of the command center).
model AiCommandAction {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  userId     Int
  actionNo   String @db.VarChar(40)
  prompt     String @db.VarChar(500)
  intent     String @db.VarChar(40)  // navigate | create | report | dashboard | query | recommend | explain | collect
  module     String? @db.VarChar(40)
  txType     String? @db.VarChar(40)
  draftId    Int?
  target     String? @db.VarChar(160) // navigated href / created draft ref
  status     String @db.VarChar(20)   // navigated | answered | draft-created | collecting | blocked | failed
  detail     String? @db.VarChar(400)
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("ai_command_action")
}

/// Recurring Transaction configuration (System → Account Configuration). Defines a
/// repeating expense/income rule; operational generation lives under Finance and
/// writes RecurringExecution rows. Never edited from the operational screens.
model RecurringConfig {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  configNo    String  @db.VarChar(40)
  name        String  @db.VarChar(160)
  description String? @db.Text
  txnType     String  @db.VarChar(10) // expense | income

  department String? @db.VarChar(120)
  costCenter String? @db.VarChar(120)
  project    String? @db.VarChar(120)

  generationMode String @default("manual") @db.VarChar(24) // automatic | manual | scheduler_approval | reminder
  postingMethod  String @default("ap") @db.VarChar(24)     // expense: ap|pay_now|journal · income: ar|receive_now|journal

  headId   Int?    // primary head (single-line summary); multi-line lives in linesJson
  headName String? @db.VarChar(160)
  linesJson String? @db.Text // [{ headId, headName, description, amount, gstPct }] — one voucher, many heads
  partyId   Int?
  partyName String? @db.VarChar(200)
  partyType String? @db.VarChar(20)

  gstApplicable    Boolean @default(false)
  gstPct           Decimal @default(0) @db.Decimal(9, 2)
  tdsRate          Decimal @default(0) @db.Decimal(9, 2)
  tcsRate          Decimal @default(0) @db.Decimal(9, 2)
  budgetValidation Boolean @default(false)

  amountType String  @default("fixed") @db.VarChar(10) // fixed | variable
  amount     Decimal @default(0) @db.Decimal(18, 2)
  minAmount  Decimal @default(0) @db.Decimal(18, 2)
  maxAmount  Decimal @default(0) @db.Decimal(18, 2)

  startDate     String  @db.VarChar(20)
  endDate       String? @db.VarChar(20)
  frequency     String  @default("monthly") @db.VarChar(12) // daily|weekly|monthly|quarterly|halfyearly|yearly|custom
  customDays    Int?
  nextExecution String? @db.VarChar(20)
  lastExecution String? @db.VarChar(20)

  execOptionsJson   String? @db.Text
  notificationsJson String? @db.Text

  status    String @default("Draft") @db.VarChar(12) // Draft|Active|Paused|Cancelled|Completed|Expired
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions RecurringExecution[]

  @@index([tenantId, status])
  @@index([tenantId, nextExecution])
  @@map("recurring_configs")
}

/// One generated occurrence of a recurring configuration (Execution History) —
/// links to the posted Expense/Income voucher.
model RecurringExecution {
  id       Int             @id @default(autoincrement())
  tenantId Int
  configId Int
  config   RecurringConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  executionNo String  @db.VarChar(40)
  executionDate String @db.VarChar(20)
  dueDate     String? @db.VarChar(20)
  amount      Decimal @default(0) @db.Decimal(18, 2)
  settledAmount Decimal @default(0) @db.Decimal(18, 2) // paid (expense) / collected (income) so far
  status      String  @default("Generated") @db.VarChar(16) // Generated|Posted|PendingApproval|Approved|Rejected|Skipped|Failed

  voucherType String? @db.VarChar(20)
  voucherId   Int?
  voucherNo   String? @db.VarChar(40)

  generatedBy       String @default("user") @db.VarChar(12) // scheduler | user
  generatedByUserId Int?
  remarks           String? @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, configId])
  @@index([tenantId, status])
  @@map("recurring_executions")
}

/// Budget Revision — an increase/decrease to a head's budget, recorded as a separate
/// transaction (the original BudgetLine is NEVER modified). Only Approved revisions
/// affect the effective/current budget. Full history is preserved.
model BudgetRevision {
  id       Int          @id @default(autoincrement())
  tenantId Int
  headerId Int
  header   BudgetHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)

  revisionNo   String @db.VarChar(40)
  revisionDate String @db.VarChar(20)
  headId       Int
  headName     String? @db.VarChar(160)
  businessId   Int?
  branchId     Int?
  fy           String  @db.VarChar(20)

  revisionType   String  @db.VarChar(10) // increase | decrease
  amount         Decimal @default(0) @db.Decimal(18, 2)
  originalBudget Decimal @default(0) @db.Decimal(18, 2)
  previousBudget Decimal @default(0) @db.Decimal(18, 2)
  revisedBudget  Decimal @default(0) @db.Decimal(18, 2)
  committedSnapshot Decimal @default(0) @db.Decimal(18, 2)
  actualSnapshot    Decimal @default(0) @db.Decimal(18, 2)

  reason          String? @db.Text
  effectiveDate   String? @db.VarChar(20)
  remarks         String? @db.Text
  attachmentsJson String? @db.Text

  status      String   @default("Pending") @db.VarChar(12) // Pending | Approved | Rejected
  requestedBy Int?
  approvedBy  Int?
  rejectedBy  Int?
  approvedAt  DateTime?
  rejectReason String? @db.VarChar(300)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, headerId])
  @@index([tenantId, headId, status])
  @@map("budget_revisions")
}

/// Budget Transfer — moves budget from one head to another, as a separate transaction.
/// Only Approved transfers affect the effective budget; the original plan is unchanged.
model BudgetTransfer {
  id       Int          @id @default(autoincrement())
  tenantId Int
  headerId Int
  header   BudgetHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)

  transferNo   String @db.VarChar(40)
  transferDate String @db.VarChar(20)
  businessId   Int?
  branchId     Int?
  fy           String @db.VarChar(20)

  fromHeadId   Int
  fromHeadName String? @db.VarChar(160)
  toHeadId     Int
  toHeadName   String? @db.VarChar(160)
  amount       Decimal @default(0) @db.Decimal(18, 2)
  fromPrevBudget Decimal @default(0) @db.Decimal(18, 2)
  fromNewBudget  Decimal @default(0) @db.Decimal(18, 2)
  toPrevBudget   Decimal @default(0) @db.Decimal(18, 2)
  toNewBudget    Decimal @default(0) @db.Decimal(18, 2)

  reason          String? @db.Text
  effectiveDate   String? @db.VarChar(20)
  remarks         String? @db.Text
  attachmentsJson String? @db.Text

  status      String   @default("Pending") @db.VarChar(12) // Pending | Approved | Rejected
  requestedBy Int?
  approvedBy  Int?
  rejectedBy  Int?
  approvedAt  DateTime?
  rejectReason String? @db.VarChar(300)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, headerId])
  @@index([tenantId, status])
  @@map("budget_transfers")
}

/// One expense head's allocation within a budget plan: annual + 12 monthly buckets
/// (m1=Apr … m12=Mar) plus per-head control config. Quarters are derived, not stored.
model BudgetLine {
  id       Int          @id @default(autoincrement())
  tenantId Int
  headerId Int
  header   BudgetHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)

  headId       Int
  headName     String? @db.VarChar(160)
  categoryName String? @db.VarChar(160)
  accountId    Int?    // GL account the head maps to (denormalised for reporting)
  accountCode  String? @db.VarChar(20)

  budgetType       String  @default("annual") @db.VarChar(10) // annual | monthly
  budgetRequired   Boolean @default(true)
  trackBudget      Boolean @default(true)
  allowExceed      Boolean @default(false)
  approvalRequired Boolean @default(false)
  budgetControl    String  @default("warning") @db.VarChar(12) // warning | approval | stop

  annual Decimal @default(0) @db.Decimal(18, 2)
  m1  Decimal @default(0) @db.Decimal(18, 2)
  m2  Decimal @default(0) @db.Decimal(18, 2)
  m3  Decimal @default(0) @db.Decimal(18, 2)
  m4  Decimal @default(0) @db.Decimal(18, 2)
  m5  Decimal @default(0) @db.Decimal(18, 2)
  m6  Decimal @default(0) @db.Decimal(18, 2)
  m7  Decimal @default(0) @db.Decimal(18, 2)
  m8  Decimal @default(0) @db.Decimal(18, 2)
  m9  Decimal @default(0) @db.Decimal(18, 2)
  m10 Decimal @default(0) @db.Decimal(18, 2)
  m11 Decimal @default(0) @db.Decimal(18, 2)
  m12 Decimal @default(0) @db.Decimal(18, 2)

  businessId Int?
  branchId   Int?

  @@unique([headerId, headId])
  @@index([tenantId, headId])
  @@map("budget_lines")
}

/// A petty-cash / expense payment voucher. Multiple expense heads can be paid
/// under one voucher with split payment modes. Posts: Dr Expenses, Cr Cash/Bank.
model PettyCashVoucher {
  id       Int    @id @default(autoincrement())
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  voucherNo   String  @db.VarChar(40)
  voucherDate String  @db.VarChar(20)
  payeeType   String  @db.VarChar(20) // Employee | Supplier | Vendor
  payeeId     Int? // supplier-master id
  payeeName   String? @db.VarChar(200)

  gstApplicable Boolean @default(false)
  taxableTotal  Decimal @default(0) @db.Decimal(18, 2)
  cgst          Decimal @default(0) @db.Decimal(18, 2)
  sgst          Decimal @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal @default(0) @db.Decimal(18, 2)
  totalAmount   Decimal @db.Decimal(18, 2) // gross (taxable + tax)

  notes  String? @db.Text
  status String  @default("Completed") @db.VarChar(20)

  // Enterprise Expense Management — Business Expense fields (Petty leaves these default).
  expenseType   String   @default("petty") @db.VarChar(12) // petty | business
  postingType   String?  @db.VarChar(12) // ap | paynow (business only)
  bankId        Int?
  bankName      String?  @db.VarChar(150)
  bankAccount   String?  @db.VarChar(60)
  supplierGstin String?  @db.VarChar(20)
  invoiceNo     String?  @db.VarChar(60)
  invoiceDate   String?  @db.VarChar(20)
  dueDate       String?  @db.VarChar(20)
  reverseCharge Boolean  @default(false)
  tdsSection    String?  @db.VarChar(20)
  tdsRate       Decimal  @default(0) @db.Decimal(8, 2)
  tdsAmount     Decimal  @default(0) @db.Decimal(18, 2)
  tcsRate       Decimal  @default(0) @db.Decimal(8, 2)
  tcsAmount     Decimal  @default(0) @db.Decimal(18, 2)
  netPayable    Decimal  @default(0) @db.Decimal(18, 2)
  attachmentsJson String? @db.Text // [{ fileName, fileUrl, fileType, size }]

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    PettyCashLine[]
  payments PettyCashPayment[]

  @@unique([tenantId, voucherNo])
  @@index([tenantId, voucherDate])
  businessId Int?
  branchId   Int?

  // POS terminal / shift / session traceability (additive).
  terminalId        Int?
  terminalSessionId Int?
  shiftSessionId    Int?
  cashierUserId     Int?
  deviceId          String? @db.VarChar(80)
  transactionSource String? @db.VarChar(20)
  dayOpeningId      Int?
  dayClosingId      Int?

  @@map("petty_cash_vouchers")
}

/// One expense-head line of a petty-cash voucher.
model PettyCashLine {
  id        Int              @id @default(autoincrement())
  tenantId  Int
  voucherId Int
  voucher   PettyCashVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  headId      Int?
  headName    String? @db.VarChar(160)
  description String? @db.VarChar(300)
  hsn         String?  @db.VarChar(20) // HSN / SAC code
  gstPct      Decimal? @db.Decimal(9, 2)
  taxable     Decimal? @db.Decimal(18, 2)
  taxAmount   Decimal? @db.Decimal(18, 2)
  amount      Decimal  @db.Decimal(18, 2) // gross (taxable + tax)

  @@index([voucherId])
  @@index([tenantId, headId])
  businessId Int?
  branchId   Int?

  @@map("petty_cash_lines")
}

/// One tender of a petty-cash voucher (supports split payment modes).
model PettyCashPayment {
  id        Int              @id @default(autoincrement())
  voucherId Int
  voucher   PettyCashVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  mode      String  @db.VarChar(40) // Cash | Bank Transfer | UPI | Cheque | Card
  amount    Decimal @db.Decimal(18, 2)
  reference String? @db.VarChar(80)

  @@index([voucherId])
  @@map("petty_cash_payments")
}

/// Variant attributes for a product (Text / Number / Dropdown / Color / Boolean).
model ProductAttribute {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String? @db.VarChar(120)
  type      String? @db.VarChar(40)
  values    String? @db.VarChar(500)

  @@index([productId])
  @@map("product_attributes")
}

/// Append-only audit trail — one row per state-changing action (create / approve /
/// reject / update / delete) across modules. Rows are never mutated; queried by
/// entity (who touched this record) or by time (what happened in this window).
/// Activity 5 of the platform roadmap; see Shared-Contracts pattern for the rollout style.
model AuditLog {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  userId   Int? // actor; null = system / unauthenticated
  userName String? @db.VarChar(200) // denormalised so the trail survives user deletion

  action   String  @db.VarChar(80) // dotted verb, e.g. "sales_return.create"
  entity   String  @db.VarChar(60) // model name, e.g. "SalesReturn"
  entityId String? @db.VarChar(60) // stringified PK (BigInt / composite friendly)
  summary  String? @db.VarChar(300) // human-readable one-liner

  meta String? @db.Text // JSON blob: before/after snapshot, amounts, related ids

  ip        String?  @db.VarChar(60)
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@map("audit_logs")
}

/// A physical or virtual POS register (counter / laptop / mobile / kiosk / self-
/// checkout). Centrally registered and configured; every billing device is a row.
/// Identity, mapping, status and key defaults are typed columns; the long tail of
/// hardware / billing / cash / offline / mobile toggles lives in `config` (JSON),
/// mirroring the PosSetting / SalesSetting blob convention.
model PosTerminal {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  code        String  @db.VarChar(40) // unique per tenant, e.g. "COUNTER-01"
  name        String  @db.VarChar(120)
  type        String  @default("Desktop POS") @db.VarChar(30) // Desktop POS | Laptop POS | Mobile POS | Self Checkout | Kiosk
  description String? @db.Text
  warehouse   String? @db.VarChar(120) // stock location this terminal sells from

  // Sales configuration (soft references — PriceList / TaxProfile are not entities)
  defaultCustomerId Int?
  receiptTemplateId Int?
  defaultWarehouse  String? @db.VarChar(120)
  defaultSalesType  String? @db.VarChar(40)
  defaultPriceList  String? @db.VarChar(80)
  defaultTaxProfile String? @db.VarChar(80)
  invoiceSeries     String? @db.VarChar(40)

  // Security / device identity
  ipAddress          String?  @db.VarChar(60)
  deviceId           String?  @db.VarChar(80)
  macAddress         String?  @db.VarChar(60)
  deviceAuthRequired Boolean  @default(false)

  status String @default("active") @db.VarChar(20) // active | inactive
  config Json? // hardware{}, billing{}, cash{}, offline{}, mobile{} toggles

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shiftMaps TerminalShiftMap[]
  sessions  TerminalSession[]
  userMaps  UserTerminalMap[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@map("pos_terminals")
}

/// Maps a User to the POS terminals they may operate / whose data they may see
/// (many-to-many). When General Settings "terminalSetupRequired" is on, a user is
/// restricted to their mapped terminals' transactions; unmapped users see all.
model UserTerminalMap {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  userId     Int
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  terminalId Int
  terminal   PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  createdBy Int?
  createdAt DateTime @default(now())

  @@unique([userId, terminalId])
  @@index([tenantId, userId])
  @@index([tenantId, terminalId])
  @@map("user_terminal_maps")
}

// ============================ Day Opening & Day Closing (EOD) ===============
// Centralised end-of-day reconciliation across Shift → Terminal → Branch →
// Business. Day Opening orchestrates a TerminalSession (reusing its cash open/
// close); cash movements, transfers and closings are stored here (no GL posting
// yet — that and reports/dashboards are a later phase).

/// A cashier's opened business day at a terminal+shift. Links to the underlying
/// TerminalSession for cash open/close; adds opening bank/safe/petty snapshots.
model DayOpening {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  dayOpeningNo      String   @db.VarChar(40)
  openingDate       String   @db.VarChar(20) // YYYY-MM-DD
  openingAt         DateTime @default(now())
  terminalId        Int? // null = branch-level day (terminal-based setup off / unmapped user)
  shiftId           Int?
  terminalSessionId Int? // the linked TerminalSession (cash open/close lives there)
  cashierUserId     Int

  openingCash        Decimal  @default(0) @db.Decimal(18, 2)
  openingBankBalance Decimal? @db.Decimal(18, 2) // view-only snapshot (from GL)
  openingSafeBalance Decimal? @db.Decimal(18, 2) // view-only snapshot (Σ safe ledger)
  openingPettyCash   Decimal? @db.Decimal(18, 2)
  remarks            String?  @db.VarChar(300)

  status    String @default("Open") @db.VarChar(20) // Open | Closed
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dayOpeningNo])
  @@index([tenantId, branchId, openingDate])
  @@index([tenantId, terminalSessionId])
  @@index([tenantId, status])
  @@map("day_opening")
}

/// Physical cash count vs expected at shift/day close (excess / shortage).
model CashDeclaration {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  dayOpeningId      Int
  terminalId        Int
  terminalSessionId Int?
  cashierUserId     Int

  expectedCash  Decimal @default(0) @db.Decimal(18, 2)
  physicalCount Decimal @default(0) @db.Decimal(18, 2)
  excess        Decimal @default(0) @db.Decimal(18, 2)
  shortage      Decimal @default(0) @db.Decimal(18, 2)
  difference    Decimal @default(0) @db.Decimal(18, 2)
  denominations Json? // optional denomination breakdown
  remarks       String? @db.VarChar(300)

  approvalStatus String @default("NotRequired") @db.VarChar(20) // NotRequired | Pending | Approved
  approvedBy     Int?
  createdBy      Int?
  createdAt      DateTime @default(now())

  @@index([tenantId, dayOpeningId])
  @@index([tenantId, terminalSessionId])
  @@map("cash_declaration")
}

/// A closed shift/terminal session record + its validation gate + snapshot.
model ShiftClosing {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  dayOpeningId      Int
  terminalId        Int
  shiftId           Int?
  terminalSessionId Int?
  cashierUserId     Int

  closedAt    DateTime @default(now())
  validations Json? // { holdBills, refund, approval, declaration, diffApproved }
  summary     Json? // snapshot totals at close

  expectedCash Decimal @default(0) @db.Decimal(18, 2)
  countedCash  Decimal @default(0) @db.Decimal(18, 2)
  difference   Decimal @default(0) @db.Decimal(18, 2)

  status     String @default("Closed") @db.VarChar(20)
  approvedBy Int?
  createdBy  Int?
  createdAt  DateTime @default(now())

  @@index([tenantId, dayOpeningId])
  @@index([tenantId, branchId])
  @@map("shift_closing")
}

/// Terminal cash drawer movement (deposit / withdrawal / petty / adjustment /
/// declaration). Stored for reconciliation; no GL posting here yet.
model TerminalCashTransaction {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  txnNo             String? @db.VarChar(40)
  dayOpeningId      Int?
  terminalId        Int
  terminalSessionId Int?
  cashierUserId     Int

  type       String  @db.VarChar(30) // Deposit | Withdrawal | PettyCash | Adjustment | Declaration
  amount     Decimal @default(0) @db.Decimal(18, 2)
  reason     String? @db.VarChar(300)
  voucherRef String? @db.VarChar(80)

  approvalStatus String @default("NotRequired") @db.VarChar(20)
  createdBy      Int?
  createdAt      DateTime @default(now())

  @@index([tenantId, dayOpeningId])
  @@index([tenantId, terminalId])
  @@map("terminal_cash_transaction")
}

/// Cash moved between two terminals (request → acknowledge → completed).
model TerminalFundTransfer {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  transferNo     String? @db.VarChar(40)
  fromTerminalId Int
  toTerminalId   Int
  shiftId        Int?
  amount         Decimal @default(0) @db.Decimal(18, 2)
  reason         String? @db.VarChar(300)
  transferredBy  Int
  receivedBy     Int?
  acknowledgedAt DateTime?

  status    String @default("Requested") @db.VarChar(20) // Requested | Acknowledged | Completed
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, fromTerminalId])
  @@index([tenantId, toTerminalId])
  @@index([tenantId, status])
  @@map("terminal_fund_transfer")
}

/// Safe-locker cash ledger. Branch safe balance = Σ IN − Σ OUT. Directions:
/// IN_FROM_TERMINAL (terminal → safe), OUT_TO_TERMINAL (safe → terminal),
/// OUT_TO_BANK (safe → bank deposit).
model SafeLockerTransaction {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  txnNo          String? @db.VarChar(40)
  direction      String  @db.VarChar(30) // IN_FROM_TERMINAL | OUT_TO_TERMINAL | OUT_TO_BANK
  terminalId     Int?
  amount         Decimal @default(0) @db.Decimal(18, 2)
  transferredBy  Int?
  receivedBy     Int?
  acknowledgedAt DateTime?
  reason         String? @db.VarChar(300)
  refType        String? @db.VarChar(30) // e.g. BANK_DEPOSIT
  refId          Int?

  status    String @default("Completed") @db.VarChar(20) // Pending | Completed
  createdBy Int?
  createdAt DateTime @default(now())

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, direction])
  @@map("safe_locker_transaction")
}

/// Cash deposited from the safe locker into a bank account.
model BankDeposit {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  depositNo   String? @db.VarChar(40)
  bankName    String  @db.VarChar(120)
  bankAccount String? @db.VarChar(60)
  depositSlip String? @db.VarChar(80)
  amount      Decimal @default(0) @db.Decimal(18, 2)
  depositDate String  @db.VarChar(20)
  depositAt   DateTime @default(now())
  depositBy   Int
  remarks     String? @db.VarChar(300)

  status    String @default("Completed") @db.VarChar(20)
  createdBy Int?
  createdAt DateTime @default(now())

  @@index([tenantId, branchId, depositDate])
  @@map("bank_deposit")
}

/// Per-terminal end-of-day snapshot (denormalised totals for fast reporting).
model TerminalClosingSummary {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  dayDate           String @db.VarChar(20)
  terminalId        Int
  terminalSessionId Int?
  openingCash       Decimal @default(0) @db.Decimal(18, 2)
  closingCash       Decimal @default(0) @db.Decimal(18, 2)
  difference        Decimal @default(0) @db.Decimal(18, 2)
  totals            Json? // snapshot of sales/collection/cash/etc.

  createdBy Int?
  createdAt DateTime @default(now())

  @@index([tenantId, branchId, dayDate])
  @@map("terminal_closing_summary")
}

/// The business-day close record (per branch+date).
model DayClosing {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  dayClosingNo String   @db.VarChar(40)
  closingDate  String   @db.VarChar(20)
  closedAt     DateTime @default(now())
  status       String   @default("Closed") @db.VarChar(20)
  remarks      String?  @db.VarChar(300)
  approvedBy   Int?
  createdBy    Int?
  createdAt    DateTime @default(now())

  @@unique([tenantId, dayClosingNo])
  @@index([tenantId, branchId, closingDate])
  @@map("day_closing")
}

/// Consolidated business-day summary snapshot (sales / collection / payment /
/// finance / cash / bank / inventory / terminal / shift).
model DaySummary {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  dayDate      String @db.VarChar(20)
  dayClosingId Int?
  summary      Json?

  createdBy Int?
  createdAt DateTime @default(now())

  @@unique([tenantId, branchId, dayDate])
  @@map("day_summary")
}

/// A reusable shift definition (timing + cash + operational rules) that can be
/// mapped to any number of terminals. Operational toggles + auto-actions live in
/// `config` (JSON); cash rules and timing are typed columns.
model Shift {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  code        String  @db.VarChar(40)
  name        String  @db.VarChar(120)
  description String? @db.Text

  // Timing
  startTime      String  @default("09:00") @db.VarChar(10) // HH:mm
  endTime        String  @default("21:00") @db.VarChar(10)
  crossDay       Boolean @default(false) // end time falls on the next calendar day
  gracePeriodMins Int?

  // Cash rules
  openingCashMandatory   Boolean  @default(true)
  closingCashMandatory   Boolean  @default(true)
  physicalCountRequired  Boolean  @default(false)
  managerApprovalRequired Boolean @default(false)
  maxCashDifference      Decimal? @db.Decimal(18, 2)

  status String @default("active") @db.VarChar(20)
  config Json? // operational rules + auto-actions (allowSales, allowReturn, autoLogout, ...)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maps     TerminalShiftMap[]
  sessions TerminalSession[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("shifts")
}

/// Maps a Shift to a POS Terminal (many-to-many) with an effective window, so a
/// terminal only offers its authorised shifts.
model TerminalShiftMap {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  terminalId Int
  terminal   PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  shiftId    Int
  shift      Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  effectiveFrom String? @db.VarChar(20)
  effectiveTo   String? @db.VarChar(20)
  status        String  @default("active") @db.VarChar(20)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, terminalId])
  @@index([tenantId, shiftId])
  @@map("terminal_shift_maps")
}

/// A cashier's working session on a terminal: login → logout, with opening /
/// closing cash reconciliation. One Open session per terminal at a time. This row
/// is both the terminal session and the cash "shift session" — transactions stamp
/// terminalSessionId = shiftSessionId = this id (can be split later).
model TerminalSession {
  id         Int     @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId Int?
  branchId   Int?

  sessionNo  String @db.VarChar(40)
  terminalId Int
  terminal   PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  shiftId    Int?
  shift      Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashierUserId Int

  loginAt  DateTime  @default(now())
  logoutAt DateTime?

  openingCash    Decimal? @db.Decimal(18, 2)
  closingCash    Decimal? @db.Decimal(18, 2)
  expectedCash   Decimal? @db.Decimal(18, 2)
  cashDifference Decimal? @db.Decimal(18, 2)

  status      String  @default("Open") @db.VarChar(20) // Open | Closed
  openingNote String? @db.VarChar(300)
  closingNote String? @db.VarChar(300)
  approvedBy  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sessionNo])
  @@index([tenantId, terminalId, status])
  @@index([tenantId, cashierUserId])
  @@map("terminal_sessions")
}

// ============================================================================
// GST COMPLIANCE & STATUTORY MANAGEMENT (Phase 1)
// Centralised statutory compliance: verification, GSTR-2B reconciliation, ITC,
// GSTR-1 / GSTR-3B preparation, JSON export, period closing, filing history.
// All figures are READ from existing transaction tables (sales / purchase /
// returns / cancellations); these tables only persist compliance artifacts.
// ============================================================================

/// A prepared statutory return (GSTR-1 / GSTR-3B) for one GSTIN + tax period.
/// Workflow: Draft -> Prepared -> Verified -> Approved -> ReadyForFiling -> Filed.
model GstReturn {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  returnType String @db.VarChar(12) // GSTR-1 | GSTR-3B
  period     String @db.VarChar(7)  // YYYY-MM
  fromDate   String @db.VarChar(20)
  toDate     String @db.VarChar(20)
  gstin      String? @db.VarChar(20)
  legalName  String? @db.VarChar(200)

  status String @default("Draft") @db.VarChar(20) // Draft | Prepared | Verified | Approved | ReadyForFiling | Filed

  taxableValue Decimal @default(0) @db.Decimal(18, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 2)
  sgst         Decimal @default(0) @db.Decimal(18, 2)
  igst         Decimal @default(0) @db.Decimal(18, 2)
  cess         Decimal @default(0) @db.Decimal(18, 2)
  outputTax    Decimal @default(0) @db.Decimal(18, 2)
  itcTotal     Decimal @default(0) @db.Decimal(18, 2)
  netLiability Decimal @default(0) @db.Decimal(18, 2)

  totals      String? @db.LongText // JSON snapshot of the full computed return
  jsonVersion Int     @default(0)
  remarks     String? @db.VarChar(500)

  preparedBy     Int?
  preparedByName String?   @db.VarChar(200)
  preparedAt     DateTime?
  verifiedBy     Int?
  verifiedByName String?   @db.VarChar(200)
  verifiedAt     DateTime?
  approvedBy     Int?
  approvedByName String?   @db.VarChar(200)
  approvedAt     DateTime?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   GstReturnItem[]
  exports GstJsonExport[]

  @@index([tenantId, returnType, period])
  @@index([tenantId, status])
  @@map("gst_return_master")
}

/// One section row of a prepared return (B2B / B2C / CDNR / HSN / DOCS etc.).
model GstReturnItem {
  id       Int       @id @default(autoincrement())
  tenantId Int
  returnId Int
  ret      GstReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  section       String  @db.VarChar(12) // B2B | B2CS | B2CL | CDNR | CDNUR | EXP | SEZ | HSN | DOCS | NIL
  refType       String? @db.VarChar(20) // Sale | SalesReturn | etc.
  refId         Int?
  invoiceNo     String? @db.VarChar(40)
  invoiceDate   String? @db.VarChar(20)
  partyGstin    String? @db.VarChar(20)
  partyName     String? @db.VarChar(200)
  placeOfSupply String? @db.VarChar(80)

  hsn         String? @db.VarChar(20)
  description String? @db.VarChar(250)
  uom         String? @db.VarChar(40)
  qty         Decimal @default(0) @db.Decimal(18, 3)
  rate        Decimal @default(0) @db.Decimal(9, 2) // tax rate %

  taxableValue Decimal @default(0) @db.Decimal(18, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 2)
  sgst         Decimal @default(0) @db.Decimal(18, 2)
  igst         Decimal @default(0) @db.Decimal(18, 2)
  cess         Decimal @default(0) @db.Decimal(18, 2)
  total        Decimal @default(0) @db.Decimal(18, 2)

  meta String? @db.Text // JSON

  @@index([returnId])
  @@index([returnId, section])
  @@map("gst_return_items")
}

/// One imported GSTR-2B invoice row (from the GST portal). `importBatch` groups one upload.
model GstGstr2bImport {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  importBatch String  @db.VarChar(40)
  period      String  @db.VarChar(7) // YYYY-MM
  source      String  @default("JSON") @db.VarChar(10) // JSON | EXCEL | API
  fileName    String? @db.VarChar(200)

  supplierGstin String? @db.VarChar(20)
  supplierName  String? @db.VarChar(200)
  invoiceNo     String? @db.VarChar(40)
  invoiceDate   String? @db.VarChar(20)
  invoiceValue  Decimal @default(0) @db.Decimal(18, 2)
  taxableValue  Decimal @default(0) @db.Decimal(18, 2)
  cgst          Decimal @default(0) @db.Decimal(18, 2)
  sgst          Decimal @default(0) @db.Decimal(18, 2)
  igst          Decimal @default(0) @db.Decimal(18, 2)
  cess          Decimal @default(0) @db.Decimal(18, 2)
  gstAmount     Decimal @default(0) @db.Decimal(18, 2)
  eligibleItc   Decimal @default(0) @db.Decimal(18, 2)
  itcStatus     String  @default("Eligible") @db.VarChar(20) // Eligible | Ineligible | Blocked
  matchStatus   String  @default("Pending") @db.VarChar(20)  // Pending | Matched | PartiallyMatched | Mismatch | MissingInErp

  importedBy     Int?
  importedByName String?  @db.VarChar(200)
  importedAt     DateTime @default(now())

  @@index([tenantId, period])
  @@index([importBatch])
  @@map("gst_gstr2b_import")
}

/// One reconciliation result line — ERP purchase register vs imported GSTR-2B.
model GstReconciliation {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  period        String  @db.VarChar(7)
  supplierGstin String? @db.VarChar(20)
  supplierName  String? @db.VarChar(200)
  invoiceNo     String? @db.VarChar(40)
  invoiceDate   String? @db.VarChar(20)

  erpInvoiceId Int? // PurchaseInvoice.id
  portalRowId  Int? // GstGstr2bImport.id

  erpTaxable    Decimal @default(0) @db.Decimal(18, 2)
  erpGst        Decimal @default(0) @db.Decimal(18, 2)
  portalTaxable Decimal @default(0) @db.Decimal(18, 2)
  portalGst     Decimal @default(0) @db.Decimal(18, 2)
  taxDifference Decimal @default(0) @db.Decimal(18, 2)
  gstDifference Decimal @default(0) @db.Decimal(18, 2)

  status String  @default("Pending") @db.VarChar(24) // Matched | PartiallyMatched | Mismatch | MissingInErp | SupplierNotFiled | Pending
  issue  String? @db.VarChar(300)
  action String  @default("Pending") @db.VarChar(12) // Pending | Approved

  resolvedBy     Int?
  resolvedByName String?   @db.VarChar(200)
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, period])
  @@index([tenantId, status])
  @@map("gst_reconciliation")
}

/// Per purchase-invoice Input Tax Credit eligibility, for one period.
model GstItcRegister {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  period            String  @db.VarChar(7)
  purchaseInvoiceId Int?
  supplierGstin     String? @db.VarChar(20)
  supplierName      String? @db.VarChar(200)
  invoiceNo         String? @db.VarChar(40)
  invoiceDate       String? @db.VarChar(20)
  purchaseType      String  @default("Inventory") @db.VarChar(20)

  gstAmount        Decimal @default(0) @db.Decimal(18, 2)
  eligibleAmount   Decimal @default(0) @db.Decimal(18, 2)
  ineligibleAmount Decimal @default(0) @db.Decimal(18, 2)
  blockedAmount    Decimal @default(0) @db.Decimal(18, 2)
  claimedAmount    Decimal @default(0) @db.Decimal(18, 2)
  pendingAmount    Decimal @default(0) @db.Decimal(18, 2)
  reverseCharge    Boolean @default(false)
  itcStatus        String  @default("Eligible") @db.VarChar(20) // Eligible | Ineligible | Blocked | Pending | ReverseCharge

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, period])
  @@map("gst_itc_register")
}

/// A versioned GST-portal-compatible JSON export for a return.
model GstJsonExport {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  returnId   Int?
  ret        GstReturn? @relation(fields: [returnId], references: [id], onDelete: SetNull)
  returnType String     @db.VarChar(12)
  period     String     @db.VarChar(7)
  gstin      String?    @db.VarChar(20)

  version          Int     @default(1)
  fileName         String  @db.VarChar(200)
  payload          String  @db.LongText // the JSON document
  validationStatus String  @default("Valid") @db.VarChar(12) // Valid | Warning | Invalid
  validationNotes  String? @db.Text

  generatedBy     Int?
  generatedByName String?   @db.VarChar(200)
  generatedAt     DateTime  @default(now())
  downloadCount   Int       @default(0)
  lastDownloadAt  DateTime?

  @@index([tenantId, period])
  @@index([returnId])
  @@map("gst_json_export")
}

/// History of filed returns (after a return is marked filed on the portal).
model GstFilingHistory {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  returnId   Int?
  returnType String @db.VarChar(12)
  period     String @db.VarChar(7)
  gstin      String? @db.VarChar(20)

  arn          String? @db.VarChar(40) // acknowledgement reference number
  filingDate   String? @db.VarChar(20)
  jsonVersion  Int     @default(0)
  jsonExportId Int?
  status       String  @default("Filed") @db.VarChar(20) // Filed | Acknowledged | Error
  remarks      String? @db.VarChar(500)

  filedBy     Int?
  filedByName String?  @db.VarChar(200)
  createdAt   DateTime @default(now())

  @@index([tenantId, period])
  @@map("gst_filing_history")
}

/// GST period lock — once Locked, the period's returns can't be regenerated and
/// transactions in the window are frozen until an authorised reopen.
model GstPeriodClosing {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  period   String @db.VarChar(7)
  fromDate String @db.VarChar(20)
  toDate   String @db.VarChar(20)

  filingStatus  String @default("Pending") @db.VarChar(20) // Pending | Partially Filed | Filed
  closingStatus String @default("Open") @db.VarChar(12)    // Open | Verified | Locked

  lockedBy       Int?
  lockedByName   String?   @db.VarChar(200)
  lockedAt       DateTime?
  reopenedBy     Int?
  reopenedByName String?   @db.VarChar(200)
  reopenedAt     DateTime?
  reopenReason   String?   @db.VarChar(300)
  remarks        String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, period])
  @@map("gst_period_closing")
}

/// One finding from the GST transaction verification engine. `runBatch` groups one run.
model GstValidationLog {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  period   String @db.VarChar(7)
  runBatch String @db.VarChar(40)

  sourceType String  @db.VarChar(24) // Sale | PurchaseInvoice | PurchaseReturn | SalesReturn | SalesCancellation
  sourceId   Int?
  docNo      String? @db.VarChar(40)
  docDate    String? @db.VarChar(20)
  partyName  String? @db.VarChar(200)

  checkCode String @db.VarChar(40) // MISSING_GSTIN | INVALID_GSTIN | MISSING_HSN | ...
  severity  String @db.VarChar(12) // Error | Warning | Info
  message   String @db.VarChar(400)
  status    String @default("Open") @db.VarChar(12) // Open | Ignored | Approved | Corrected

  resolvedBy     Int?
  resolvedByName String?   @db.VarChar(200)
  resolvedAt     DateTime?
  resolutionNote String?   @db.VarChar(300)

  runBy     Int?
  runByName String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  @@index([tenantId, period])
  @@index([runBatch])
  @@index([tenantId, status])
  @@map("gst_validation_log")
}

/// Finance Cash Management — a single cash-book document covering Fund Transfers
/// (Cash <-> Bank) and Miscellaneous Receipts (non-sales income into cash/bank).
/// Each posted entry writes a balanced GL voucher (linked via sourceType CASH_ENTRY).
model CashEntry {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  kind  String @db.VarChar(20) // FUND_TRANSFER | MISC_RECEIPT
  docNo String @db.VarChar(40)
  date  String @db.VarChar(20)

  // Fund transfer
  transferType String? @db.VarChar(20) // CASH_TO_BANK | BANK_TO_CASH
  fromAccount  String? @db.VarChar(80)
  toAccount    String? @db.VarChar(80)

  // Miscellaneous receipt
  receivedIn String? @db.VarChar(10) // Cash | Bank
  payer      String? @db.VarChar(200)
  incomeHead String? @db.VarChar(120)
  mode       String? @db.VarChar(20) // Cash | Bank | Cheque | UPI | Card

  bankId      Int?
  bankName    String? @db.VarChar(120)
  bankAccount String? @db.VarChar(60)

  amount    Decimal @default(0) @db.Decimal(18, 2)
  reference String? @db.VarChar(120)
  remarks   String? @db.VarChar(300)

  status     String  @default("Posted") @db.VarChar(20)
  journalRef String? @db.VarChar(40)

  createdBy     Int?
  createdByName String?  @db.VarChar(200)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, branchId, date])
  @@index([tenantId, kind])
  @@map("cash_entries")
}

// ============================================================================
// RECEIPT TRANSACTION MODULE — miscellaneous (non-sales-collection) receipts.
// Standalone finance module: configurable categories + payment modes, approval
// workflow (Draft→Submitted→Approved→Posted→Cancelled), GL posting, attachments,
// dedicated audit. NOT for sales/customer collections (separate modules).
// ============================================================================

/// Per-business receipt module configuration + voucher numbering counter.
model ReceiptConfiguration {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  enableModule    Boolean @default(true)
  enableApproval  Boolean @default(false)
  enableAttachment Boolean @default(true)
  enableCostCenter Boolean @default(false)
  enableDepartment Boolean @default(false)
  enableProject   Boolean @default(false)
  enableMultiMode Boolean @default(false)
  enableSubHead   Boolean @default(false)
  enableGst       Boolean @default(false)

  autoVoucher      Boolean @default(true)
  voucherPrefix    String  @default("REC") @db.VarChar(20)
  voucherPadding   Int     @default(4)
  voucherSeparator String  @default("/") @db.VarChar(4)
  voucherReset     String  @default("Yearly") @db.VarChar(10) // Yearly | Monthly | Never
  voucherSeq       Int     @default(0)
  voucherSeqPeriod String? @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("receipt_configuration")
}

/// A configurable receipt category with default Dr/Cr accounts.
model ReceiptCategory {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  code        String  @db.VarChar(30)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(300)

  debitCode  String? @db.VarChar(20)
  debitName  String? @db.VarChar(120)
  creditCode String? @db.VarChar(20)
  creditName String? @db.VarChar(120)

  approvalRequired Boolean @default(false)
  allowAttachment  Boolean @default(true)
  active           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subHeads ReceiptSubHead[]

  @@index([tenantId, active])
  @@map("receipt_category_master")
}

/// A sub receipt head under a category (e.g. Rental → Shop Rent / Maintenance).
model ReceiptSubHead {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  categoryId Int
  category   ReceiptCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  code       String? @db.VarChar(30)
  name       String  @db.VarChar(120)
  creditCode String? @db.VarChar(20)
  creditName String? @db.VarChar(120)
  taxType    String  @default("None") @db.VarChar(10) // None | GST | TDS | TCS
  taxRate    Decimal @default(0) @db.Decimal(9, 2)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("receipt_sub_head")
}

/// A miscellaneous receipt voucher.
model ReceiptTransaction {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  voucherNo        String  @db.VarChar(40)
  voucherDate      String  @db.VarChar(20)
  financialYear    String? @db.VarChar(20)
  accountingPeriod String? @db.VarChar(20)

  categoryId   Int?
  categoryCode String? @db.VarChar(30)
  categoryName String? @db.VarChar(120)

  amount        Decimal @default(0) @db.Decimal(18, 2) // net cash received (taxable + GST + TCS − TDS)
  taxableAmount Decimal @default(0) @db.Decimal(18, 2)
  gstApplicable Boolean @default(false)
  gstAmount     Decimal @default(0) @db.Decimal(18, 2)
  cgstAmount    Decimal @default(0) @db.Decimal(18, 2)
  sgstAmount    Decimal @default(0) @db.Decimal(18, 2)
  igstAmount    Decimal @default(0) @db.Decimal(18, 2)
  tdsAmount     Decimal @default(0) @db.Decimal(18, 2)
  tcsAmount     Decimal @default(0) @db.Decimal(18, 2)
  partyGstin    String? @db.VarChar(20)
  mode   String  @db.VarChar(20) // Cash | Bank | UPI | Card | Cheque | DD | NEFT | RTGS | IMPS

  cashAccountCode String? @db.VarChar(20)
  bankAccountCode String? @db.VarChar(20)
  bankName        String? @db.VarChar(120)
  bankId          Int?
  bankAccount     String? @db.VarChar(60)

  partyType String? @db.VarChar(20) // Supplier | Employee | Owner | Bank | Other
  partyId   Int?
  partyName String? @db.VarChar(200)

  referenceNo   String? @db.VarChar(80)
  referenceDate String? @db.VarChar(20)
  narration     String? @db.VarChar(400)

  debitCode  String? @db.VarChar(20)
  debitName  String? @db.VarChar(120)
  creditCode String? @db.VarChar(20)
  creditName String? @db.VarChar(120)

  costCenter String? @db.VarChar(80)
  department String? @db.VarChar(80)
  project    String? @db.VarChar(80)
  remarks    String? @db.VarChar(400)

  status     String  @default("Draft") @db.VarChar(12) // Draft | Submitted | Approved | Posted | Cancelled
  journalRef String? @db.VarChar(40)

  submittedBy   Int?
  submittedByName String? @db.VarChar(200)
  submittedAt   DateTime?
  approvedBy    Int?
  approvedByName String? @db.VarChar(200)
  approvedAt    DateTime?
  postedBy      Int?
  postedByName  String? @db.VarChar(200)
  postedAt      DateTime?
  cancelledBy   Int?
  cancelledByName String? @db.VarChar(200)
  cancelledAt   DateTime?

  createdBy     Int?
  createdByName String?  @db.VarChar(200)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  details     ReceiptTransactionDetail[]
  attachments ReceiptAttachment[]
  audits      ReceiptAudit[]

  @@index([tenantId, status])
  @@index([tenantId, voucherDate])
  @@map("receipt_transaction")
}

/// One sub-head line of a receipt: head + taxable amount + GST + its credit account.
model ReceiptTransactionDetail {
  id        Int                @id @default(autoincrement())
  tenantId  Int
  receiptId Int
  receipt   ReceiptTransaction @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  subHeadId  Int?
  headName   String? @db.VarChar(120)
  taxable    Decimal @default(0) @db.Decimal(18, 2)
  taxType    String  @default("None") @db.VarChar(10) // None | GST | TDS | TCS
  gstRate    Decimal? @db.Decimal(9, 2) // the tax rate for this line (GST/TDS/TCS)
  gstAmount  Decimal @default(0) @db.Decimal(18, 2) // GST total (cgst+sgst)
  cgst       Decimal @default(0) @db.Decimal(18, 2)
  sgst       Decimal @default(0) @db.Decimal(18, 2)
  tdsAmount  Decimal @default(0) @db.Decimal(18, 2)
  tcsAmount  Decimal @default(0) @db.Decimal(18, 2)
  amount     Decimal @default(0) @db.Decimal(18, 2) // line net cash
  creditCode String? @db.VarChar(20)
  creditName String? @db.VarChar(120)

  @@index([receiptId])
  @@map("receipt_transaction_details")
}

/// A document attached to a receipt (receipt copy / bank advice / supporting).
model ReceiptAttachment {
  id        Int                @id @default(autoincrement())
  tenantId  Int
  receiptId Int
  receipt   ReceiptTransaction @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  docType  String  @default("supporting") @db.VarChar(20) // receipt | advice | supporting
  fileName String  @db.VarChar(200)
  fileUrl  String  @db.LongText
  fileType String? @db.VarChar(80)
  size     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([receiptId])
  @@map("receipt_attachment")
}

/// Dedicated receipt audit trail (Created/Modified/Approved/Posted/etc.).
model ReceiptAudit {
  id        Int                @id @default(autoincrement())
  tenantId  Int
  receiptId Int
  receipt   ReceiptTransaction @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  action String  @db.VarChar(20) // Created | Modified | Submitted | Approved | Posted | Cancelled | Printed | Exported
  byUser Int?
  byName String? @db.VarChar(200)
  note   String? @db.VarChar(300)
  at     DateTime @default(now())

  @@index([receiptId])
  @@map("receipt_audit")
}

/// A reusable receipt party (Employee / Owner / Bank / Other). Supplier parties
/// live in the suppliers master; this holds the non-supplier party types.
model ReceiptParty {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  type    String  @db.VarChar(20) // Employee | Owner | Bank | Other
  name    String  @db.VarChar(200)
  gstin   String? @db.VarChar(20)
  phone   String? @db.VarChar(30)
  email   String? @db.VarChar(150)
  address String? @db.VarChar(300)
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, type])
  @@map("receipt_party")
}

// ============================================================================
// COUPON CAMPAIGN & PROMOTION MANAGEMENT — metadata-driven, rule-based promotion
// engine. Coupons ONLY (loyalty/membership/promo-code/voucher/cashback/referral
// are separate). All models scalar-scoped (tenantId/businessId/branchId).
// ============================================================================

/// Per-business coupon module configuration + coupon numbering counter.
model CouponConfiguration {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  enableModule         Boolean @default(true)
  enableGeneric        Boolean @default(true)
  enableUnique         Boolean @default(true)
  enableQr             Boolean @default(true)
  enableBarcode        Boolean @default(true)
  enableCustomerMapping Boolean @default(true)
  customerMapping      String  @default("Optional") @db.VarChar(12) // Mandatory | Optional | NotRequired
  enableMultiPerInvoice Boolean @default(false)
  allowWithLoyalty     Boolean @default(false)
  allowWithMembership  Boolean @default(false)
  allowWithPromo       Boolean @default(false)
  allowWithManual      Boolean @default(false)
  allowReturnRestore   Boolean @default(true)
  allowCancelRestore   Boolean @default(true)
  enableApproval       Boolean @default(false)
  enablePrinting       Boolean @default(true)
  enableDesigner       Boolean @default(true)
  enableBatchGen       Boolean @default(true)

  couponPrefix   String  @default("CPN") @db.VarChar(20)
  couponLength   Int     @default(10)
  runningNumber  Int     @default(0)
  seqPeriod      String? @db.VarChar(20)
  qrSize         Int     @default(120)
  barcodeType    String  @default("CODE128") @db.VarChar(20)
  defaultStatus  String  @default("Generated") @db.VarChar(12)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("coupon_configuration")
}

/// A marketing campaign that groups coupons + rules.
model CouponCampaign {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  code        String  @db.VarChar(40)
  name        String  @db.VarChar(150)
  description String? @db.VarChar(500)
  campaignType String @default("Promotion") @db.VarChar(30) // Promotion | Festival | Seasonal | Clearance | Loyalty-Boost
  priority    Int     @default(0)
  couponType  String  @default("Unique") @db.VarChar(10) // Generic | Unique
  status      String  @default("Draft") @db.VarChar(12) // Draft | Active | Paused | Expired | Cancelled
  startDate   String? @db.VarChar(20)
  endDate     String? @db.VarChar(20)
  marketingBudget Decimal @default(0) @db.Decimal(18, 2)
  remarks     String? @db.VarChar(500)

  createdBy     Int?
  createdByName String?  @db.VarChar(200)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rules     CouponRule[]
  batches   CouponBatch[]
  coupons   Coupon[]

  @@index([tenantId, status])
  @@map("coupon_campaign")
}

/// The primary discount + numeric purchase/usage/GST/accounting rule for a campaign.
model CouponRule {
  id         Int            @id @default(autoincrement())
  tenantId   Int
  // A rule belongs to EITHER a coupon campaign or a promo campaign (shared engine).
  campaignId Int?
  campaign   CouponCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  promoCampaignId Int?
  promoCampaign   PromoCampaign? @relation(fields: [promoCampaignId], references: [id], onDelete: Cascade)

  name         String  @db.VarChar(150)
  discountType String  @default("Percentage") @db.VarChar(20) // Flat | Percentage | BillDiscount | ProductDiscount | CategoryDiscount | BrandDiscount | BuyXGetY | BuyXGetSame | FreeProduct | FreeQuantity | Combo | Bundle | Slab
  discountValue Decimal @default(0) @db.Decimal(18, 2)
  maxDiscount   Decimal @default(0) @db.Decimal(18, 2)
  minDiscount   Decimal @default(0) @db.Decimal(18, 2)

  minBill         Decimal @default(0) @db.Decimal(18, 2)
  maxBill         Decimal @default(0) @db.Decimal(18, 2)
  minQty          Decimal @default(0) @db.Decimal(18, 3)
  maxQty          Decimal @default(0) @db.Decimal(18, 3)
  minProductCount Int     @default(0)
  maxProductCount Int     @default(0)

  // Buy X Get Y
  buyProductId Int?
  buyQty       Decimal @default(0) @db.Decimal(18, 3)
  getProductId Int?
  getQty       Decimal @default(0) @db.Decimal(18, 3)
  sameProduct  Boolean @default(false)

  // GST
  gstRule       String  @default("AfterGST") @db.VarChar(12) // BeforeGST | AfterGST
  reduceTaxable Boolean @default(true)

  // Accounting
  salesDiscountCode    String? @db.VarChar(20)
  marketingExpenseCode String? @db.VarChar(20)
  costCenter String? @db.VarChar(80)
  department String? @db.VarChar(80)
  project    String? @db.VarChar(80)

  // Usage
  maxPerCustomer Int    @default(0)
  maxPerInvoice  Int    @default(1)
  maxPerDay      Int    @default(0)
  maxPerCampaign Int    @default(0)
  usageType      String @default("SingleUse") @db.VarChar(12) // SingleUse | MultipleUse | Reusable | Unlimited

  // Date/time
  startTime String? @db.VarChar(10)
  endTime   String? @db.VarChar(10)
  days      String? @db.VarChar(40) // CSV of Mon..Sun

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conditions CouponRuleCondition[]
  actions    CouponRuleAction[]

  @@index([campaignId])
  @@index([promoCampaignId])
  @@map("coupon_rule_master")
}

/// A metadata-driven include/exclude condition (products/categories/brands/customers/channels/payments/branches…).
model CouponRuleCondition {
  id     Int        @id @default(autoincrement())
  tenantId Int
  ruleId Int
  rule   CouponRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  condType String @db.VarChar(24) // Product | Category | Brand | Customer | CustomerGroup | Channel | Payment | Branch | Warehouse | Terminal | Region | State | LoyaltyTier | Membership | CustomerType
  operator String @default("in") @db.VarChar(12) // in | not_in | eq | gte | lte
  valueJson String @db.Text // JSON array / value

  @@index([ruleId])
  @@map("coupon_rule_conditions")
}

/// A metadata-driven action (e.g. free product, give quantity).
model CouponRuleAction {
  id     Int        @id @default(autoincrement())
  tenantId Int
  ruleId Int
  rule   CouponRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  actionType String @db.VarChar(24) // Discount | FreeProduct | FreeQty | GiveProduct | ApplyOn
  valueJson  String @db.Text

  @@index([ruleId])
  @@map("coupon_rule_actions")
}

/// A drag-and-drop coupon template (layout stored as JSON for the designer).
model CouponTemplate {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?

  name     String  @db.VarChar(120)
  category String  @default("Generic") @db.VarChar(20) // Retail | Pharmacy | Supermarket | Electronics | Fashion | Generic
  layout   String  @db.LongText // JSON: objects, theme, colors, size
  isSystem Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  objects CouponTemplateObject[]

  @@index([tenantId, category])
  @@map("coupon_template")
}

/// One positioned object of a coupon template (text/qr/barcode/image/placeholder).
model CouponTemplateObject {
  id         Int            @id @default(autoincrement())
  tenantId   Int
  templateId Int
  template   CouponTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  objectType String  @db.VarChar(16) // text | placeholder | qr | barcode | image | shape
  x          Int     @default(0)
  y          Int     @default(0)
  w          Int     @default(0)
  h          Int     @default(0)
  rotation   Int     @default(0)
  props      String? @db.Text // JSON: text, font, color, size, placeholderKey…

  @@index([templateId])
  @@map("coupon_template_objects")
}

/// A batch generation run.
model CouponBatch {
  id         Int            @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  campaignId Int
  campaign   CouponCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  batchNo        String  @db.VarChar(40)
  quantity       Int     @default(0)
  generatedCount Int     @default(0)
  status         String  @default("Generated") @db.VarChar(12)

  generatedBy     Int?
  generatedByName String?  @db.VarChar(200)
  createdAt       DateTime @default(now())

  coupons Coupon[]

  @@index([campaignId])
  @@map("coupon_generation_batch")
}

/// A single coupon.
model Coupon {
  id         Int            @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  campaignId Int
  campaign   CouponCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  batchId    Int?
  batch      CouponBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  couponNo     String  @db.VarChar(60)
  couponCode   String  @db.VarChar(60)
  qrData       String? @db.VarChar(200)
  barcodeData  String? @db.VarChar(200)
  securityCode String? @db.VarChar(20)

  status     String  @default("Generated") @db.VarChar(12) // Generated | Printed | Issued | Redeemed | Expired | Cancelled
  customerId Int?
  customerName String? @db.VarChar(200)
  expiryDate String? @db.VarChar(20)

  redeemedCount Int @default(0)
  printedCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mappings    CouponCustomerMap[]
  issues      CouponIssue[]
  redemptions CouponRedemption[]
  prints      CouponPrintHistory[]

  @@unique([tenantId, couponNo])
  @@index([tenantId, status])
  @@index([campaignId])
  @@map("coupon_master")
}

/// Customer-specific coupon assignment.
model CouponCustomerMap {
  id       Int    @id @default(autoincrement())
  tenantId Int
  couponId Int
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId Int
  customerName String? @db.VarChar(200)
  mappedAt DateTime @default(now())

  @@index([couponId])
  @@index([tenantId, customerId])
  @@map("coupon_customer_mapping")
}

/// A coupon issue record.
model CouponIssue {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  couponId   Int
  coupon     Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  campaignId Int?

  issueTo   String  @db.VarChar(20) // Customer | Employee | WalkIn | Campaign | Bulk
  customerId Int?
  partyName String? @db.VarChar(200)
  issueDate String  @db.VarChar(20)
  issuedBy     Int?
  issuedByName String? @db.VarChar(200)
  remarks   String? @db.VarChar(300)

  createdAt DateTime @default(now())

  @@index([couponId])
  @@map("coupon_issue")
}

/// A coupon redemption (linked to a sale where applicable).
model CouponRedemption {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  couponId   Int
  coupon     Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  campaignId Int?

  saleId    Int?
  invoiceNo String? @db.VarChar(40)
  customerId Int?
  customerName String? @db.VarChar(200)
  channel   String? @db.VarChar(20)

  billAmount     Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxableReduced Decimal @default(0) @db.Decimal(18, 2)
  journalRef     String? @db.VarChar(40)

  status       String @default("Redeemed") @db.VarChar(12) // Redeemed | Reversed
  redeemedBy     Int?
  redeemedByName String? @db.VarChar(200)
  redeemedAt   DateTime @default(now())

  @@index([couponId])
  @@index([tenantId, campaignId])
  @@map("coupon_redemption")
}

/// A print event.
model CouponPrintHistory {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  couponId   Int?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  batchId    Int?
  templateId Int?

  printType String @db.VarChar(12) // Single | Batch | Bulk | Reprint
  format    String @default("A4") @db.VarChar(12) // PDF | A4 | Thermal | Card | Label
  copies    Int    @default(1)
  perPage   Int    @default(1)

  printedBy     Int?
  printedByName String? @db.VarChar(200)
  printedAt     DateTime @default(now())

  @@index([couponId])
  @@map("coupon_print_history")
}

/// Dedicated coupon audit trail.
model CouponAudit {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?

  entityType String  @db.VarChar(16) // Campaign | Rule | Coupon | Template | Batch | Config
  entityId   Int?
  action     String  @db.VarChar(24)
  byUser     Int?
  byName     String? @db.VarChar(200)
  note       String? @db.VarChar(400)
  at         DateTime @default(now())

  @@index([tenantId, entityType])
  @@map("coupon_audit")
}

// ============================================================================
// Promo Code Management — digital promotional codes. Reuses the shared promotion
// rule engine + rule tables (coupon_rule_master via CouponRule.promoCampaignId),
// the accounting engine (Dr Marketing Expense / Cr Sales Discount) and GST engine.
// ============================================================================

/// Promo Code module settings + numbering (per business scope).
model PromoConfiguration {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  enableModule            Boolean @default(true)
  enableManualCode        Boolean @default(true)
  enableAutoCode          Boolean @default(true)
  enableBulkGen           Boolean @default(true)
  enableCustomerMapping   Boolean @default(true)
  customerMapping         String  @default("Public") @db.VarChar(12) // Mandatory | Optional | Public
  enableApproval          Boolean @default(false)
  enableAnalytics         Boolean @default(true)
  enableExpiryNotify      Boolean @default(false)
  enableUsageNotify       Boolean @default(false)
  enableMultiPerInvoice   Boolean @default(false)
  allowWithLoyalty        Boolean @default(true)
  allowWithMembership     Boolean @default(false)
  allowWithCoupon         Boolean @default(false)
  allowWithManual         Boolean @default(false)
  allowWithGiftVoucher    Boolean @default(false)
  allowReturnRestore      Boolean @default(true)
  allowCancelRestore      Boolean @default(true)

  priority           Int    @default(0)
  conflictResolution String @default("HighestDiscount") @db.VarChar(20) // HighestDiscount | HighestPriority | FirstApplied | Exclusive

  codeModel     String @default("SameCode") @db.VarChar(16) // SameCode (one shared code, once/customer) | DifferentCodes (unique per customer)
  codePrefix    String @default("PROMO") @db.VarChar(20)
  codeLength    Int    @default(10)
  runningNumber Int    @default(0)
  defaultStatus String @default("Active") @db.VarChar(12)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("promo_configuration")
}

/// A digital promotion campaign (groups promo codes + a shared rule).
model PromoCampaign {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  code         String  @db.VarChar(40)
  name         String  @db.VarChar(150)
  description  String? @db.VarChar(500)
  campaignType String  @default("Digital") @db.VarChar(30) // Digital | Festival | Seasonal | Referral | Launch | Winback
  marketingBudget Decimal @default(0) @db.Decimal(18, 2)
  campaignOwner String? @db.VarChar(200)
  priority     Int     @default(0)
  startDate    String? @db.VarChar(20)
  endDate      String? @db.VarChar(20)
  status       String  @default("Draft") @db.VarChar(12) // Draft | Active | Paused | Expired | Cancelled | Closed
  remarks      String? @db.VarChar(500)

  createdBy     Int?
  createdByName String?  @db.VarChar(200)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rules         CouponRule[]
  codes         PromoCode[]
  distributions PromoDistribution[]
  redemptions   PromoRedemption[]

  @@index([tenantId, status])
  @@map("promo_campaign")
}

/// A single promo code (digital — normally not printed).
model PromoCode {
  id         Int           @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  campaignId Int
  campaign   PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  promoCode   String  @db.VarChar(60)
  name        String? @db.VarChar(150)
  description String? @db.VarChar(400)
  codeType    String  @default("Public") @db.VarChar(16) // Public | Private | CustomerSpecific
  generationType String @default("Auto") @db.VarChar(12) // Manual | Auto
  prefix      String? @db.VarChar(20)
  suffix      String? @db.VarChar(20)
  qrData      String? @db.VarChar(200)

  status     String  @default("Active") @db.VarChar(12) // Active | Issued | Redeemed | Expired | Cancelled
  customerId Int?
  customerName String? @db.VarChar(200)
  expiryDate String? @db.VarChar(20)
  generationBatch String? @db.VarChar(40) // bulk-generation set reference
  oncePerCustomer Boolean @default(false) // shared "Same Code": each customer may redeem only once; never globally exhausts

  usageLimit    Int @default(0) // 0 = follows rule usage type
  redeemedCount Int @default(0)
  distributedCount Int @default(0)

  createdBy     Int?
  createdByName String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mappings      PromoCustomerMapping[]
  distributions PromoDistribution[]
  redemptions   PromoRedemption[]

  @@unique([tenantId, promoCode])
  @@index([tenantId, status])
  @@index([campaignId])
  @@map("promo_code_master")
}

/// A distribution event for a promo code / campaign (SMS, WhatsApp, Email…).
model PromoDistribution {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  campaignId Int
  campaign   PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  promoCodeId Int?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  distributionDate String @db.VarChar(20)
  channel          String @db.VarChar(20) // SMS | WhatsApp | Email | Push | Website | QR | Event | SocialMedia | App
  recipient        String? @db.VarChar(200)
  recipientContact String? @db.VarChar(200)
  customerId       Int?
  deliveryStatus   String @default("Sent") @db.VarChar(12) // Pending | Sent | Delivered | Failed | Opened
  remarks          String? @db.VarChar(400)
  // Campaign broadcast: audience segment + the message content + banner sent.
  audience         String? @db.VarChar(20) // All | HighValue | Group | Specific | Manual
  recipientCount   Int     @default(1)
  messageBody      String? @db.Text
  bannerImage      String? @db.LongText

  sentBy     Int?
  sentByName String?  @db.VarChar(200)
  createdAt  DateTime @default(now())

  @@index([campaignId])
  @@index([tenantId, channel])
  @@map("promo_distribution")
}

/// Customer / group / membership / branch mapping for a promo code.
model PromoCustomerMapping {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  promoCodeId Int
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  mappingType  String  @default("Customer") @db.VarChar(16) // Public | Customer | CustomerGroup | Membership | Business | Branch
  customerId   Int?
  customerName String? @db.VarChar(200)
  refValue     String? @db.VarChar(120) // group / membership tier / branch code
  mappedAt     DateTime @default(now())

  @@index([promoCodeId])
  @@index([tenantId, customerId])
  @@map("promo_customer_mapping")
}

/// A promo redemption (linked to a sale where applicable).
model PromoRedemption {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  promoCodeId Int
  promoCodeRef PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  campaignId Int?
  campaign   PromoCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  saleId    Int?
  invoiceNo String? @db.VarChar(40)
  customerId Int?
  customerName String? @db.VarChar(200)
  channel   String? @db.VarChar(20)

  billAmount     Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxableReduced Decimal @default(0) @db.Decimal(18, 2)
  journalRef     String? @db.VarChar(40)

  status         String @default("Redeemed") @db.VarChar(12) // Redeemed | Reversed
  redeemedBy     Int?
  redeemedByName String? @db.VarChar(200)
  redeemedAt     DateTime @default(now())

  @@index([promoCodeId])
  @@index([tenantId, campaignId])
  @@index([saleId])
  @@map("promo_redemption")
}

/// A rolled-up analytics snapshot per campaign (recomputed on demand).
model PromoAnalytics {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  campaignId Int?

  snapshotDate  String @db.VarChar(20)
  totalCodes    Int    @default(0)
  activeCodes   Int    @default(0)
  redeemedCodes Int    @default(0)
  expiredCodes  Int    @default(0)
  distributedCount Int @default(0)
  totalDiscount Decimal @default(0) @db.Decimal(18, 2)
  redemptionRate Decimal @default(0) @db.Decimal(9, 2)
  roi           Decimal @default(0) @db.Decimal(9, 2)

  createdAt DateTime @default(now())

  @@index([tenantId, campaignId])
  @@map("promo_analytics")
}

/// Dedicated promo audit trail.
model PromoAudit {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?

  entityType String  @db.VarChar(16) // Campaign | Code | Rule | Distribution | Redemption | Config
  entityId   Int?
  action     String  @db.VarChar(28)
  byUser     Int?
  byName     String? @db.VarChar(200)
  note       String? @db.VarChar(400)
  at         DateTime @default(now())

  @@index([tenantId, entityType])
  @@map("promo_audit")
}

// ============================================================================
// Membership Management — Configuration module (config-only; registration /
// renewal / upgrade / downgrade / card issuance / billing are separate modules).
// Reusable by POS, Loyalty, Coupon, Promo and Finance. All scalar-scoped.
// ============================================================================

/// General membership settings + numbering (one row per business scope).
model MembershipConfiguration {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  enableModule       Boolean @default(true)
  membershipType     String  @default("Paid") @db.VarChar(20) // Free | Paid | PurchaseBased | Invitation | Hybrid
  numberGeneration   String  @default("Auto") @db.VarChar(8)  // Auto | Manual
  numberPrefix       String  @default("MEM") @db.VarChar(20)
  numberLength       Int     @default(10)
  runningNumber      Int     @default(0)
  defaultStatus      String  @default("Draft") @db.VarChar(12)
  allowMultiple      Boolean @default(false)
  allowTransfer      Boolean @default(false)
  autoActivate       Boolean @default(false)
  requireApproval    Boolean @default(true)
  enableExpiry       Boolean @default(true)
  enableAutoRenewal  Boolean @default(false)
  enableAutoUpgrade  Boolean @default(false)
  enableAutoDowngrade Boolean @default(false)
  renewalReminderDays Int    @default(15)
  expiryReminderDays  Int    @default(7)
  gracePeriodDays     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, businessId, branchId])
  @@map("membership_configuration")
}

/// A membership level / tier (unlimited levels).
model MembershipLevel {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  code        String  @db.VarChar(40)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(400)
  priority    Int     @default(0)
  displayOrder Int    @default(0)
  themeColor  String? @db.VarChar(20)
  icon        String? @db.VarChar(40)
  status      String  @default("Active") @db.VarChar(12) // Active | Inactive | Draft

  createdBy     Int?
  createdByName String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qualificationRules MembershipQualificationRule[]
  benefit   MembershipBenefit?
  fee       MembershipFeeConfig?
  validity  MembershipValidityConfig?
  upgrade   MembershipUpgradeRule?
  downgrade MembershipDowngradeRule?

  @@index([tenantId, status])
  @@map("membership_level_master")
}

/// How a customer qualifies for a level (multiple methods, combined AND/OR).
model MembershipQualificationRule {
  id      Int             @id @default(autoincrement())
  tenantId Int
  levelId Int
  level   MembershipLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  method           String  @db.VarChar(24) // PurchaseValue | PurchaseFrequency | BillCount | LoyaltyPoints | MembershipFee | CustomerType | ManualAssignment | ReferralCount | CampaignBased
  evaluationPeriod String  @default("Yearly") @db.VarChar(12) // Monthly | Quarterly | HalfYearly | Yearly | Lifetime
  minPurchase   Decimal @default(0) @db.Decimal(18, 2)
  minBills      Int     @default(0)
  minPoints     Int     @default(0)
  minFee        Decimal @default(0) @db.Decimal(18, 2)
  minFrequency  Int     @default(0)
  referralCount Int     @default(0)
  customerType  String? @db.VarChar(40)
  campaignRef   String? @db.VarChar(80)
  combineLogic  String  @default("OR") @db.VarChar(4) // AND | OR
  sortOrder     Int     @default(0)
  active        Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([levelId])
  @@map("membership_qualification_rule")
}

/// The benefit bundle for a level (reused by POS / Loyalty / Coupon / Promo).
model MembershipBenefit {
  id      Int             @id @default(autoincrement())
  tenantId Int
  levelId Int             @unique
  level   MembershipLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  billDiscountPct     Decimal @default(0) @db.Decimal(9, 2)
  maxDiscount         Decimal @default(0) @db.Decimal(18, 2)
  productDiscountPct  Decimal @default(0) @db.Decimal(9, 2)
  categoryDiscountPct Decimal @default(0) @db.Decimal(9, 2)
  brandDiscountPct    Decimal @default(0) @db.Decimal(9, 2)
  maxDiscountPerBill  Decimal @default(0) @db.Decimal(18, 2)
  maxDiscountPerDay   Decimal @default(0) @db.Decimal(18, 2)
  maxDiscountPerMonth Decimal @default(0) @db.Decimal(18, 2)
  pointMultiplier   Decimal @default(1) @db.Decimal(9, 2)
  welcomePoints     Int     @default(0)
  birthdayPoints    Int     @default(0)
  anniversaryPoints Int     @default(0)
  bonusPoints       Int     @default(0)
  exclusivePromo   Boolean @default(false)
  campaignEligible Boolean @default(false)
  couponBenefits  String? @db.Text
  voucherBenefits String? @db.Text
  serviceBenefits String? @db.Text

  updatedAt DateTime @updatedAt
  @@map("membership_benefit_master")
}

/// Fees for a level.
model MembershipFeeConfig {
  id      Int             @id @default(autoincrement())
  tenantId Int
  levelId Int             @unique
  level   MembershipLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  registrationFee   Decimal @default(0) @db.Decimal(18, 2)
  renewalFee        Decimal @default(0) @db.Decimal(18, 2)
  securityDeposit   Decimal @default(0) @db.Decimal(18, 2)
  refundable        Boolean @default(false)
  currency          String  @default("INR") @db.VarChar(8)
  gstApplicable     Boolean @default(false)
  gstPercentage     Decimal @default(0) @db.Decimal(9, 2)
  discountOnRenewal Decimal @default(0) @db.Decimal(9, 2)
  lateRenewalCharge Decimal @default(0) @db.Decimal(18, 2)

  updatedAt DateTime @updatedAt
  @@map("membership_fee_configuration")
}

/// Validity for a level.
model MembershipValidityConfig {
  id      Int             @id @default(autoincrement())
  tenantId Int
  levelId Int             @unique
  level   MembershipLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  validityType     String  @default("Yearly") @db.VarChar(12) // Lifetime | Monthly | Quarterly | HalfYearly | Yearly | Custom
  validityDays     Int     @default(365)
  effectiveFrom    String? @db.VarChar(20)
  effectiveTo      String? @db.VarChar(20)
  gracePeriodDays  Int     @default(0)

  updatedAt DateTime @updatedAt
  @@map("membership_validity_configuration")
}

/// Upgrade rule to reach a level.
model MembershipUpgradeRule {
  id      Int             @id @default(autoincrement())
  tenantId Int
  levelId Int             @unique
  level   MembershipLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  autoUpgrade      Boolean @default(false)
  manualUpgrade    Boolean @default(true)
  approvalRequired Boolean @default(false)
  upgradeBasedOn   String? @db.Text
  minPurchase      Decimal @default(0) @db.Decimal(18, 2)
  minBills         Int     @default(0)
  minPoints        Int     @default(0)
  minFee           Decimal @default(0) @db.Decimal(18, 2)
  evaluationPeriod String  @default("Yearly") @db.VarChar(12)
  active           Boolean @default(true)

  updatedAt DateTime @updatedAt
  @@map("membership_upgrade_rule")
}

/// Downgrade rule from a level.
model MembershipDowngradeRule {
  id      Int             @id @default(autoincrement())
  tenantId Int
  levelId Int             @unique
  level   MembershipLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  autoDowngrade     Boolean @default(false)
  manualDowngrade   Boolean @default(true)
  approvalRequired  Boolean @default(false)
  gracePeriodDays   Int     @default(30)
  purchaseThreshold Decimal @default(0) @db.Decimal(18, 2)
  billThreshold     Int     @default(0)
  pointThreshold    Int     @default(0)
  active            Boolean @default(true)

  updatedAt DateTime @updatedAt
  @@map("membership_downgrade_rule")
}

/// Renewal policy (one row per business scope).
model MembershipRenewalConfig {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  autoRenewal        Boolean @default(false)
  manualRenewal      Boolean @default(true)
  renewalFee         Decimal @default(0) @db.Decimal(18, 2)
  renewalValidityDays Int    @default(365)
  renewalReminderDays Int    @default(15)
  renewalBonusPoints Int     @default(0)
  renewalCoupon      Boolean @default(false)
  renewalGiftVoucher Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, businessId, branchId])
  @@map("membership_renewal_configuration")
}

/// Mandatory registration fields (one row per business scope; JSON field map).
model MembershipCustomerConfig {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  fieldsJson String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, businessId, branchId])
  @@map("membership_customer_configuration")
}

/// Finance / accounting integration (one row per business scope).
model MembershipFinanceConfig {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  registrationFeeAccount String? @db.VarChar(20)
  renewalFeeAccount      String? @db.VarChar(20)
  discountAccount        String? @db.VarChar(20)
  refundAccount          String? @db.VarChar(20)
  marketingExpenseAccount String? @db.VarChar(20)
  costCenter String? @db.VarChar(80)
  department String? @db.VarChar(80)
  project    String? @db.VarChar(80)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, businessId, branchId])
  @@map("membership_finance_configuration")
}

/// Notification matrix (one row per business scope; JSON event map).
model MembershipNotificationConfig {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  eventsJson String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, businessId, branchId])
  @@map("membership_notification_configuration")
}

/// Membership card settings (one row per business scope).
model MembershipCardConfig {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  enableCard     Boolean @default(true)
  cardType       String  @default("Both") @db.VarChar(10) // Digital | Printable | Both
  generateQr     Boolean @default(true)
  generateBarcode Boolean @default(false)
  showCardNumber Boolean @default(true)
  showLogo       Boolean @default(true)
  showPhoto      Boolean @default(true)
  showLevel      Boolean @default(true)
  showIssueDate  Boolean @default(true)
  showExpiryDate Boolean @default(true)
  showSignature  Boolean @default(false)
  theme          String  @default("Default") @db.VarChar(40)
  cardSize       String  @default("CR80") @db.VarChar(20)
  allowReprint   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, businessId, branchId])
  @@map("membership_card_configuration")
}

/// Approval workflow config (one row per business scope).
model MembershipApprovalConfig {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  approvalLevels        Int     @default(1)
  approvalRolesJson     String? @db.Text
  approvalNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, businessId, branchId])
  @@map("membership_approval_configuration")
}

/// Dedicated membership audit trail.
model MembershipAudit {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?

  entityType String  @db.VarChar(20)
  entityId   Int?
  action     String  @db.VarChar(28)
  byUser     Int?
  byName     String? @db.VarChar(200)
  note       String? @db.VarChar(400)
  at         DateTime @default(now())

  @@index([tenantId, entityType])
  @@map("membership_audit")
}

// ============================================================================
// Membership Registration (CRM) — enrols customers into the Membership Program.
// Reuses all Membership Configuration (levels/benefits/fees/validity/rules/card).
// ============================================================================

/// A membership registration + its lifecycle.
model MembershipRegistration {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  registrationNo   String  @db.VarChar(40)
  customerId       Int
  levelId          Int
  membershipType   String  @db.VarChar(20)
  membershipNumber String? @db.VarChar(60)

  status         String  @default("Draft") @db.VarChar(16) // Draft | Submitted | PendingApproval | Approved | Active | Suspended | Expired | Cancelled
  registrationDate String @db.VarChar(20)
  activationDate   String? @db.VarChar(20)
  expiryDate       String? @db.VarChar(20)

  qualified          Boolean @default(false)
  qualificationNote  String? @db.VarChar(500)
  approvalRequired   Boolean @default(false)

  // Fee snapshot
  feeAmount     Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  gstAmount     Decimal @default(0) @db.Decimal(18, 2)
  netAmount     Decimal @default(0) @db.Decimal(18, 2)
  paymentMode   String? @db.VarChar(20)
  paymentRef    String? @db.VarChar(80)

  registeredBy     Int?
  registeredByName String? @db.VarChar(200)
  approvedBy       Int?
  approvedByName   String? @db.VarChar(200)
  remarks          String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history     MembershipRegistrationHistory[]
  activations MembershipActivation[]
  receipts    MembershipFeeReceipt[]
  cards       MembershipCard[]
  documents   MembershipDocument[]

  @@unique([tenantId, registrationNo])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([levelId])
  @@map("membership_registration")
}

/// Status-change history for a registration.
model MembershipRegistrationHistory {
  id             Int    @id @default(autoincrement())
  tenantId       Int
  registrationId Int
  registration   MembershipRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  fromStatus String? @db.VarChar(16)
  toStatus   String  @db.VarChar(16)
  action     String  @db.VarChar(40)
  byUser     Int?
  byName     String? @db.VarChar(200)
  note       String? @db.VarChar(400)
  at         DateTime @default(now())

  @@index([registrationId])
  @@map("membership_registration_history")
}

/// The activation record.
model MembershipActivation {
  id             Int    @id @default(autoincrement())
  tenantId       Int
  registrationId Int
  registration   MembershipRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  membershipNumber String  @db.VarChar(60)
  activationDate   String  @db.VarChar(20)
  expiryDate       String? @db.VarChar(20)
  activatedBy      Int?
  activatedByName  String? @db.VarChar(200)
  createdAt        DateTime @default(now())

  @@index([registrationId])
  @@map("membership_activation")
}

/// The membership fee receipt (linked to the finance posting).
model MembershipFeeReceipt {
  id             Int    @id @default(autoincrement())
  tenantId       Int
  businessId     Int?
  branchId       Int?
  registrationId Int
  registration   MembershipRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  receiptNo   String  @db.VarChar(40)
  receiptDate String  @db.VarChar(20)
  customerId  Int
  feeAmount     Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  gstAmount     Decimal @default(0) @db.Decimal(18, 2)
  netAmount     Decimal @default(0) @db.Decimal(18, 2)
  paymentMode String  @db.VarChar(20)
  paymentRef  String? @db.VarChar(80)
  journalRef  String? @db.VarChar(40)

  createdBy     Int?
  createdByName String? @db.VarChar(200)
  createdAt     DateTime @default(now())

  @@index([registrationId])
  @@map("membership_fee_receipt")
}

/// The membership card (digital + printable).
model MembershipCard {
  id             Int    @id @default(autoincrement())
  tenantId       Int
  registrationId Int
  registration   MembershipRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  cardNumber       String  @db.VarChar(60)
  membershipNumber String  @db.VarChar(60)
  levelId          Int
  qrData           String? @db.VarChar(200)
  barcodeData      String? @db.VarChar(200)
  issueDate        String  @db.VarChar(20)
  expiryDate       String? @db.VarChar(20)
  status           String  @default("Active") @db.VarChar(12)
  reprintCount     Int     @default(0)

  createdAt DateTime @default(now())
  @@index([registrationId])
  @@map("membership_card")
}

/// Generated documents (application / card / receipt / agreement / certificate).
model MembershipDocument {
  id             Int    @id @default(autoincrement())
  tenantId       Int
  registrationId Int
  registration   MembershipRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  docType     String  @db.VarChar(24) // Application | Card | Receipt | Agreement | Certificate
  generatedBy Int?
  generatedByName String? @db.VarChar(200)
  createdAt   DateTime @default(now())

  @@index([registrationId])
  @@map("membership_document")
}

// ============================================================================
// Gift Voucher Management — stored-value payment instrument (prepaid money, NOT
// a discount). Reuses the accounting engine (Gift Voucher Liability 2140) + the
// coupon render engine for printing + POS as a payment tender.
// ============================================================================

/// Gift voucher module settings + numbering (one row per business scope).
model GiftVoucherConfiguration {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  enableModule       Boolean @default(true)
  enableQr           Boolean @default(true)
  enableBarcode      Boolean @default(false)
  enableCustomerMapping Boolean @default(true)
  customerMapping    String  @default("Optional") @db.VarChar(12) // Mandatory | Optional | NotRequired
  enablePartialRedemption Boolean @default(true)
  enableMultipleRedemption Boolean @default(true)
  enableTransfer     Boolean @default(false)
  enableRevalidation Boolean @default(true)
  enableExpiry       Boolean @default(true)
  enableAutoExpiry   Boolean @default(true)
  enableReissue      Boolean @default(true)
  enableReplacement  Boolean @default(true)
  autoActivateOnSale Boolean @default(true)
  approvalRequired   Boolean @default(false)
  gstOnSale          Boolean @default(false)
  gstPercentage      Decimal @default(0) @db.Decimal(9, 2)

  numberPrefix   String @default("GV") @db.VarChar(20)
  numberLength   Int    @default(12)
  runningNumber  Int    @default(0)
  securityLength Int    @default(6)
  defaultValidityDays Int @default(365)

  liabilityAccount String? @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, businessId, branchId])
  @@map("gift_voucher_configuration")
}

/// Drag-and-drop voucher template (layout JSON — shared render engine).
model GiftVoucherTemplate {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?

  name     String  @db.VarChar(120)
  category String  @default("Generic") @db.VarChar(24)
  layout   String  @db.LongText
  isSystem Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("gift_voucher_template")
}

/// Bulk generation batch.
model GiftVoucherBatch {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?

  batchNo    String  @db.VarChar(40)
  voucherType String @db.VarChar(24)
  faceValue  Decimal @default(0) @db.Decimal(18, 2)
  quantity   Int     @default(0)
  generatedCount Int @default(0)
  status     String  @default("Generated") @db.VarChar(12)
  generatedBy Int?
  generatedByName String? @db.VarChar(200)
  createdAt  DateTime @default(now())

  vouchers GiftVoucher[]
  @@index([tenantId])
  @@map("gift_voucher_generation_batch")
}

/// A single gift voucher (identity + live balance).
model GiftVoucher {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  batchId    Int?
  batch      GiftVoucherBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  voucherNo    String  @db.VarChar(60)
  voucherType  String  @default("FixedValue") @db.VarChar(24) // FixedValue | VariableValue | Promotional | Refund | Compensation | EmployeeReward | CorporateGift
  faceValue    Decimal @default(0) @db.Decimal(18, 2)
  originalValue Decimal @default(0) @db.Decimal(18, 2)
  redeemedValue Decimal @default(0) @db.Decimal(18, 2)
  availableBalance Decimal @default(0) @db.Decimal(18, 2)
  securityCode String? @db.VarChar(20)
  qrData       String? @db.VarChar(200)
  barcodeData  String? @db.VarChar(200)

  status     String  @default("Generated") @db.VarChar(12) // Generated | Active | Redeemed | Expired | Cancelled | Closed
  customerId Int?
  customerName String? @db.VarChar(200)
  issueDate  String? @db.VarChar(20)
  expiryDate String? @db.VarChar(20)
  activatedAt String? @db.VarChar(20)
  lastRedemptionDate String? @db.VarChar(20)
  lastRedemptionBranchId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales       GiftVoucherSale[]
  activations GiftVoucherActivation[]
  redemptions GiftVoucherRedemption[]
  ledger      GiftVoucherLedger[]
  history     GiftVoucherHistory[]
  closures    GiftVoucherClosure[]
  adjustments GiftVoucherBalanceAdj[]

  @@unique([tenantId, voucherNo])
  @@index([tenantId, status])
  @@index([customerId])
  @@map("gift_voucher_master")
}

/// Voucher sale record (buyer + payment + finance posting).
model GiftVoucherSale {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  voucherId  Int
  voucher    GiftVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  saleNo     String  @db.VarChar(40)
