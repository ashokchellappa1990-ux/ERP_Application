  createdByName String? @db.VarChar(160)
  submittedBy   Int?
  submittedAt   DateTime?
  approvedBy    Int?
  approvedByName String? @db.VarChar(160)
  approvedAt    DateTime?
  rejectedBy    Int?
  rejectReason  String? @db.VarChar(300)
  dispatchedAt  DateTime?
  returnedAt    DateTime?
  lockedAt      DateTime?
  cancelledAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items StockTransferDispatchItem[]

  @@unique([tenantId, dispatchNo])
  @@index([tenantId, status])
  @@index([referenceType, referenceId])
  @@index([tenantId, sourceBranchId])
