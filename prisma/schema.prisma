  tagsJson       String?  @db.Text
  fileName       String   @db.VarChar(260)
  fileUrl        String   @db.Text
  fileType       String?  @db.VarChar(120)
  fileExt        String?  @db.VarChar(12)
  fileSize       Int      @default(0)
  checksum       String?  @db.VarChar(80)
  extractedText  String?  @db.LongText
  keywordsJson   String?  @db.Text
  entitiesJson   String?  @db.Text   // {dates,amounts,gstins,emails,invoiceNos,poNos,relationships}
  summaryJson    String?  @db.Text   // cache of the last generated summary
