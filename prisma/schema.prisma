  remarks   String? @db.Text
  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, vehicleNo])
  @@index([tenantId, status])
  @@map("vehicle_master")
}

