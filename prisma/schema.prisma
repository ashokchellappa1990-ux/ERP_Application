// PHASE 5 — AI Decision Intelligence Platform
// ============================================================================

/// A stored prediction/forecast for a metric — plus the actual outcome for learning.
model AiPrediction {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  businessId   Int?
  branchId     Int?
  module       String   @db.VarChar(24)
  metric       String   @db.VarChar(40)
  label        String   @db.VarChar(80)
  horizonDays  Int
  forPeriod    String   @db.VarChar(10) // yyyy-mm or yyyy-mm-dd the forecast targets
  currentValue Float    @default(0)
  forecastValue Float   @default(0)
  confidence   Int      @default(0) // 0-100
  riskScore    Int      @default(0) // 0-100
  trendPct     Float    @default(0)
  method       String   @db.VarChar(16) // linear|moving|seasonal|auto
  unit         String   @db.VarChar(10)
  seriesJson   String?  @db.LongText
  explainJson  String?  @db.Text
  actualValue  Float?
  accuracyPct  Int?
  actualAt     DateTime?
  createdBy    Int?
  createdAt    DateTime @default(now())
  @@index([tenantId, module, metric])
  @@index([tenantId, createdAt])
  @@map("ai_predictions")
}

/// Decision history — a prediction/risk/opportunity/recommendation acted on + its result.
model AiDecision {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  businessId      Int?
  branchId        Int?
  source          String   @db.VarChar(16) // prediction|risk|opportunity|recommendation
  refKey          String   @db.VarChar(160)
  module          String?  @db.VarChar(24)
  title           String   @db.VarChar(240)
  recommendation  String?  @db.Text
  decisionTaken   String   @default("Pending") @db.VarChar(16) // Accepted|Rejected|Deferred|Pending
  takenBy         Int?
  takenByName     String?  @db.VarChar(160)
  actualResult    String?  @db.VarChar(400)
  accuracy        Int?
  learningOutcome String?  @db.VarChar(400)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([tenantId, source])
  @@index([tenantId, createdAt])
  @@map("ai_decisions")
}

/// Dispositions for computed risks/opportunities/recommendations (dismiss/ack/resolve/assign).
model AiDecisionFeedback {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  itemType   String   @db.VarChar(16) // risk|opportunity|recommendation
  itemKey    String   @db.VarChar(200)
  status     String   @db.VarChar(16) // open|acknowledged|dismissed|resolved|assigned
  assignedTo String?  @db.VarChar(120)
  note       String?  @db.VarChar(300)
  createdBy  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([tenantId, itemType, itemKey])
  @@index([tenantId, status])
  @@map("ai_decision_feedback")
}

/// In-app decision-intelligence notifications (stock-out, cash risk, budget overrun, …).
model AiNotification {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  category   String   @db.VarChar(40)
  severity   String   @db.VarChar(12) // Critical|High|Medium|Low
  title      String   @db.VarChar(200)
  message    String   @db.VarChar(500)
  href       String?  @db.VarChar(200)
  dedupeKey  String   @db.VarChar(200)
  status     String   @default("unread") @db.VarChar(12) // unread|read|dismissed
  createdAt  DateTime @default(now())
  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status])
  @@map("ai_notifications")
}

/// A saved what-if scenario (inputs + computed result) for the Scenario Simulator.
model AiScenario {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  name       String   @db.VarChar(160)
  inputsJson String   @db.Text
  resultJson String?  @db.LongText
  createdBy  Int?
  createdByName String? @db.VarChar(160)
  createdAt  DateTime @default(now())
  @@index([tenantId, createdAt])
  @@map("ai_scenarios")
}

/// Per-tenant AI model configuration (Model Manager): methods, horizon, weights, thresholds.
model AiModelConfig {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @unique
  defaultHorizon Int      @default(30)
  defaultMethod  String   @default("auto") @db.VarChar(16)
  configJson     String?  @db.LongText // {methods:{metric:method}, weights:{}, thresholds:{}, enabled:{}}
  updatedBy      Int?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  @@map("ai_model_config")
}

/// Daily business-health snapshot — builds the health trend over time.
model AiHealthSnapshot {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  businessId    Int?
  branchId      Int?
  snapDate      String   @db.VarChar(10) // yyyy-mm-dd
  overall       Int      @default(0)
  band          String   @db.VarChar(12)
  subScoresJson String?  @db.Text
  createdAt     DateTime @default(now())
  @@unique([tenantId, businessId, branchId, snapDate])
  @@index([tenantId, snapDate])
  @@map("ai_health_snapshots")
}

// ============================================================================
// PURCHASE ORDER — supplier commitment document (no GL posting; precedes GRN/PI)
// ============================================================================

model PurchaseOrder {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  businessId         Int?
  branchId           Int?
  poNo               String   @db.VarChar(40)
  poDate             String   @db.VarChar(20)
  status             String   @default("Draft") @db.VarChar(20) // Draft|Approved|Issued|Partially Received|Received|Cancelled|Closed
  // Supplier
  supplierId         Int?
  supplier           String?  @db.VarChar(200)
  supplierGstin      String?  @db.VarChar(20)
  supplierContact    String?  @db.VarChar(120)
  supplierRef        String?  @db.VarChar(80)
  // References
  quotationNo        String?  @db.VarChar(60)
  quotationDate      String?  @db.VarChar(20)
  buyer              String?  @db.VarChar(120)
  purchaseType       String   @default("Inventory") @db.VarChar(20) // Inventory|Expense|Service|Asset
  // Delivery / logistics
  expectedDeliveryDate String? @db.VarChar(20)
  warehouse          String?  @db.VarChar(120)
  deliveryAddress    String?  @db.VarChar(400)
  shippingMode       String?  @db.VarChar(20) // Road|Rail|Air|Courier|Hand
  freightPaidBy      String?  @db.VarChar(20) // Supplier|Us|ToPay
  // Terms
  paymentTerms       String?  @db.VarChar(120)
  creditDays         Int?
  dueDate            String?  @db.VarChar(20)
  currency           String   @default("INR") @db.VarChar(10)
  // Tax / charges
  gstApplicable      Boolean  @default(true)
  reverseCharge      Boolean  @default(false)
  interState         Boolean  @default(false)
  taxableAmount      Decimal  @default(0) @db.Decimal(18, 2)
  cgst               Decimal  @default(0) @db.Decimal(18, 2)
  sgst               Decimal  @default(0) @db.Decimal(18, 2)
  igst               Decimal  @default(0) @db.Decimal(18, 2)
  cess               Decimal  @default(0) @db.Decimal(18, 2)
  gstAmount          Decimal  @default(0) @db.Decimal(18, 2)
  additionalDiscount Decimal  @default(0) @db.Decimal(18, 2)
  freight            Decimal  @default(0) @db.Decimal(18, 2)
  loading            Decimal  @default(0) @db.Decimal(18, 2)
  packing            Decimal  @default(0) @db.Decimal(18, 2)
  insurance          Decimal  @default(0) @db.Decimal(18, 2)
  otherCharges       Decimal  @default(0) @db.Decimal(18, 2)
  roundOff           Decimal  @default(0) @db.Decimal(9, 2)
  totalOrderValue    Decimal  @default(0) @db.Decimal(18, 2)
  netAmount          Decimal  @default(0) @db.Decimal(18, 2)
  itemCount          Int      @default(0)
  // Workflow
  approvedBy         Int?
  approvedByName     String?  @db.VarChar(160)
  approvedAt         DateTime?
  approvalNote       String?  @db.VarChar(300)
  issuedAt           DateTime?
  cancelledAt        DateTime?
  cancelReason       String?  @db.VarChar(300)
  // Notes
  remarks            String?  @db.VarChar(500)
  internalNotes      String?  @db.VarChar(500)
  termsConditions    String?  @db.Text
  createdBy          Int?
  createdByName      String?  @db.VarChar(160)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  terminalId         Int?
  terminalSessionId  Int?
  shiftSessionId     Int?
  cashierUserId      Int?
  deviceId           String?  @db.VarChar(80)
  transactionSource  String?  @db.VarChar(20)
  dayOpeningId       Int?
  dayClosingId       Int?

  items       PurchaseOrderItem[]
  attachments PurchaseOrderAttachment[]

  @@unique([tenantId, poNo])
  @@index([tenantId, status])
  @@index([tenantId, branchId, poDate])
  @@index([tenantId, supplier])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int      @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int?
  productName     String   @db.VarChar(250)
  sku             String?  @db.VarChar(60)
  hsn             String?  @db.VarChar(20)
  uom             String?  @db.VarChar(40)
  qty             Decimal  @db.Decimal(18, 3)
  rate            Decimal  @default(0) @db.Decimal(18, 2)
  taxPct          Decimal? @db.Decimal(9, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  discPct         Decimal? @db.Decimal(9, 2)
  discAmount      Decimal  @default(0) @db.Decimal(18, 2)
  lineValue       Decimal  @default(0) @db.Decimal(18, 2)
  expectedDate    String?  @db.VarChar(20)
  receivedQty     Decimal  @default(0) @db.Decimal(18, 3)
  remarks         String?  @db.VarChar(300)
  createdAt       DateTime @default(now())

  order PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model PurchaseOrderAttachment {
  id              Int      @id @default(autoincrement())
  purchaseOrderId Int
  docType         String   @default("quotation") @db.VarChar(20)
  fileName        String   @db.VarChar(200)
  fileUrl         String   @db.LongText
  fileType        String?  @db.VarChar(80)
  size            Int      @default(0)
  createdAt       DateTime @default(now())

  order PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_attachments")
}

// ============================================================ SALES TARGET / PERFORMANCE MANAGEMENT
model SalesTarget {
  id         Int    @id @default(autoincrement())
  tenantId   Int
  businessId Int?
  branchId   Int?
  targetNo   String @db.VarChar(40)
  fy         String @db.VarChar(20)
  title      String? @db.VarChar(200)
  dimension    String @default("branch") @db.VarChar(24)      // primary dimension
  targetType   String @default("salesValue") @db.VarChar(28)
  period       String @default("monthly") @db.VarChar(16)     // annual|halfyearly|quarterly|monthly|weekly|daily|custom
  distribution String @default("equal") @db.VarChar(16)       // equal|percentage|historical|seasonal|manual
  currency   String @default("INR") @db.VarChar(10)
  fromDate   String? @db.VarChar(20)
  toDate     String? @db.VarChar(20)
  totalTarget Decimal @default(0) @db.Decimal(18, 2)
  status         String @default("Draft") @db.VarChar(16)     // Draft|Submitted|Approved|Rejected|Returned|Locked|Completed|Cancelled
  approvalStatus String @default("NotRequired") @db.VarChar(16) // NotRequired|Pending|Approved|Rejected
  remarks    String? @db.Text

  createdBy     Int?
  createdByName String? @db.VarChar(160)
  submittedBy   Int?
  submittedAt   DateTime?
  approvedBy    Int?
  approvedByName String? @db.VarChar(160)
  approvedAt    DateTime?
  rejectedBy    Int?
  rejectReason  String? @db.VarChar(300)
  returnedAt    DateTime?
  lockedAt      DateTime?
  cancelledAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     SalesTargetLine[]
  revisions SalesTargetRevision[]
  approvals SalesTargetApproval[]

  @@unique([tenantId, targetNo])
  @@index([tenantId, fy])
  @@index([tenantId, businessId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, dimension, targetType])
  @@map("sales_targets")
}

model SalesTargetLine {
  id       Int         @id @default(autoincrement())
  tenantId Int
  targetId Int
  target   SalesTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  dimensionType  String  @db.VarChar(24)
  dimensionRefId Int?
  dimensionValue String? @db.VarChar(160)
  dimensionLabel String? @db.VarChar(200)
  parentRefId    Int?

  annual Decimal @default(0) @db.Decimal(18, 2)
  m1  Decimal @default(0) @db.Decimal(18, 2)
  m2  Decimal @default(0) @db.Decimal(18, 2)
  m3  Decimal @default(0) @db.Decimal(18, 2)
  m4  Decimal @default(0) @db.Decimal(18, 2)
  m5  Decimal @default(0) @db.Decimal(18, 2)
