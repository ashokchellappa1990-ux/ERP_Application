model SubscriptionPlan {
  id         Int    @id @default(autoincrement())
  code       String @db.VarChar(40)
  name       String @db.VarChar(120)
  tier       String @default("Standard") @db.VarChar(20) // Starter | Standard | Professional | Enterprise | Custom
  monthlyPrice   Decimal @default(0) @db.Decimal(18, 2)
  quarterlyPrice Decimal @default(0) @db.Decimal(18, 2)
  halfYearlyPrice Decimal @default(0) @db.Decimal(18, 2)
  yearlyPrice    Decimal @default(0) @db.Decimal(18, 2)
  lifetimePrice  Decimal @default(0) @db.Decimal(18, 2)
  currency   String @default("INR") @db.VarChar(8)
  maxUsers Int @default(5)
  maxCompanies Int @default(1)
  maxBranches Int @default(1)
  maxWarehouses Int @default(1)
  maxProducts Int @default(1000)
  maxCustomers Int @default(1000)
  maxSuppliers Int @default(500)
  maxStorageMb Int @default(1024)
  maxApiCalls Int @default(10000)
  maxAiCredits Int @default(100)
  maxTransactions Int @default(10000)
