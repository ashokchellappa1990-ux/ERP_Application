model PlatformAudit {
  id         Int    @id @default(autoincrement())
  entityType String @db.VarChar(24)
  entityId   Int?
  tenantId   Int?
  action     String @db.VarChar(40)
  byUser     Int?
  byName     String? @db.VarChar(200)
